use uo;
use os;

include "include/client";
include "include/attributes";
include "include/classes";

program totem(who, totem)

	if(!ReserveItem(totem)) return; endif

	if( !GetObjProperty( who , CLASSEID_CRAFTER ) )
		SendSysMessage( who , "Only crafters can activate obsidian golems." );
		return;
	endif

	var npctemplate := GetObjProperty(totem,"critter");
	//Print("Totem template: " + npctemplate);

	var parms := struct;
	parms.+ script := "tamed";
	detach();

	var it := CreateNpcFromTemplate(CStr(npctemplate), CInt(who.x-1), CInt(who.y+1), who.z, parms);
	if (!it)
		it := CreateNpcFromTemplate(CStr(npctemplate), CInt(who.x+1), CInt(who.y-1), who.z, parms);
		if (!it)
			SendSysMessage(who,"Canceled");
			return;
		endif
	endif
	SetObjProperty( it , "totem", totem.objtype );
	SetObjProperty( it , "totemcolor", totem.color );
	SetObjProperty( it , "master" , who.serial );
	SetObjProperty( it , "script" , it.script );
	it.setmaster( who );
	it.script := "tamed";
	it.name := totem.name;
	it.color := Cint(GetObjProperty( totem , "critcolor" ));
	if ( GetObjProperty(totem,"totemhp") )
		SetHP(it, cint(GetObjProperty(totem,"totemhp")));
	endif

	PlaySoundEffect( who, SFX_SPELL_DISPEL );
	PlayStationaryEffect( it.x, it.y, it.z, FX_SMOKE, 0xA, 0xA );
	DestroyItem(totem);
	RestartScript(it);

endprogram
