use uo;

include "include/random";
include "include/client";

const GLOBE_COOLDOWN_SECONDS := 8 * 60 * 60;
const TOWNSTONE_OBJTYPE := 0xa320;
const TOWNSTONE_SEARCH_RANGE := 10000;
const SOSARIA_MIN_X := 0;
const SOSARIA_MIN_Y := 0;
const SOSARIA_MAX_X := 7167;
const SOSARIA_MAX_Y := 4095;
const EXCLUDED_REGION_NAME := "randorin";

program use_globe(who, globe)

if(!ReserveItem(globe))
	return;
endif

var next_use := CInt(GetObjProperty(who, "#GlobeOfSosariaCooldown"));
var now := ReadGameClock();

if(next_use and next_use > now and !who.cmdlevel)
	SendSysMessage(who, "The Globe of Sosaria is still recharging. Time left: " + FormatDuration(next_use - now) + ".");
	return;
endif

var townstone := FindTownStoneForCharacter(who);
var used_own_townstone := 0;
if(townstone)
	used_own_townstone := 1;
endif
if(!townstone)
	townstone := FindRandomTownStone(who);
endif
if(!townstone)
	SendSysMessage(who, "The Globe of Sosaria cannot find an active town stone.");
	return;
endif

if(TeleportBesideStone(who, townstone))
	SetObjProperty(who, "#GlobeOfSosariaCooldown", now + GLOBE_COOLDOWN_SECONDS);
	PlaySoundEffect(who, SFX_SPELL_TELEPORT);
	if(used_own_townstone)
		SendSysMessage(who, "The globe hums and returns you to your town stone.");
	else
		SendSysMessage(who, "The globe hums and sends you to a random town stone.");
	endif
	return;
endif

SendSysMessage(who, "The Globe of Sosaria failed to find a clear spot beside the town stone.");

endprogram

function FindTownStoneForCharacter(who)
	if(!who)
		return 0;
	endif

	var town_id := CInt(GetObjProperty(who, "town"));
	if(!town_id)
		return 0;
	endif

	var town_name := "";
	var town_list := GetGlobalProperty("townlist");
	if(town_list and town_list[town_id])
		town_name := CStr(town_list[town_id]);
	endif

	var stones := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, "britannia");
	if(!stones or !stones.size())
		return 0;
	endif

	foreach stone in stones
		if(!stone or stone.objtype != TOWNSTONE_OBJTYPE)
			continue;
		endif

		if(CInt(GetObjProperty(stone, "town")) == town_id)
			return stone;
		endif

		if(town_name and CStr(GetObjProperty(stone, "regionname")) == town_name)
			return stone;
		endif
	endforeach

	return 0;
endfunction

function FindRandomTownStone(who)
	var townstones := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, "britannia");
	if(!townstones or !townstones.size())
		return 0;
	endif

	var eligible := { };
	foreach stone in townstones
		if(IsSosariaTownStone(who, stone))
			eligible.append(stone);
		endif
	endforeach

	if(!eligible.size())
		return 0;
	endif

	return eligible[RandomInt(eligible.size()) + 1];
endfunction

function IsSosariaTownStone(who, stone)
	if(IsExcludedTownStone(who, stone))
		return 0;
	endif

	var x := CInt(stone.x);
	var y := CInt(stone.y);

	if(x < SOSARIA_MIN_X || y < SOSARIA_MIN_Y)
		return 0;
	endif
	if(x > SOSARIA_MAX_X || y > SOSARIA_MAX_Y)
		return 0;
	endif

	return 1;
endfunction

function IsExcludedTownStone(who, stone)
	if(who and who.cmdlevel)
		return 0;
	endif

	var region_name := CStr(GetObjProperty(stone, "regionname"));
	if(!region_name)
		var town_id := CInt(GetObjProperty(stone, "town"));
		if(town_id)
			var townnames := GetGlobalProperty("townlist");
			if(townnames and town_id <= townnames.size())
				region_name := CStr(townnames[town_id]);
			endif
		endif
	endif

	if(Lower(region_name) == EXCLUDED_REGION_NAME)
		return 1;
	endif

	return 0;
endfunction

function TeleportBesideStone(who, stone)
	var realm := stone.realm;
	var x := CInt(stone.x);
	var y := CInt(stone.y);
	var z := CInt(stone.z);

	if(MoveObjectToLocation(who, x + 1, y, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x - 1, y, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x, y + 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x, y - 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x + 1, y + 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x + 1, y - 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x - 1, y + 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif
	if(MoveObjectToLocation(who, x - 1, y - 1, z, realm, MOVEOBJECT_FORCELOCATION))
		return 1;
	endif

	return 0;
endfunction

function FormatDuration(seconds)
	seconds := CInt(seconds);
	if(seconds < 0)
		seconds := 0;
	endif

	var days := CInt(seconds / 86400);
	seconds := seconds - (days * 86400);
	var hours := CInt(seconds / 3600);
	seconds := seconds - (hours * 3600);
	var minutes := CInt(seconds / 60);
	seconds := seconds - (minutes * 60);

	var parts := "";
	if(days > 0)
		parts := days + " day" + PluralS(days);
	endif
	if(hours > 0)
		if(parts)
			parts := parts + ", ";
		endif
		parts := parts + hours + " hour" + PluralS(hours);
	endif
	if(minutes > 0)
		if(parts)
			parts := parts + ", ";
		endif
		parts := parts + minutes + " minute" + PluralS(minutes);
	endif
	if(seconds > 0 || !parts)
		if(parts)
			parts := parts + ", ";
		endif
		parts := parts + seconds + " second" + PluralS(seconds);
	endif

	return parts;
endfunction

function PluralS(value)
	if(CInt(value) == 1)
		return "";
	endif
	return "s";
endfunction