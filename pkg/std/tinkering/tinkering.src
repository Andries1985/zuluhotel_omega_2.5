use uo;
use cfgfile;
use os;
use math;

include "util/repair";
include ":gumps:yesno";
include "include/client";
include "include/objtype";
include "include/dotempmods";
include "include/drinkpotion";
include "include/itemutil";
include "include/classes";
include "include/random";
include "util/key";
include "include/autoloop";
include "include/attributes";
include "include/difficulty";
include "include/chests";
include "include/omegacache_utils";
include "include/resourcemanager";

const CARPENTER_SOUND	:= 0x23e;
const UOBJECT_CHEST	:= 0x0e42;
const UOBJECT_POISON_POTION := 0x0f0a;
const UOBJECT_PURPLE_POTION := 0x0f0d;
const EXPLOSION_SOUND	:= 0x208;
const EXPLOSION_ANIM	:= 0x36b0;
const POISON_SOUND 	:= 0x247;
const HIT_ACTION	:= 0x148b;

const DIVIDER		:= 4;
const APPEAR_AT		:= -10;
const POINTS_MULTIPLIER	:= 10;
const GOLD_COLOR	:= 0x0033;
const TINKER_LOCKABLE	:= 90;
const FAME_BONUS	:= 10;

const WOOD_ID	:= 1;
const METAL_ID	:= 2;
const GLASS_ID	:= 3;
const CLAY_ID	:= 4;

var tinker_cfg	:= ReadConfigFile( "tinker" );
var ressource_diff := 0;
var ressource_name;
var ressource_qual := 1;

program MakeTinkerItems( character , tool )

	var use_on;
	var item_to_make;
	var skill;
	var material;
	var points;
	var itemname;
	var sound;
	var resourceRequest;

	if( !ReserveItem( tool ) )
		return;
	endif

	SendSysmessage( character, "Select your material." );

	use_on := Target( character , TGTOPT_CHECK_LOS );
	if( !use_on )
		return;
	endif

	// Handle Omega Cache targeting — select material from cache gump
	if(use_on.objtype == OMEGACACHE_OBJTYPE)
		var cacheRequest := SelectMaterialFromCache(character);
		if(!cacheRequest)
			return;
		endif
		HandleCacheMaterial(character, cacheRequest);
		return;
	endif

	if( !Accessible( character , use_on ) or !use_on.movable )
		SendSysmessage( character , "You can't reach that!" );
		return;
	endif

	// Cache containers use leases instead of ReserveItem
	if(use_on.objtype != OMEGACACHE_OBJTYPE)
		if( !ReserveItem( use_on ) )
			return;
		endif
	endif

	if( !IsInContainer( character.backpack , use_on ) )
		SendSysmessage( character, "That item has to be in your backpack." );
		return;
	endif

	if( (use_on.objtype == UOBJ_LOGS      ) or (use_on.objtype == UOBJ_LOGS_GODDESS) or
	   ((use_on.objtype >= UOBJ_LOGS_START) and (use_on.objtype <= UOBJ_LOGS_END)) )
	   	var cfg := ReadConfigFile( ":carpentry:carpentry" );
		ressource_diff := cfg[use_on.objtype].Difficulty;
		ressource_name := cfg[use_on.objtype].Name;
		ressource_qual := cfg[use_on.objtype].Quality;
		resourceRequest := MakeBackpackRequest(character, use_on);
	   	item_to_make := MakeAndProcessMenu( character , resourceRequest , WOOD_ID );
	   	sound := CARPENTER_SOUND;

	elseif((use_on.objtype ==  UOBJ_GOLD_INGOT   ) or
	      ((use_on.objtype >= UOBJ_INGOTS_START ) and (use_on.objtype <= UOBJ_INGOTS_END )) or
	      ((use_on.objtype >= UOBJ_INGOTS2_START) and (use_on.objtype <= UOBJ_INGOTS2_END)) )
		var cfg := ReadConfigFile( ":blacksmithy:blacksmithy" );
		ressource_diff := cfg[use_on.objtype].Difficulty;
		ressource_name := cfg[use_on.objtype].Name;
		ressource_qual := cfg[use_on.objtype].Quality;
		resourceRequest := MakeBackpackRequest(character, use_on);
		item_to_make := MakeAndProcessMenu( character , resourceRequest , METAL_ID );
		sound := SFX_ANVIL;

	else
		case( use_on.objtype )

			UOBJ_AXLE:		TryToMakeComplex( character , use_on , UOBJ_AXLE_AND_GEARS , UOBJ_GEARS , CARPENTER_SOUND );
						break;

			UOBJ_GEARS:		TryToMakeComplex( character , use_on , UOBJ_AXLE_AND_GEARS , UOBJ_AXLE , CARPENTER_SOUND );
						break;

			UOBJ_CLOCK_FRAME:	TryToMakeComplex( character , use_on , UOBJ_CLOCK , UOBJ_CLOCK_PARTS , SFX_ANVIL );
						break;

			UOBJ_CLOCK_PARTS:	TryToMakeComplex( character , use_on , UOBJ_CLOCK , UOBJ_CLOCK_FRAME , SFX_ANVIL );
						break;

			UOBJ_SPRINGS:		TryToMakeComplex( character , use_on , UOBJ_CLOCK_PARTS , UOBJ_AXLE_AND_GEARS , SFX_ANVIL );
						break;


			UOBJ_KEG:
			UOBJ_BARREL_TAP:
			UOBJ_BARREL_LID:
			UOBJ_EMPTY_BOTTLE:	TryToMakePotionKeg( character , use_on );
						break;

			UOBJ_AXLE_AND_GEARS:	SendSysMessage( character , "Select either some springs or a hinge." );
						var thing := Target( character , TGTOPT_CHECK_LOS );
						if( !thing )
							break;
						endif

						if(thing.objtype == OMEGACACHE_OBJTYPE)
							// Select springs or hinge from cache
							var secondCacheRequest := SelectMaterialFromCache(character);
							if(!secondCacheRequest)
								break;
							endif
							var firstBackpackRequest := MakeBackpackRequest(character, use_on);
							if(CInt(secondCacheRequest.objtype) == UOBJ_SPRINGS)
								TryToMakeComplex(character, 0, UOBJ_CLOCK_PARTS, 0, SFX_ANVIL, firstBackpackRequest, secondCacheRequest);
							elseif(CInt(secondCacheRequest.objtype) == UOBJ_HINGE)
								TryToMakeComplex(character, 0, UOBJ_SEXTANT_PARTS, 0, SFX_ANVIL, firstBackpackRequest, secondCacheRequest);
							else
								SendSysMessage(character, "You must select either a hinge or springs.");
							endif
							break;
						endif

						if( !Accessible( character , thing ) or !thing.movable )
							SendSysmessage( character , "You can't reach that!" );
							break;
						endif

						if( !ReserveItem( thing ) )
							break;
						endif

						case( thing.objtype )
							UOBJ_SPRINGS:	TryToMakeComplex( character , use_on , UOBJ_CLOCK_PARTS , UOBJ_SPRINGS , SFX_ANVIL );
									break;

							UOBJ_HINGE:	TryToMakeComplex( character , use_on , UOBJ_SEXTANT_PARTS , UOBJ_HINGE , SFX_ANVIL );
									break;

							default:	SendSysMessage( character , "You must select either a hinge or springs." );

						endcase


			UOBJ_HINGE:		TryToMakeComplex( character , use_on , UOBJ_SEXTANT_PARTS , UOBJ_AXLE_AND_GEARS , SFX_ANVIL );
						break;

			UOBJ_SEXTANT_PARTS:	TryToMakeComplex( character , use_on , UOBJ_SEXTANT , 0 , SFX_ANVIL );
						break;


			UOBJ_OBSIDIAN:		MakeTotem( character , use_on );
						break;


			UOBJ_GLASS:		resourceRequest := MakeBackpackRequest(character, use_on);
						item_to_make := MakeAndProcessMenu( character , resourceRequest , GLASS_ID );
						sound := SFX_GLASSBREAK4;
						break;


			UOBJ_CLAY:		resourceRequest := MakeBackpackRequest(character, use_on);
						item_to_make := MakeAndProcessMenu( character , resourceRequest , CLAY_ID );
						sound := SFX_HAMMER;
						break;


			UOBJ_COPPER_KEY:
			UOBJ_GOLD_KEY:
			UOBJ_IRON_KEY:
			UOBJ_RUSTY_IRON_KEY:	TryToMakeAContainerLockable( character , use_on );


			default:		if( use_on.isa( POLCLASS_CONTAINER ) and !use_on.isa( POLCLASS_CORPSE ) )
							SetTrap( character , use_on );
						else
							SendSysMessage( character , "You don't know how to use those items together." );
						endif
		endcase
	endif

	item_to_make := item_to_make.objtype;
	if( !item_to_make )
		return;
	endif

	if(!resourceRequest)
		resourceRequest := MakeBackpackRequest(character, use_on);
	endif
	TryToMakeItem( character , resourceRequest , item_to_make , sound );

endprogram


function TryToMakeComplex( character , use_on , to_be_done_objtype , needed_objtype , sfx, firstRequest := 0, secondRequest := 0 );

	var itemname;
	var points;
	var skill;
	var have_it;
	var have_it_qual := 1;

	if(!firstRequest)
		firstRequest := MakeBackpackRequest(character, use_on);
	endif

	if( needed_objtype and !secondRequest )
		have_it := FindObjtypeInContainer( character.backpack , needed_objtype );
		if( !have_it )
			// Check cache for the second component
			var tempRequest := struct{ objtype := CInt(needed_objtype), dataFileHandle := firstRequest.dataFileHandle, leaseKey := 0, preferredSourceOrder := array{ OMEGA_CACHE, BACKPACK } };
			var avail := GetAvailableResource(character, tempRequest);
			if(avail.cache > 0 and firstRequest.dataFileHandle)
				var cache_key := 0;
				var prefix := Hex(CInt(needed_objtype)) + "|";
				var prefix_len := len(prefix);
				foreach dk in (firstRequest.dataFileHandle.Keys())
					if(dk[1, 3] != "RL#" and dk[1, prefix_len] == prefix)
						cache_key := dk;
						break;
					endif
				endforeach
				secondRequest := struct{
					objtype              := CInt(needed_objtype),
					key                  := cache_key,
					color                := 0,
					quality              := 0,
					preferredSourceOrder := array{ OMEGA_CACHE, BACKPACK },
					dataFileHandle       := firstRequest.dataFileHandle,
					leaseKey             := 0
				};
			else
				SendSysMessage(character, "You don't have the required component.");
				return;
			endif
		else
			have_it_qual := have_it.quality;
			secondRequest := MakeBackpackRequest(character, have_it);
		endif
	endif

	var element := FindConfigElem( tinker_cfg , to_be_done_objtype );
	if( element )
	   	itemname := element.Name;
		skill 	 := element.Skill;
	else
		return;
	endif

	points	:= Cint( skill * POINTS_MULTIPLIER );

	// Verify materials available before crafting
	if(GetAvailableResource(character, firstRequest).total < 1)
		SendSysMessage(character, "You don't have enough materials.");
		return;
	endif
	if(secondRequest and GetAvailableResource(character, secondRequest).total < 1)
		SendSysMessage(character, "You don't have the required component.");
		return;
	endif

	_Play_Sound( character , sfx );

	sendDiff( character , skill );

	if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

		var theitem := CreateItemInBackpack( character , to_be_done_objtype );
		if( !theitem )
			SendSysMessage( character , "Error in creation process please report this bug on the msg board." );
			ConsumeResource(character, firstRequest, 1);
			if( secondRequest )
				ConsumeResource(character, secondRequest, 1);
			endif
			return;
		endif

		theitem.movable := 1;
		var item_cfg	:= ReadConfigFile( ":*:itemdesc" );

		var result_qual := Cint( ( use_on.quality + have_it_qual ) / 2 );
		if( theitem.quality )
			if( result_qual )
				theitem.quality := result_qual;
			endif
		endif

		var excep_ch	:= 10;
	  	if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			excep_ch := Cint( excep_ch * ClasseBonus( character , CLASSEID_CRAFTER ) );
		else
			skill := skill + 20;
		endif

		if( skill < 90 )
			skill := 90;
		endif

		if( element.Exceptional and (Random(100) < excep_ch) and CheckSkill( character , SKILLID_TINKERING , skill , 0 ) )
			if( theitem.quality )
				var armslore := GetEffectiveSkill( character , SKILLID_ARMSLORE );
				var multiplier := 5 + Cint( armslore / 10 );

				if( GetObjProperty( character , CLASSEID_CRAFTER ) )
					multiplier := Cint( multiplier * ClasseBonus( character , CLASSEID_CRAFTER ) );
				endif

				multiplier	:= 100 + multiplier;
				var newquality := Cint(theitem.quality * multiplier);
				newquality := Cdbl(newquality);
				newquality := newquality / 100;
				theitem.quality := newquality;
			endif

			itemname := "Exceptional " + itemname;
			SetObjProperty( theitem , "CraftedBy" , character.name );

			SendSysmessage( character , "You make an exceptional item and put it in your pack" );
			SetObjProperty( theitem , "IsExceptional" , 1 );
			if( skill >= 130 )
				SendSysmessage( character , "This masterpiece will make you famous around the world." );
				AwardFame( character , FAME_BONUS );
			elseif( GetObjProperty( character , CLASSEID_CRAFTER ) and skill >= 110 )
				SendSysmessage( character , "This masterpiece will make you famous around the world." );
				AwardFame( character , FAME_BONUS );
			endif
		else
			SendSysmessage( character , "You create the item and place it in your pack." );
		endif

		if( firstRequest.color )
			if( CInt(firstRequest.objtype) == UOBJ_GOLD_INGOT )
				theitem.color := GOLD_COLOR;
			else
				theitem.color := firstRequest.color;
			endif
		elseif( use_on and use_on.color )
			theitem.color := use_on.color;
		endif

		SetObjProperty( theitem , "BaseName" , itemname );
		SetName( theitem , itemname );

	else
		SendSysmessage( character , "You fail to create the item and destroy the material." );

	endif

	ConsumeResource(character, firstRequest, 1);
	if( secondRequest )
		ConsumeResource(character, secondRequest, 1);
	endif

endfunction


function _Play_Sound( who , sfx )

	PlaySoundEffect( who , sfx );
	Sleep (2);
	PlaySoundEffect( who , sfx );
	Sleep (2);
	if( !GetObjProperty( who, CLASSEID_CRAFTER ))
		PlaySoundEffect( who , sfx );
		Sleep (2);
	endif

endfunction


function MakeAndProcessMenu( who , resourceRequest , id )

	var skill := GetEffectiveSkill( who , SKILLID_TINKERING );

	if( skill < ressource_diff )
		SendSysmessage( who, "You aren't skilled enough to make anything with this yet." );
		return;
	endif

	var elemkeys := GetConfigStringKeys( tinker_cfg );
	var can_make;
	var choice;

	var menu := CreateMenu( "What would you like to make?" );

	case( id )

		WOOD_ID:	AddMenuItem( menu , 0x1032 , "Tools" );
				AddMenuItem( menu , 0x0e34 , "Paper items" );
				AddMenuItem( menu , 0x14F3 , "Miscellaneous" );
				break;

		METAL_ID:	AddMenuItem( menu , 0x1EBB , "Tools" );
				AddMenuItem( menu , 0x1059 , "Parts" );
				AddMenuItem( menu , 0x097f , "Kitchenware" );
				AddMenuItem( menu , 0x0e85 , "Deadly Tools" );
				AddMenuItem( menu , 0x0a22 , "Lights" );
				AddMenuItem( menu , 0x1089 , "Jewelry" );
				AddMenuItem( menu , 0x1640 , "Miscellaneous" );
				break;

		GLASS_ID:	AddMenuItem( menu , 0x185b , "Alchemical Tools" );
				AddMenuItem( menu , 0x0e2d , "Miscellaneous" );
				break;

		CLAY_ID:	AddMenuItem( menu , 0x181d , "Foci" );
				AddMenuItem( menu , 0x12ca , "Statues" );
				AddMenuItem( menu , 0x0b46 , "Miscellaneous" );
				break;

	endcase

	choice := SelectMenuItem2( who , menu ).index;
	if( !choice )
		return;
	endif

	choice := (id * 10) + choice;

	menu := CreateMenu( "What would you like to make?" );

	foreach key in elemkeys
		if( tinker_cfg[key].Type == choice )
			if( CanMake( who , key , resourceRequest ) )
				AddMenuItem( menu , Cint(key) , tinker_cfg[key].Name );
				can_make := 1;
			endif
		endif
	endforeach

	if( can_make )
		return SelectMenuItem2( who , menu );
	else
		SendSysmessage( who , "You can't make anything of this category." );
		return;
	endif

endfunction


function CanMake( who , key , resourceRequest )

	var diff := tinker_cfg[key].Skill + Cint( ressource_diff / DIVIDER );
	if( diff < 1 )
		diff := 1;
	elseif( diff > 130 )
		diff := 130;
	endif

	if( GetEffectiveSkill( who , SKILLID_TINKERING ) >= ( diff + APPEAR_AT ) )
		//Require half resources during Crafting PH
		var material := tinker_cfg[key].Material;
		if(GetGlobalProperty("PHC") || GetObjProperty(who, "#PPHC"))
			material := CInt(Ceil(material/2));
		endif

		if( GetAvailableResource(who, resourceRequest).total >= material )
			return 1;
		endif
	endif

	return 0;

endfunction


function TryToMakeItem( character , resourceRequest , to_make_objtype , sfx )

	var skill;
	var element;
	var material;
	var points;
	var itemname;
	var undyeable;
	var excep_ch;


	element := FindConfigElem( tinker_cfg , to_make_objtype );

	if( element )
		material	:= element.Material;
		undyeable	:= element.Undyeable;
	else
		return;
	endif
	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
		material := CInt(Ceil(material/2));
	endif

	// Lease cache resources for the first iteration
	LeaseResource(character, resourceRequest, material);

	AutoLoop_init( character );
	while( AutoLoop_more() && (GetAvailableResource(character, resourceRequest).total >= material) && NOT character.dead)

		//refreshing some stuff ;)
		itemname := element.Name;
		skill 	 := element.Skill;
		excep_ch := 0;

		if( to_make_objtype in { 0x1085 , 0x1086 , 0x1087 , 0x1088 , 0x1089 , 0x108a , 0x1535 } )
			SendSysmessage( character , "Select a gem for this item." );
			var thegem := Target( character , TGTOPT_CHECK_LOS );
			if( !thegem )
				break;
			endif

			var item_cfg := ReadConfigFile( ":*:itemdesc" );
			// Handle cache-sourced gems
			if(thegem.objtype == OMEGACACHE_OBJTYPE)
				var gemRequest := SelectMaterialFromCache(character);
				if(!gemRequest)
					break;
				endif
				if((CInt(gemRequest.objtype) > 0xf30) or (CInt(gemRequest.objtype) < 0xf0f))
					SendSysmessage(character, "That is not a gem!");
					break;
				endif
				itemname := item_cfg[gemRequest.objtype].Name + " " + itemname;
				ConsumeResource(character, gemRequest, 1);
			else
				if( (thegem.objtype > 0xf30) or (thegem.objtype < 0xf0f) )
					SendSysmessage( character , "That is not a gem!" );
					break;
				endif

				if( !Accessible( character , thegem ) )
					SendSysmessage( character , "You can't reach that!" );
					break;
				endif

				itemname := item_cfg[thegem.objtype].Name + " " + itemname;
				var gemRequest := MakeBackpackRequest(character, thegem);
				ConsumeResource(character, gemRequest, 1);
			endif
		endif

		_Play_Sound( character , sfx );

		skill := skill + Cint( ressource_diff / DIVIDER );

		if( skill < 1 )
			skill := 1;
		elseif( skill > 130 )
			skill := 130;
		endif

		points	:= Cint( (skill + Cint(element.Material / 3)) * POINTS_MULTIPLIER );

		SendSysmessage( character , "Difficulty: "+skill );

		// Verify materials are still available before attempting craft
		if(GetAvailableResource(character, resourceRequest).total < material)
			SendSysMessage(character, "You don't have enough materials.");
			break;
		endif

		if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

			var theitem := CreateItemInBackpack( character , to_make_objtype );
			if( theitem )

				theitem.movable := 1;
				excep_ch := 10;

				if( ressource_name )
					itemname := ressource_name + " " + itemname;
				endif

				if( theitem.quality and ressource_qual )
					theitem.quality := ressource_qual;
				endif

				if( GetObjProperty( character , CLASSEID_CRAFTER ) )
					excep_ch	:= Cint( excep_ch * ClasseBonus( character , CLASSEID_CRAFTER ) );
				else
					skill		:= skill + 10;
				endif

				if( skill < 90 )
					skill := 90;
				endif

				if( element.Exceptional and (Random(100) < excep_ch) and CheckSkill( character , SKILLID_TINKERING , skill , 0 ) )

					if( theitem.quality )
						//Made something Exceptional
						var armslore := GetEffectiveSkill( character , SKILLID_ARMSLORE );
						var multiplier := 5 + Cint( armslore / 10 );

						if( GetObjProperty( character , CLASSEID_CRAFTER ) )
							multiplier := Cint( multiplier * ClasseBonus( character , CLASSEID_CRAFTER ) );
						endif

						multiplier	:= 100 + multiplier;
						var newquality := Cint(theitem.quality * multiplier);
						newquality := Cdbl(newquality);
						newquality := newquality / 100;
						theitem.quality := newquality;
					endif

					itemname := "Exceptional " + itemname;
					if(GetObjProperty(character, "ToggleBuildMark"))
						if( YesNo( character , "Add Builder Mark?" ) )
							SetObjProperty( theitem , "CraftedBy" , character.name );
						endif
					else
						SetObjProperty( theitem , "CraftedBy" , character.name );
					endif

					SendSysmessage( character , "You make an exceptional item and put it in your pack" );
					SetObjProperty( theitem , "IsExceptional" , 1 );
					if( skill >= 130 )
						SendSysmessage( character , "This masterpiece will make you famous around the world." );
						AwardFame( character , FAME_BONUS );
					elseif( GetObjProperty( character , CLASSEID_CRAFTER ) and skill >= 110 )
						SendSysmessage( character , "This masterpiece will make you famous around the world." );
						AwardFame( character , FAME_BONUS );
					endif
				else

					//Made a normal item
					SendSysmessage( character , "You create the item and place it in your pack." );
				endif

				if( resourceRequest.objtype != UOBJ_GLASS and resourceRequest.objtype != UOBJ_CLAY )
					if( resourceRequest.objtype == UOBJ_GOLD_INGOT and !undyeable )
						theitem.color := GOLD_COLOR;
					elseif( !undyeable )
						theitem.color := resourceRequest.color;
					endif
				endif

				theitem.hp := theitem.maxhp;
				SetObjProperty( theitem , "BaseName" , itemname );
				SetName( theitem , itemname );

				if( theitem.isa(POLCLASS_LOCKABLE) )
				if( theitem.objtype <> 0x0EFA )
						SetObjProperty(theitem, "lockable", 1);
						var lockid := AllocLockId();
						theitem.locked := 1;
						var thekey := CreateItemInBackpack( character, UOBJ_COPPER_KEY );
						SetObjProperty( thekey ,  "lockid" , lockid );
						SetObjProperty( theitem , "lockid" , lockid );
						var tinkering := GetEffectiveSkill( character , SKILLID_TINKERING );
						var lockdiff := finddiff(theitem);
						if(lockdiff)
							Setobjproperty( theitem , "LockDifficulty", lockdiff );
						else
							Setobjproperty( theitem , "LockDifficulty", tinkering );
						endif
						SendSysmessage( character , "You will find the key in your backpack.");
				endif
				endif
			endif
			ConsumeResource( character , resourceRequest , material );
		else
			var tink := GetEffectiveSkill( character , SKILLID_TINKERING );
			var destroy := 75 - Cint( tink / 2 );
			if( GetObjProperty( character , CLASSEID_CRAFTER ) )
				destroy := Cint( destroy / ClasseBonus( character , CLASSEID_CRAFTER ) );
			endif

			if( destroy > 50 )
				destroy	:= 50;
			endif

			destroy	:= Cint( material * destroy / 100 );
			if( destroy < 1 )
				destroy	:= 1;
			endif

			ConsumeResource( character , resourceRequest , destroy );
			SendSysmessage( character , "You destroyed some resources." );
		endif

		// Extend lease for next iteration
		if(!ExtendResourceLease(resourceRequest, character, material))
			break;
		endif
	endwhile

	ReleaseResourceLease(resourceRequest);
	AutoLoop_finish();

endfunction


function SetTrap( character , chest )

	var cfg_id;
	var skill;
	var strength;
	var trap_type;
	var retval;
	var poison_level;
	var trap_item;

	if (!GetObjProperty( chest , "lockable" )) // || chest.Lockable<>1 )
		SendSysMessage( character, "You can trap only lockable containers." );
		return;
	endif

	if( chest.usescript )
		if( chest.usescript == ":traps:traps" )
			SendSysMessage( character , "This is already trapped." );
			return;
		else
			SendsysMessage( character , "You can trap this." );
			return;
		endif
	endif

	SendSysMessage( character, "Trap with what?" );
	trap_item := Target( character , TGTOPT_CHECK_LOS );

	if( !trap_item )
		SendSysmessage( character , "Canceled." );
		return;
	endif

	var trapRequest;

	// Cache targeting for trap materials
	if(trap_item.objtype == OMEGACACHE_OBJTYPE)
		trapRequest := SelectMaterialFromCache(character);
		if(!trapRequest)
			return;
		endif
		var trap_objtype := CInt(trapRequest.objtype);
		var trap_desc := GetItemDescriptor(trap_objtype);
		var trap_graphic := 0;
		if(trap_desc)
			trap_graphic := CInt(trap_desc.Graphic);
		endif

		if(trap_graphic == UOBJECT_POISON_POTION)
			cfg_id := 0xffff;
			// Read strength from config by objtype
			var itemcfg := ReadConfigFile(":alchemy:itemdesc");
			strength := CInt(itemcfg[trap_objtype].Strength);
			trap_type := 2;
		elseif(trap_graphic == UOBJECT_PURPLE_POTION)
			var itemcfg := ReadConfigFile(":alchemy:itemdesc");
			strength := CInt(itemcfg[trap_objtype].Strength);
			cfg_id := 0xfffe;
			trap_type := 3;
		elseif(trap_objtype == 0x1bfb)
			cfg_id := 0xfffd;
			strength := 1;
			trap_type := 1;
		else
			SendSysmessage(character, "That can't be used as a trap.");
			return;
		endif
	else
		// Physical item targeting
		if( !Accessible( character , trap_item ) )
			SendSysmessage( character , "You can't reach that!" );
			return;
		endif

		if(trap_item.objtype != OMEGACACHE_OBJTYPE)
			if( !ReserveItem( trap_item ) )
				return;
			endif
		endif

		if (trap_item.graphic == UOBJECT_POISON_POTION)
			cfg_id := 0xffff;
			strength := GetPotionStrength( trap_item );
			trap_type := 2;

		elseif(trap_item.graphic == UOBJECT_PURPLE_POTION )
			strength := GetPotionStrength( trap_item );
			cfg_id := 0xfffe;
			trap_type := 3;

		elseif( trap_item.objtype == 0x1bfb )
			cfg_id := 0xfffd;
			strength := 1;
			trap_type := 1;

		else
			SendSysmessage (character, "I don't know how to use these items together");
			return;
		endif

		trapRequest := MakeBackpackRequest(character, trap_item);
	endif

	var element := FindConfigElem( tinker_cfg , cfg_id );

	if( element )
		skill := element.Skill;
	else
		return;
	endif

	var points := Cint( skill * POINTS_MULTIPLIER );
	ConsumeResource(character, trapRequest, 1);

	sendDiff( character , skill );

	if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )
		var permanent;
		var tinkering := GetEffectiveSkill( character , SKILLID_TINKERING );
		if( tinkering < 40 )
			strength := strength - 1;
		elseif( tinkering < 80 )
			strength := strength;
		elseif( tinkering < 120 )
			strength := strength + 1;
		else
			strength := strength + 2;
		endif

		if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			strength := strength + 1;
//		if( Random(200) < tinkering )
//				SetObjProperty( chest , "keep" , 1 );
//				permanent := 1;
//			endif

		elseif( strength <= 0 )
			strength := 1;
		endif

		ConsumeResource(character, trapRequest, 1);
		SetObjProperty( chest , "trap_type" , cstr( trap_type ) );
		SetObjProperty( chest , "trap_strength" , strength );
		SetObjProperty( chest , "trapped_by" , character.serial );
		if( permanent )
			SendSysmessage( character , "You made the trap permanent!" );
		else
			SendSysmessage( character , "The trap is set successfully" );
		endif
		chest.usescript := ":traps:traps";
	else
		var results := Random(5) + 1;
		if (results == 1)
			var the_damage := (Random(30) + 1) * strength;

			if (trap_type == 1)
				SendSysmessage( character , "You fail and harm yourself!");
				ApplyDamage( character , the_damage );
				DestroyItem( chest );

			elseif (trap_type == 2)
				SetPoison( character , strength , "You fail, and poison yourself!" );
				DestroyItem( chest );
			else
				SendSysmessage( character , "You fail, and set off the explosion!" );
				PlayObjectCenteredEffect( character ,  EXPLOSION_ANIM , 5 , 0 );
				PlaySoundEffect( character, EXPLOSION_SOUND );
				ApplyDamage( character , the_damage );
				DestroyItem( chest );
			endif
		else
			SendSysmessage(character, "You failed to place the trap");
		endif
	endif

endfunction


function MakeTotem( me , it, totemRequest := 0 )
	var material := 100;
	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(me, "#PPHC"))
		material := CInt(Ceil(material/2));
	endif

	if(!totemRequest)
		totemRequest := MakeBackpackRequest(me, it);
	endif
	if( GetAvailableResource(me, totemRequest).total < material )
		sendsysmessage( me , "You don't have enough obsidian to make anything." );
		return;
	endif

	if( GetEffectiveSkill( me , SKILLID_MAGERY ) < 70 )
		SendSysMessage( me , "You're not a skilled enough mage to work with that." );
		SendSysmessage( me , "You need atleast 70 magery to work with that.");
		return;
	endif

	if (GetEffectiveSkill( me , SKILLID_TINKERING ) < 70 )
		SendSysMessage( me , "You're not a skilled enough tinker to work with that." );
		SendSysmessage( me , "You need atleast 70 tinkering to work with that.");
		return;
	endif

	_Play_Sound( me , SFX_GLASSBREAK4 );
	ConsumeResource( me , totemRequest , material );

	sendDiff( me , 90);
	sendSecDiff( me , 90);
	if( !CheckSkill( me , SKILLID_MAGERY , 90 , 0 ) or !CheckSkill( me , SKILLID_TINKERING , 90 , 0 ) )
		SendSysMessage( me , "You fail to make anything useful." );
		return;
	endif

	var totem := CreateItemInContainer( me.backpack , 0x20d7 );
	if( !totem )
		SendSysMessage( me , "Your backpack is full!" );
		return;
	endif

	totem.name := "an obsidian golem";
	totem.color := 906;

	SetObjProperty( totem , "critter" ,"earthelementallord" );
	SetObjProperty( totem , "critcolor" , 1109 );
	SetObjProperty( totem , "totemhp" , 170 );
	totem.usescript := ":dundee:totem";
	totem.decay := 0;
	totem.movable := 1;

endfunction


function TryToMakePotionKeg( character , use_on, bottleRequest := 0 )

	var needed_parts := { UOBJ_KEG	,
				UOBJ_BARREL_TAP ,
				UOBJ_BARREL_LID ,
				UOBJ_EMPTY_BOTTLE };


	var parts := array{};
	if(use_on and CInt(use_on.objtype) != UOBJ_EMPTY_BOTTLE)
		parts.append(use_on);
	endif
	var needed_bottles := 10;
	var itemname;
	var points;
	var skill;
	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
		needed_bottles := CInt(Ceil(needed_bottles/2));
	endif

	// Cache-sourced bottles — check availability
	if(bottleRequest)
		if(GetAvailableResource(character, bottleRequest).total < needed_bottles)
			SendSysMessage( character , "You need at least 10 empty bottles." );
			return;
		endif
	elseif( use_on.objtype == UOBJ_EMPTY_BOTTLE )
		bottleRequest := MakeBackpackRequest(character, use_on);
		if( GetAvailableResource(character, bottleRequest).total < needed_bottles )
			SendSysMessage( character , "You need at least 10 empty bottles." );
			return;
		endif

	elseif( use_on.objtype == UOBJ_KEG )
		if( len( EnumerateItemsInContainer( use_on ) ) )
			SendSysMessage( character , "The keg must be empty" );
			return;
		endif
	endif

	foreach objtype in needed_parts
		if(bottleRequest and CInt(objtype) == UOBJ_EMPTY_BOTTLE)
			continue;
		endif
		if( !use_on or objtype != use_on.objtype )
			var have_it := FindObjtypeInContainer( character.backpack , objtype );
			if( !have_it )
				// For bottles, check cache availability when not in backpack
				if(CInt(objtype) == UOBJ_EMPTY_BOTTLE)
					var cacheBottleReq := struct{
						objtype              := CInt(UOBJ_EMPTY_BOTTLE),
						key                  := 0,
						color                := 0,
						quality              := 0,
						preferredSourceOrder := array{ OMEGA_CACHE },
						dataFileHandle       := 0,
						leaseKey             := 0
					};
					// Resolve cache
					var access := FindAccessibleContainer(character, array{REMOVE_FROM_SECURE});
					if(access)
						cacheBottleReq.dataFileHandle := access.df;
					endif
					if(GetAvailableResource(character, cacheBottleReq).total >= needed_bottles)
						// Bottles available in cache — use bottleRequest for consumption
						bottleRequest := cacheBottleReq;
						continue;
					endif
				endif
				SendSysMessage( character , "You miss some parts to make the potion keg." );
				return;

			elseif( have_it.objtype == UOBJ_EMPTY_BOTTLE )
				bottleRequest := MakeBackpackRequest(character, have_it);
				if( GetAvailableResource(character, bottleRequest).total < needed_bottles )
					SendSysMessage( character , "You need at least 10 empty bottles." );
					return;
				endif

			else
				if( ReserveItem( have_it ) )
					parts.append( have_it );
				else
					return;
				endif
			endif
		endif
	endforeach

	//Integrity check — when bottleRequest is set, bottles aren't in parts (consumed separately)
	var expected_parts := len(needed_parts);
	if(bottleRequest)
		expected_parts := expected_parts - 1;
	endif
	if( len( parts ) != expected_parts )
		SendSysMessage( character , "You miss some parts to make the potion keg." );
		return;
	endif

	var element := FindConfigElem( tinker_cfg , UOBJ_POTION_KEG );
	if( element )
	   	itemname := element.Name;
		skill 	 := element.Skill;
	else
		return;
	endif

	points	:= Cint( skill * POINTS_MULTIPLIER );

	_Play_Sound( character , CARPENTER_SOUND );

	// Consume bottles via bottleRequest (always set by this point)
	if(!ConsumeResource(character, bottleRequest, needed_bottles))
		SendSysMessage(character, "You need at least " + needed_bottles + " empty bottles.");
		return;
	endif

	// Destroy physical parts (keg, tap, lid)
	var result_color;
	foreach item in parts
		if( item.color != 0 )
			result_color := item.color;
		endif
		DestroyItem( item );
	endforeach
	
	sendDiff( character , skill );

	if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

		var theitem := CreateItemInBackpack( character , UOBJ_POTION_KEG );
		if( !theitem )
			SendSysMessage( character , "Error in creation process please report this bug on the msg board." );
			return;
		endif

		theitem.movable := 1;
		if( result_color )
			theitem.color := result_color;
		endif
		SetName( theitem , itemname );
		SendSysmessage( character , "You create the potion keg and place it in your pack." );

	else
		SendSysmessage( character , "You fail to create the item and destroy the material." );
	endif

endfunction


function TryToMakeAContainerLockable( character , key )

	var lock_id := GetObjProperty( key , "lockid" );
	if( lock_id )
		SendSysMessage( character , "That key already unlock another lock." );
		return;
	endif

	var the_chest := Target( character , TGTOPT_CHECK_LOS );
	if( !the_chest )
		return;
	endif

	if( !Accessible( character , the_chest ) )
		SendSysmessage( character , "You can't reach that!" );
		return;
	endif

	if( !the_chest.isa( POLCLASS_LOCKABLE ) )
		SendSysMessage( character , "You can't make this lockable" );
		return;
	endif

	if( !ReserveItem( the_chest ) )
		return;
	endif

	if( !IsInContainer( character.backpack , the_chest ) )
		SendSysmessage( character, "The chest have to be in your backpack." );
		return;
	endif

	if( GetObjProperty( the_chest , "lockid" ) or GetObjProperty( the_chest , "lockable" ) )
		SendSysmessage( character, "This is already lockable." );
		return;
	endif

	if( CheckSkill( character , SKILLID_TINKERING , TINKER_LOCKABLE , TINKER_LOCKABLE * POINTS_MULTIPLIER ) )
		SetObjProperty( the_chest , "lockable" , 1 );
		var lockid := AllocLockId();
		the_chest .locked := 1;
		SetObjProperty( key ,  "lockid" , lockid );
		SetObjProperty( the_chest , "lockid" , lockid );
		var tinkering := GetEffectiveSkill( character , SKILLID_TINKERING ) + 20;
		if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			tinkering := Cint( tinkering * ClasseBonus( character , CLASSEID_CRAFTER ) );
		endif
		Setobjproperty( the_chest , "LockDifficulty", tinkering );
		SendSysmessage( character , "You successfully made the item lockable with your key" );
	else
		SendSysMessage( character , "You failed to make the item lockable and destroyed your key." );
		DestroyItem( key );
	endif

endfunction


// ============================================================
// Cache-specific crafting functions
// ============================================================

// Routes a cache-selected material to the appropriate crafting path
function HandleCacheMaterial(character, resourceRequest)
	var ot := CInt(resourceRequest.objtype);
	var item_to_make;
	var sound;

	// Check if it's a log type
	if(IsLogObjtype(ot))
		var cfg := ReadConfigFile( ":carpentry:carpentry" );
		ressource_diff := cfg[ot].Difficulty;
		ressource_name := cfg[ot].Name;
		if(resourceRequest.quality)
			ressource_qual := resourceRequest.quality;
		else
			ressource_qual := cfg[ot].Quality;
		endif
		item_to_make := MakeAndProcessMenu( character , resourceRequest , WOOD_ID );
		sound := CARPENTER_SOUND;

	// Check if it's an ingot type
	elseif(IsIngotObjtype(ot))
		var cfg := ReadConfigFile( ":blacksmithy:blacksmithy" );
		ressource_diff := cfg[ot].Difficulty;
		ressource_name := cfg[ot].Name;
		if(resourceRequest.quality)
			ressource_qual := resourceRequest.quality;
		else
			ressource_qual := cfg[ot].Quality;
		endif
		item_to_make := MakeAndProcessMenu( character , resourceRequest , METAL_ID );
		sound := SFX_ANVIL;

	// Complex component types — single craft, consume from cache
	elseif(ot == UOBJ_AXLE)
		TryToMakeComplex(character, 0, UOBJ_AXLE_AND_GEARS, UOBJ_GEARS, CARPENTER_SOUND, resourceRequest);
		return;
	elseif(ot == UOBJ_GEARS)
		TryToMakeComplex(character, 0, UOBJ_AXLE_AND_GEARS, UOBJ_AXLE, CARPENTER_SOUND, resourceRequest);
		return;
	elseif(ot == UOBJ_CLOCK_FRAME)
		TryToMakeComplex(character, 0, UOBJ_CLOCK, UOBJ_CLOCK_PARTS, SFX_ANVIL, resourceRequest);
		return;
	elseif(ot == UOBJ_CLOCK_PARTS)
		TryToMakeComplex(character, 0, UOBJ_CLOCK, UOBJ_CLOCK_FRAME, SFX_ANVIL, resourceRequest);
		return;
	elseif(ot == UOBJ_SPRINGS)
		TryToMakeComplex(character, 0, UOBJ_CLOCK_PARTS, UOBJ_AXLE_AND_GEARS, SFX_ANVIL, resourceRequest);
		return;
	elseif(ot == UOBJ_AXLE_AND_GEARS)
		// Need to select second component (springs or hinge)
		SendSysMessage(character, "Select either some springs or a hinge.");
		var thing := Target(character, TGTOPT_CHECK_LOS);
		if(!thing)
			return;
		endif
		var secondRequest;
		if(thing.objtype == OMEGACACHE_OBJTYPE)
			secondRequest := SelectMaterialFromCache(character);
			if(!secondRequest)
				return;
			endif
		else
			if(!Accessible(character, thing) or !thing.movable)
				SendSysmessage(character, "You can't reach that!");
				return;
			endif
			if(!ReserveItem(thing))
				return;
			endif
			secondRequest := MakeBackpackRequest(character, thing);
		endif
		var sot := CInt(secondRequest.objtype);
		if(sot == UOBJ_SPRINGS)
			TryToMakeComplex(character, 0, UOBJ_CLOCK_PARTS, 0, SFX_ANVIL, resourceRequest, secondRequest);
		elseif(sot == UOBJ_HINGE)
			TryToMakeComplex(character, 0, UOBJ_SEXTANT_PARTS, 0, SFX_ANVIL, resourceRequest, secondRequest);
		else
			SendSysMessage(character, "You must select either a hinge or springs.");
		endif
		return;
	elseif(ot == UOBJ_HINGE)
		TryToMakeComplex(character, 0, UOBJ_SEXTANT_PARTS, UOBJ_AXLE_AND_GEARS, SFX_ANVIL, resourceRequest);
		return;
	elseif(ot == UOBJ_SEXTANT_PARTS)
		TryToMakeComplex(character, 0, UOBJ_SEXTANT, 0, SFX_ANVIL, resourceRequest);
		return;

	// Obsidian -> totem
	elseif(ot == UOBJ_OBSIDIAN)
		MakeTotem(character, 0, resourceRequest);
		return;

	// Glass / Clay
	elseif(ot == UOBJ_GLASS)
		item_to_make := MakeAndProcessMenu( character , resourceRequest , GLASS_ID );
		sound := SFX_GLASSBREAK4;
	elseif(ot == UOBJ_CLAY)
		item_to_make := MakeAndProcessMenu( character , resourceRequest , CLAY_ID );
		sound := SFX_HAMMER;

	// Empty bottles — potion keg path (cache support for bottles)
	elseif(ot == UOBJ_EMPTY_BOTTLE)
		TryToMakePotionKeg(character, 0, resourceRequest);
		return;

	else
		SendSysMessage(character, "You don't know how to use that.");
		return;
	endif

	item_to_make := item_to_make.objtype;
	if(!item_to_make)
		return;
	endif

	TryToMakeItem(character, resourceRequest, item_to_make, sound);
endfunction






// ============================================================
// Objtype helper functions
// ============================================================

// Objtype-based check for log types (no item reference needed)
function IsLogObjtype(objtype)
	objtype := CInt(objtype);
	if(( objtype >= UOBJ_LOGS_START and objtype <= UOBJ_LOGS_END ) or
	   ( objtype == UOBJ_LOGS_GODDESS ) or ( objtype == UOBJ_LOGS ))
		return 1;
	endif
	return 0;
endfunction

// Objtype-based check for ingot types (no item reference needed)
function IsIngotObjtype(objtype)
	objtype := CInt(objtype);
	if(( objtype >= UOBJ_INGOTS_START  and objtype <= UOBJ_INGOTS_END  ) or
	   ( objtype >= UOBJ_INGOTS2_START and objtype <= UOBJ_INGOTS2_END ) or
	   ( objtype == UOBJ_GOLD_INGOT ))
		return 1;
	endif
	return 0;
endfunction