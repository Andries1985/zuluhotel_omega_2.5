use uo;
use basic;
use os;

include "include/client";
include "include/skillpoints";
include "include/classes";
include "include/attributes";
include ":gumps:include/gumps";

const POINT_VALUE := 200;

// Gump layout constants -- reproduces the OSI blacksmithing-menu frame
// (background 5054, tiled panel art 2624, checkertrans, arrow buttons
// 4005/4007 and 4014/4016) with the crafting-specific bottom section
// dropped, since tracking only needs CATEGORIES + SELECTIONS.
//
// Patch 1.1.4: ported from ZH3.0, which replaced the two classic client menus
// ("Select a category" then "Select a creature") with this one gump. 2.5 keeps
// its "Players" category, which ZH3.0 never had.
const TRACK_EXIT_BTN	:= 1;
const TRACK_CAT_NEXT	:= 2;
const TRACK_CAT_PREV	:= 3;
const TRACK_SEL_NEXT	:= 4;
const TRACK_SEL_PREV	:= 5;
const TRACK_CAT_BASE	:= 100;	// category button = TRACK_CAT_BASE + category index
const TRACK_MOB_BASE	:= 1000;	// creature button = TRACK_MOB_BASE + critter index
const TRACK_ROWS_PER_PAGE	:= 10;	// selections column
const TRACK_CATS_PER_PAGE	:= 10;	// categories column -- 21 fixed categories; only the ones with something in range are listed

program track(who)

	// The unloadconfigfile("::npcdesc") that used to be here is gone (ZH3.0,
	// 2026-09-21). It dropped the cached 1.15 MB file on EVERY use of the skill
	// and forced a re-read, while running NPC scripts kept the old copy alive
	// beside it.

	var ranger := GetObjProperty( who , CLASSEID_RANGER );
	var mysticarcher := GetObjProperty( who , CLASSEID_MYSTIC_ARCHER );
	var points := POINT_VALUE;

	PrintTextAbovePrivate(who, "You begin to track nearby creatures.", who, 3, 0x0035, 1);
	//Resetting tracking timeout and counter properties
	EraseObjProperty(who , "#trackingtimeout");
	EraseObjProperty(who, "TrackingCounter");
	Sleep(5);

	if( !checkskill(who, SKILLID_TRACKING, -1, points))
		SendSysmessage(who, "You fail to find any creatures nearby");
		return;
	endif

	var tracker := ReadGameClock();
	SetObjProperty(who, "TrackingCounter", tracker);

	var range := Cint(GetEffectiveSkill(who, SKILLID_TRACKING)/3);
	if( ranger )
		range := Cint( range * ClasseBonusByLevel( ranger ) );
	elseif( mysticarcher )
		range := Cint( range * ClasseBonusByLevel( mysticarcher ) );
	endif

	var nearby := ListMobilesNearLocation(who.x, who.y, LIST_IGNORE_Z, range, who.realm);
	if(len(nearby) == 1)
		SendSysmessage (who, "There don't seem to be any creatures nearby");
		return;
	endif

	var config := ReadConfigFile("::npcdesc");
	var who_track_skill := GetEffectiveSkill(who, SKILLID_TRACKING);
	var untrackable_reported := dictionary;

	// Single classification pass: bucket every trackable, in-range mobile
	// into its category (players into "Players"; boss-tier creatures collapse
	// into "Champion", gated by skill same as before). critter_ids is the
	// master, flat list of mobiles; category_mobiles[type] holds indices into it.
	var category_mobiles := dictionary;
	var critter_ids := array;
	var critter_count := 0;

	foreach mobile in nearby
		if((mobile == who) or mobile.dead)
			continue;
		endif

		var mobile_type;
		if(IsTrackablePlayer(mobile))
			mobile_type := "Players";
		else
			if(!mobile.npctemplate)
				continue;
			endif
			var elem := FindConfigElem(config, mobile.npctemplate);
			if(!elem)
				if(!untrackable_reported.exists(mobile.npctemplate))
					untrackable_reported[mobile.npctemplate] := 1;
					SendSysmessage(who, "An untrackable creature is nearby (not in npcdesc): " + mobile.npctemplate + " -- please report.");
				endif
				continue;
			endif

			if(GetObjProperty(mobile, "LesserBoss") and who_track_skill >= 100)
				mobile_type := "Champion";
			elseif(GetObjProperty(mobile, "Boss") and who_track_skill >= 125)
				mobile_type := "Champion";
			elseif(GetObjProperty(mobile, "SuperBoss") and who_track_skill >= 140)
				mobile_type := "Champion";
			elseif(GetObjProperty(mobile, "Champion") and who_track_skill >= 150)
				mobile_type := "Champion";
			elseif(GetObjProperty(mobile, "Boss") or GetObjProperty(mobile, "SuperBoss") or GetObjProperty(mobile, "Champion") or GetObjProperty(mobile, "LesserBoss"))
				// Boss-tier but not enough skill yet to reveal it.
				continue;
			else
				mobile_type := NormalizeTrackingType(GetObjProperty(mobile, "Type"));
			endif

			if(!mobile_type)
				if(!untrackable_reported.exists(mobile.npctemplate))
					untrackable_reported[mobile.npctemplate] := 1;
					SendSysmessage(who, "An untrackable creature is nearby (no Type): " + mobile.npctemplate + " -- please report.");
				endif
				continue;
			endif
		endif

		critter_count := critter_count + 1;
		critter_ids[critter_count] := mobile;

		if(!category_mobiles.exists(mobile_type))
			category_mobiles[mobile_type] := array;
		endif
		category_mobiles[mobile_type].append(critter_count);
	endforeach

	if(critter_count == 0)
		SendSysmessage(who, "There don't seem to be any creatures nearby");
		return;
	endif

	// Display order -- the 21 possible categories (19 Type values, the
	// boss-tier "Champion" bucket and "Players") in a fixed, consistent order.
	// Only the ones that actually turned up something nearby get listed.
	var all_categories := array;
	all_categories.append("Animal");
	all_categories.append("Animated");
	all_categories.append("Beholder");
	all_categories.append("Champion");
	all_categories.append("Daemon");
	all_categories.append("Dragonkin");
	all_categories.append("Elemental");
	all_categories.append("Ethereal");
	all_categories.append("Gargoyle");
	all_categories.append("Giantkin");
	all_categories.append("Human");
	all_categories.append("Miscellaneous");
	all_categories.append("Ophidian");
	all_categories.append("Orc");
	all_categories.append("Plant");
	all_categories.append("Players");
	all_categories.append("Ratkin");
	all_categories.append("Slime");
	all_categories.append("Terathan");
	all_categories.append("Troll");
	all_categories.append("Undead");

	var categories := array;
	foreach cat in all_categories
		if(category_mobiles.exists(cat))
			categories.append(cat);
		endif
	endforeach
	var category_count := len(categories);

	var chosen_critter := 0;
	var sel_category := "";
	var sel_page := 0;
	var cat_page := 0;

	while(1)
		var gump := GFCreateGump(50, 50);
		GFResizePic(gump, 0, 0, 5054, 530, 340);
		GFPicTiled(gump, 10, 10, 510, 22, 2624);
		GFPicTiled(gump, 10, 37, 200, 250, 2624);
		GFPicTiled(gump, 215, 37, 305, 250, 2624);
		GFAddAlphaRegion(gump, 10, 10, 510, 277);

		GFTextLine(gump, 15, 12, 1153, "TRACKING MENU");
		GFTextLine(gump, 15, 40, 1153, "CATEGORIES");
		if(sel_category != "")
			GFTextLine(gump, 220, 40, 1153, "SELECTIONS: "+sel_category);
		else
			GFTextLine(gump, 220, 40, 1153, "SELECTIONS");
		endif

		// Categories column
		var cat_start := cat_page*TRACK_CATS_PER_PAGE + 1;
		var cat_end := cat_start + (TRACK_CATS_PER_PAGE-1);
		if(cat_end > category_count)
			cat_end := category_count;
		endif
		var row_y := 62;
		var ci;
		for(ci := cat_start; ci <= cat_end; ci += 1)
			var cat_hue := 1153;
			if(categories[ci] == sel_category)
				cat_hue := 149;
			endif
			(gump.layout).Append("Button 15 "+CStr(row_y)+" 4005 4007 1 0 "+CStr(TRACK_CAT_BASE+ci));
			GFTextLine(gump, 50, row_y+3, cat_hue, categories[ci]);
			row_y := row_y + 20;
		endfor
		if(cat_end < category_count)
			(gump.layout).Append("Button 15 262 4005 4007 1 0 "+CStr(TRACK_CAT_NEXT));
			GFTextLine(gump, 50, 265, 1153, "More");
		endif
		if(cat_page > 0)
			(gump.layout).Append("Button 150 262 4014 4016 1 0 "+CStr(TRACK_CAT_PREV));
			GFTextLine(gump, 175, 265, 1153, "Back");
		endif

		// Selections column
		if(sel_category != "")
			var cat_list := category_mobiles[sel_category];
			var cat_total := len(cat_list);
			var start_idx := sel_page*TRACK_ROWS_PER_PAGE + 1;
			var end_idx := start_idx + (TRACK_ROWS_PER_PAGE-1);
			if(end_idx > cat_total)
				end_idx := cat_total;
			endif
			row_y := 62;
			var slot;
			for(slot := start_idx; slot <= end_idx; slot += 1)
				var master_idx := cat_list[slot];
				var mob := critter_ids[master_idx];
				(gump.layout).Append("Button 220 "+CStr(row_y)+" 4005 4007 1 0 "+CStr(TRACK_MOB_BASE+master_idx));
				GFTextLine(gump, 255, row_y+3, 1153, mob.name);
				row_y := row_y + 20;
			endfor
			if(end_idx < cat_total)
				(gump.layout).Append("Button 220 262 4005 4007 1 0 "+CStr(TRACK_SEL_NEXT));
				GFTextLine(gump, 255, 265, 1153, "Next Page");
			endif
			if(sel_page > 0)
				(gump.layout).Append("Button 400 262 4014 4016 1 0 "+CStr(TRACK_SEL_PREV));
				GFTextLine(gump, 435, 265, 1153, "Prev Page");
			endif
		else
			GFTextLine(gump, 255, 62, 1153, "Pick a category first.");
		endif

		GFAddButton(gump, 15, 300, 4017, 4019, GF_CLOSE_BTN, TRACK_EXIT_BTN);
		GFTextLine(gump, 50, 303, 1153, "EXIT");

		var result := GFSendGump(who, gump);
		if(!result)
			SendSysmessage (who, "Targeting canceled.");
			return;
		endif

		var clicked := CInt(result[0]);

		if(!clicked or clicked == TRACK_EXIT_BTN)
			SendSysmessage (who, "Targeting canceled.");
			return;
		elseif(clicked == TRACK_CAT_NEXT)
			cat_page := cat_page + 1;
		elseif(clicked == TRACK_CAT_PREV)
			if(cat_page > 0)
				cat_page := cat_page - 1;
			endif
		elseif(clicked == TRACK_SEL_NEXT)
			sel_page := sel_page + 1;
		elseif(clicked == TRACK_SEL_PREV)
			if(sel_page > 0)
				sel_page := sel_page - 1;
			endif
		elseif(clicked >= TRACK_MOB_BASE)
			var master_idx := clicked - TRACK_MOB_BASE;
			if(master_idx >= 1 and master_idx <= critter_count)
				chosen_critter := critter_ids[master_idx];
				break;
			endif
		elseif(clicked >= TRACK_CAT_BASE)
			var cat_idx := clicked - TRACK_CAT_BASE;
			if(cat_idx >= 1 and cat_idx <= category_count)
				sel_category := categories[cat_idx];
				sel_page := 0;
			endif
		endif
	endwhile

	if(!chosen_critter)
		SendSysmessage (who, "Targeting canceled.");
		return;
	endif

	var critter := chosen_critter;

	SetObjProperty( who , "#trackingtimeout" , ReadGameClock()+40 );
	Detach();
	var trackingtimer := 0;

	while((Distance(who, critter) <= range) and (critter.dead == 0) and (trackingtimer <= 12) and (tracker == GetObjProperty(who,"TrackingCounter")))
		trackingtimer := trackingtimer + 1;
		var dir := Get_direction(who, critter);
		If(dir == "nearby")
			SendSysmessage(who, critter.name + " is " + dir);
		else
			SendSysmessage(who, critter.name + " is to the " + dir);
		endif
		sleep(5);
	endwhile
	SendSysmessage(who, "You have lost your quarry.");
	EraseObjProperty(who , "#trackingtimeout");
	return;

endprogram

function get_direction(who, critter)
	var ns_desc := "";
	var ew_desc := "";
	var thedesc;

	if(critter.y < who.y)
		ns_desc := "north";
	elseif(critter.y > who.y)
		ns_desc := "south";
	endif

	if(critter.x < who.x)
		ew_desc := "west";
	elseif(critter.x > who.x)
		ew_desc := "east";
	endif

	if(ns_desc == "" and ew_desc == "")
		thedesc := "nearby";
	else
		thedesc := ns_desc + ew_desc ;
	endif

	return thedesc;
endfunction

function IsTrackablePlayer(mobile)
	return (!mobile.npctemplate && mobile.acctname);
endfunction

function NormalizeTrackingType(value)
	if(!value)
		return "";
	endif

	case(Lower(value))
		"animal":			return "Animal";
		"animated":			return "Animated";
		"beholder":			return "Beholder";
		"champion":			return "Champion";
		"daemon":			return "Daemon";
		"dragonkin":		return "Dragonkin";
		"elemental":		return "Elemental";
		"ethereal":			return "Ethereal";
		"gargoyle":			return "Gargoyle";
		"giantkin":			return "Giantkin";
		"human":			return "Human";
		"miscellaneous":	return "Miscellaneous";
		"ophidian":			return "Ophidian";
		"orc":				return "Orc";
		"plant":			return "Plant";
		"ratkin":			return "Ratkin";
		"slime":			return "Slime";
		"terathan":			return "Terathan";
		"troll":			return "Troll";
		"undead":			return "Undead";
		default:			return value;
	endcase
endfunction
