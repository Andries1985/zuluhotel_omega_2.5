// by Zulu (zulu@zuluhotel.com)   July 5, 2000

use uo;
use os;
use cfgfile;
use cliloc;

include "include/chests";
include "include/starteqp";
include "include/skillpoints";
include "include/difficulty";

program pick( me, lockpick )

	If (!ReserveItem(lockpick)) return; endif

	SendSysMessage(me, "Pick what?");
	var chest := Target(me);
	if (!chest) return; endif

	If (!ReserveItem(chest)) return; endif

	if ( (not Accessible(me,chest)) or (not Accessible(me,lockpick)) )
		SendSysMessage(me, "Can't reach it!");
		return;
	endif

	if (!chest.locked)
		SendSysMessage(me,"That doesn't appear to be locked.");
		return;
	endif

	if ( Distance(me, chest) > 2 )
		SendSysMessage(me, "Can't reach it!");
		return;
	endif

	if (getobjproperty(chest, "#U"))
        	if (getobjproperty(chest, "#U") > readgameclock())
                	sendsysmessage(me,"You must wait to pick this lock!");
                	return;
        	endif
	endif

	if (!canpick(chest))
        	Sendsysmessage(me,"The Gods frown on picking this door!");
        	playlightningbolteffect(me);
        	return;
	endif

	if(GetObjProperty( chest, PROPID_CHEST_SPAWNPOINT_CHEST ))
		PickTreasureChest(me, lockpick, chest);
		return;
	else

		var lvl:=finddiff(chest);

		if(lvl)
			var tester:=cint(lvl);
			if(tester > 150)
				tester := 150;
			endif
			sendDiff( me , tester );
		endif

		if(!lvl)
			SendSysMessage(me,"You have no chance of picking that lock!");
			return;
		endif

		if (LockPickTheThing(me,chest,lvl,lockpick))
			if (TypeOf(GetObjProperty(chest,"spawnchest"))=="Integer")
				//SpawnTheChest(chest);
			endif
		endif
	endif

endprogram

function SpawnTheChest(chest)
	return 0;
	var level:=Cint(GetObjProperty(chest,"spawnchest"));

	if(level)
	  MakeLoot(chest,level+108);
	  addchest(chest);
	endif

endfunction

function LockPickTheThing(me,chest,lvl,lockpick)

	PlaySoundEffect(chest,SFX_242);
	sleep(2);
	if(lvl > 150)
		lvl := 150;
	else
		lvl:=cint(lvl);
	endif

	var mobs:=ListHostiles(me,4);
	if (len(mobs))
		SendSysMessage(me,mobs[1].name+" breaks your concentration!");
		return 0;
	endif

	var skillpoints := get_default_points(SKILLID_LOCKPICKING);

	if ( Checkskill(me,SKILLID_LOCKPICKING,lvl,skillpoints) )
		PlaySoundEffect(chest,SFX_200);
		PrintTextAbovePrivate(chest,"*Unlocked!*",me);
		setobjproperty(chest, "L", me.name);
		chest.locked := 0;
		return 1;
	else
		PrintTextAbovePrivate(chest,"You fail to pick the lock.",me);
		setobjproperty(me, "#U", readgameclock() + 10);
		if (!Checkskill(me,SKILLID_LOCKPICKING,lvl,skillpoints) )
			if(!GetObjProperty(me, CLASSEID_THIEF ) )
			PlaySoundEffect(me,0xef);
			SendSysMessage(me,"Your pick breaks!");
			SubtractAmount(lockpick,1);
			endif
		else
			PlaySoundEffect(chest,SFX_11F);
		endif
		return 0;
	endif

endfunction

function PickTreasureChest(who, lockpick, chest)

//PROPID_CHEST_SPAWNPOINT_LOCK_DIFFICULTY

	if( !GetObjProperty(who, CLASSEID_THIEF) )
		SendSysMessage(who, "You are not a thief!", FONT_NORMAL, 43);
		return;
	endif

	if(!chest.locked)
		SendSysMessageCL( who, 502069, color := 33 ); // This does not appear to be locked.
		return;
	endif

	var lvl := GetObjProperty(chest, PROPID_CHEST_SPAWNPOINT_LOCK_DIFFICULTY);
	//Print("Lock Difficulty: "+lvl);
	if(!lvl)
		SendSysMessageCL( who, 502073, color := 44 ); // This lock cannot be picked by normal means...
		return;
	endif
	if( lvl > 150 )
		lvl := 150;
	else
		lvl := CInt( lvl );
	endif

	var mobs := ListHostiles( who, 4 );
	if (len(mobs))
		SendSysMessage( who, mobs[1].name+" breaks your concentration!", FONT_NORMAL, 43);
		return 0;
	endif

	PlaySoundEffect(who, SFX_242);
	sleep(1);

	var skillpoints := get_default_points(SKILLID_LOCKPICKING);

	if ( Checkskill( who, SKILLID_LOCKPICKING, lvl, skillpoints))
		PlaySoundEffect( chest, SFX_200);
		SendSysMessageCL( who, 502076, color := 66 ); // The lock quickly yields to your skill.
		//PrintTextAbovePrivateCL( who, chest, 3005143, 66 ); // Unlocked
		PrintTextAbovePrivate( chest, "You have unlocked a level " + GetObjProperty(chest, PROPID_CHEST_SPAWN_LEVEL) + " chest!", who, 3, 66, 1 );
		SetObjProperty( chest, "LastPickedBySerial", who.serial );
		chest.locked := 0;
		SubtractAmount( lockpick, 1 );
		SendSysMessage( who, "You have 5 minutes to loot the chest.", FONT_NORMAL, 43 );
		Start_Script( "::misc/deleter", {chest, 300} );
		return;
	else
		PrintTextAbovePrivateCL(who, chest, 502075, color := 33 ); // You are unable to pick the lock.
		if (!Checkskill( who, SKILLID_LOCKPICKING, lvl, skillpoints) )
			PlaySoundEffect( who, 0xef );
			SendSysMessageCL( who, 502074, color := 33 ); // You broke the lockpick.
			SubtractAmount( lockpick, 1 );
		else
			PlaySoundEffect( chest, SFX_11F );
		endif
		return 0;
	endif

endfunction