use uo;
use os;
use basic;
use polsys;

//include "include/client";
//include "include/skillpoints";
//include "include/namingbyenchant";
include "../pkg/opt/talisman/include/talismanid";


// how many seconds between ID
var BASE_DELAY := 30;

program dotalismanid( who, talisman )

    var lastid := GetObjProperty(who, "#LastID");

    //var skill := GetEffectiveSkill( who, SKILLID_ITEMID );
    //var isamage := IsMage(who);

    var delay := BASE_DELAY;

    if ( (lastid+delay) > ReadGameClock() )
        var remaining := (lastid + delay) - ReadGameClock();
        SendSysMessage(who, "You must wait " + remaining + " second" + (remaining == 1 ? "" : "s") + " to use the talisman again.");
        return 0;
    endif
    
    var used_talisman := TalismanID(who, delay, talisman);
    if( used_talisman )
        if( talisman )
            IncRevision( talisman );
        endif
        SetObjProperty(who, "#LastID", ReadGameClock());
    endif

endprogram