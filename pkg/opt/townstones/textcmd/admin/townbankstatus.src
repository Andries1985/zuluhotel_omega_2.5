// Synopsis: Display town treasury balances and toggle upgrades/donations per city
use uo;
use os;
use basic;
use datafile;
use cfgfile;
include ":gumps:gumps";
include ":gumps:yesno";

const TOWNSTONE_DATAFILE := ":townstone:townstone_data";
const PLAYERTOWNS_CFG := ":townstone:playertowns";
const TOWNSTONE_OBJTYPE := 0xa320;
const TOWNSTONE_SEARCH_RANGE := 10000;
const BTN_PREV := 7001;
const BTN_NEXT := 7002;
const BTN_CLOSE := 7003;
const BTN_TOGGLE_UPGRADES_BASE := 8000;
const BTN_TOGGLE_DONATIONS_BASE := 10000;
const BTN_TOGGLE_AVAILABLE_BASE := 13000;
const BTN_DELETE_REGION_BASE := 12000;
const BTN_TOGGLE_PURCHASED_BASE := 14000;
const BTN_POPULATION_BASE := 15000;
const ROWS_PER_PAGE := 10;
const MEMBER_ROWS_PER_PAGE := 10;
const MEMBER_BTN_PREV := 16001;
const MEMBER_BTN_NEXT := 16002;
const MEMBER_BTN_CLOSE := 16003;
const MEMBER_BTN_REMOVE_BASE := 17000;
const TOWN_MAX_CHAR_SLOTS := 7;
const VOTE_RUNE_OBJTYPE := 0xa321;

program textcmd_townbankstatus(who)
	var town_list := GetGlobalProperty("townlist");
	var datafile_regions := GetTownRegionsFromDatafile();
	if((!town_list or !town_list.size()) and (!datafile_regions or !datafile_regions.size()))
		Start_Script(":townstone:townlistbootstrap");
		town_list := GetGlobalProperty("townlist");
		datafile_regions := GetTownRegionsFromDatafile();
	endif

	if((!town_list or !town_list.size()) and (!datafile_regions or !datafile_regions.size()))
		datafile_regions := GetTownRegionsFromLiveStones();
	endif

	if((!town_list or !town_list.size()) and (!datafile_regions or !datafile_regions.size()))
		SendSysMessage(who, "No town regions found in townlist or townstone datafile.");
		return;
	endif

	var candidate_regions := GetCandidateTownRegions();
	if((!candidate_regions or !candidate_regions.size()) and datafile_regions and datafile_regions.size())
		candidate_regions := datafile_regions;
	endif
	if(!candidate_regions or !candidate_regions.size())
		candidate_regions := GetTownRegionsFromLiveStones();
	endif
	if(!candidate_regions or !candidate_regions.size())
		SendSysMessage(who, "No town regions found for status display.");
		return;
	endif

	var regions := {};
	var golds := {};
	var stones_exist := {};
	var has_region_data := {};
	var upgrades_enabled := {};
	var donations_enabled := {};
	var player_purchase_prices := {};
	var player_purchased := {};
	var player_available := {};
	var town_ids := {};
	var populations := {};
	var player_cfg := LoadPlayerTownsConfig();
	var seen_regions := dictionary;
	var total_gold := 0;
	var added_regions := 0;
	var skipped_regions := 0;

	var candidate_idx;
	for(candidate_idx := 1; candidate_idx <= candidate_regions.size(); candidate_idx := candidate_idx + 1)
		var raw_entry := candidate_regions[candidate_idx];
		var region_name := Trim(CStr(raw_entry));
		if(Len(region_name) < 1)
			skipped_regions := skipped_regions + 1;
			continue;
		endif

		var region_key := region_name;
		if(seen_regions[region_key])
			continue;
		endif
		seen_regions[region_key] := 1;

		var has_data := HasTownBankRegionData(region_name);
		var has_stone := HasLiveTownstoneForRegion(region_name, 0);
		if(!has_data and !has_stone)
			skipped_regions := skipped_regions + 1;
			continue;
		endif

		var gold := GetTownBankGold(region_name);
		total_gold := total_gold + gold;
		regions.append(region_name);
		golds.append(gold);
		stones_exist.append(has_stone);
		has_region_data.append(has_data);
		upgrades_enabled.append(IsTownBankFeatureEnabled(region_name, "allow_upgrades"));
		donations_enabled.append(IsTownBankFeatureEnabled(region_name, "allow_donations"));
		var player_info := GetPlayerTownInfo(player_cfg, region_name);
		player_purchase_prices.append(player_info[1]);
		player_purchased.append(player_info[2]);
		player_available.append(player_info[3]);
		var town_id := GetTownIdByRegionName(region_name);
		town_ids.append(town_id);
		populations.append(GetTownPopulation(region_name, town_id));
		added_regions := added_regions + 1;
	endfor

	if(!regions.size())
		SendSysMessage(who, "No town regions found in townlist.");
		return;
	endif

	ShowTownBankStatusGump(who, regions, golds, stones_exist, has_region_data, upgrades_enabled, donations_enabled, player_purchase_prices, player_purchased, player_available, town_ids, populations, total_gold);

endprogram


function GetCandidateTownRegions()
	var candidates := {};
	var seen := dictionary;

	var city_regions := GetCityRegionsFromConfig();
	if(city_regions and city_regions.size())
		var city_idx;
		for(city_idx := 1; city_idx <= city_regions.size(); city_idx := city_idx + 1)
			var city_name := Trim(CStr(city_regions[city_idx]));
			if(Len(city_name) < 1)
				continue;
			endif
			var city_key := Lower(city_name);
			if(seen[city_key])
				continue;
			endif
			seen[city_key] := 1;
			candidates.append(city_name);
		endfor
	endif

	var data_regions := GetTownRegionsFromDatafile();
	if(data_regions and data_regions.size())
		var data_idx;
		for(data_idx := 1; data_idx <= data_regions.size(); data_idx := data_idx + 1)
			var data_name := Trim(CStr(data_regions[data_idx]));
			if(Len(data_name) < 1)
				continue;
			endif
			var data_key := Lower(data_name);
			if(seen[data_key])
				continue;
			endif
			seen[data_key] := 1;
			candidates.append(data_name);
		endfor
	endif

	return candidates;
endfunction


function ShowTownMemberManagerGump(who, region_name, town_id)
	if(!region_name)
		SendSysMessage(who, "Invalid town region.");
		return;
	endif

	var page := 1;
	while(1)
		var stone := FindTownstoneByRegion(region_name, town_id);
		if(!stone)
			SendSysMessage(who, "No live townstone found for " + CStr(region_name) + ".");
			return;
		endif

		var members := GetTownMembersForStone(stone, CInt(GetObjProperty(stone, "town")));
		var total := members.size();
		if(!total)
			SendSysMessage(who, "No members found for " + CStr(region_name) + ".");
			return;
		endif

		var total_pages := CInt((total + MEMBER_ROWS_PER_PAGE - 1) / MEMBER_ROWS_PER_PAGE);
		if(page < 1)
			page := 1;
		elseif(page > total_pages)
			page := total_pages;
		endif

		var start_idx := ((page - 1) * MEMBER_ROWS_PER_PAGE) + 1;
		var end_idx := start_idx + MEMBER_ROWS_PER_PAGE - 1;
		if(end_idx > total)
			end_idx := total;
		endif

		var gump := GFCreateGump(30, 30, 1020, 410);
		GFDisposable(gump, 0);
		GFMovable(gump, 1);
		GFResizePic(gump, 0, 0, GFGetCfgConst("Defaults", "BackGround"), 1020, 410);
		GFResizePic(gump, 15, 15, GFGetCfgConst("Defaults", "ForeGround"), 990, 380);
		GFPage(gump, 1);

		GFTextLine(gump, 28, 28, 1153, "Town Members: " + CStr(region_name));
		GFTextLine(gump, 28, 48, 1153, "Page " + CStr(page) + " of " + CStr(total_pages));
		GFTextLine(gump, 28, 68, 1153, "Member Name");
		GFTextLine(gump, 760, 68, 1153, "Account");
		GFTextLine(gump, 900, 68, 38, "Remove");

		var row := 0;
		var i;
		for(i := start_idx; i <= end_idx; i := i + 1)
			var y := 92 + (row * 24);
			var entry := members[i];
			GFTextCrop(gump, 28, y, 720, 20, 1153, CStr(entry[1]));
			GFTextCrop(gump, 760, y, 130, 20, 1153, CStr(entry[2]));
			GFAddButton(gump, 900, y - 2, 2474, 2473, GF_CLOSE_BTN, MEMBER_BTN_REMOVE_BASE + i);
			GFTextLine(gump, 934, y, 38, "Del");
			row := row + 1;
		endfor

		if(page > 1)
			GFAddButton(gump, 28, 362, 2117, 2118, GF_CLOSE_BTN, MEMBER_BTN_PREV);
			GFTextLine(gump, 63, 364, 1153, "Previous");
		endif

		if(page < total_pages)
			GFAddButton(gump, 900, 362, 2117, 2118, GF_CLOSE_BTN, MEMBER_BTN_NEXT);
			GFTextLine(gump, 935, 364, 1153, "Next");
		endif

		GFAddButton(gump, 250, 362, 2152, 2151, GF_CLOSE_BTN, MEMBER_BTN_CLOSE);
		GFTextLine(gump, 285, 364, 1153, "Close");

		var res := GFSendGump(who, gump);
		if(!res[0] or res[0] == MEMBER_BTN_CLOSE)
			return;
		elseif(res[0] == MEMBER_BTN_PREV)
			page := page - 1;
			continue;
		elseif(res[0] == MEMBER_BTN_NEXT)
			page := page + 1;
			continue;
		elseif(res[0] > MEMBER_BTN_REMOVE_BASE and res[0] <= (MEMBER_BTN_REMOVE_BASE + total))
			var remove_idx := res[0] - MEMBER_BTN_REMOVE_BASE;
			var remove_entry := members[remove_idx];
			if(!remove_entry)
				continue;
			endif

			var member_name := CStr(remove_entry[1]);
			var member_acct := CStr(remove_entry[2]);
			if(!YesNo(who, "Remove " + member_name + " from " + CStr(region_name) + "?", "Remove", "Cancel"))
				continue;
			endif

			var remove_result := RemoveTownMemberByAccount(stone, region_name, CInt(GetObjProperty(stone, "town")), member_acct);
			if(remove_result)
				SendSysMessage(who, "Removed " + member_name + " from " + CStr(region_name) + ".");
			else
				SendSysMessage(who, "Failed to remove " + member_name + " from " + CStr(region_name) + ".");
			endif
			continue;
		else
			return;
		endif
	endwhile
endfunction


function GetTownMembersForStone(stone, town_id)
	var members := {};
	if(!stone)
		return members;
	endif

	var citizen := GetObjProperty(stone, "citizen");
	if(!citizen)
		citizen := {};
	endif

	var i;
	for(i := 1; i <= citizen.size(); i := i + 1)
		var account_name := Trim(CStr(citizen[i]));
		if(!account_name)
			continue;
		endif

		var display := ResolveTownMemberDisplay(account_name, town_id);
		if(!display[2])
			continue;
		endif
		members.append({display[1], account_name, display[2]});
	endfor

	return members;
endfunction


function ResolveTownMemberDisplay(account_name, town_id)
	var result := {account_name, 0};
	if(!account_name)
		return result;
	endif

	var account := FindAccount(account_name);
	if(!account)
		return result;
	endif

	var slot;
	for(slot := 1; slot <= TOWN_MAX_CHAR_SLOTS; slot := slot + 1)
		var character := account.GetCharacter(slot);
		if(!character)
			continue;
		endif

		if(town_id and CInt(GetObjProperty(character, "town")) != CInt(town_id))
			continue;
		endif

		result[1] := CStr(character.name);
		result[2] := CInt(character.serial);
		return result;
	endfor

	return result;
endfunction


function RemoveTownMemberByAccount(stone, region_name, town_id, account_name)
	if(!stone or !region_name or !account_name)
		return 0;
	endif

	var citizen := GetObjProperty(stone, "citizen");
	if(!citizen)
		citizen := {};
	endif

	var removed_from_list := RemoveCitizenAccount(citizen, account_name);
	if(removed_from_list)
		SetObjProperty(stone, "citizen", citizen);
	endif

	var removed_serials := {};
	var removed_names := {};
	var account := FindAccount(account_name);
	if(account)
		var slot;
		for(slot := 1; slot <= TOWN_MAX_CHAR_SLOTS; slot := slot + 1)
			var character := account.GetCharacter(slot);
			if(!character)
				continue;
			endif

			if(town_id and CInt(GetObjProperty(character, "town")) != CInt(town_id))
				continue;
			endif

			removed_serials.append(CInt(character.serial));
			removed_names.append(CStr(character.name));

			EraseObjProperty(character, "town");
			var cleaned_name := StripTownSuffix(CStr(character.name), CStr(region_name));
			if(cleaned_name != CStr(character.name))
				character.name := cleaned_name;
			endif
			SendSysMessage(character, "You are no longer citizen of " + CStr(region_name) + ".");
		endfor
	endif

	var refreshed_citizens := {};
	var citizen_idx;
	for(citizen_idx := 1; citizen_idx <= citizen.size(); citizen_idx := citizen_idx + 1)
		var citizen_account := Trim(CStr(citizen[citizen_idx]));
		if(!citizen_account)
			continue;
		endif
		if(Lower(citizen_account) == Lower(CStr(account_name)))
			continue;
		endif

		var citizen_display := ResolveTownMemberDisplay(citizen_account, town_id);
		if(citizen_display[2])
			refreshed_citizens.append(citizen_account);
		endif
	endfor
	if(refreshed_citizens.size() != citizen.size() or removed_from_list)
		SetObjProperty(stone, "citizen", refreshed_citizens);
	endif

	var is_mayor := IsMayorAccount(stone, account_name, removed_serials);

	var populacao := CInt(GetObjProperty(stone, "populacao"));
	if(populacao < 0)
		populacao := 0;
	endif
	if(removed_from_list and populacao > 0)
		populacao := populacao - 1;
	endif
	SetObjProperty(stone, "populacao", populacao);

	CleanupElectionMembershipForAccount(stone, account_name, removed_serials, removed_names, populacao, is_mayor);

	if(is_mayor)
		EraseObjProperty(stone, "mayor");
		EraseObjProperty(stone, "mayorserial");
		SetObjProperty(stone, "nextcitizenelection", 0);
	endif

	SyncTownstoneState(stone, region_name, town_id);
	return 1;
endfunction


function CleanupElectionMembershipForAccount(stone, account_name, removed_serials, removed_names, populacao, is_mayor)
	if(!stone)
		return;
	endif

	var eleicoes := CInt(GetObjProperty(stone, "eleicao"));
	var pleibicito := GetObjProperty(stone, "pleibicito");

	if(eleicoes)
		var candidatos := GetObjProperty(stone, "candidatos");
		if(!candidatos)
			candidatos := {};
		endif

		var newlist := {};
		var idx;
		for(idx := 1; idx <= candidatos.size(); idx := idx + 2)
			var cand_serial := candidatos[idx];
			var cand_name := candidatos[idx + 1];
			var remove_candidate := IsSerialInList(CInt(cand_serial), removed_serials) or IsNameInList(CStr(cand_name), removed_names);
			if(!remove_candidate)
				newlist.append(cand_serial);
				newlist.append(cand_name);
			endif
		endfor

		SetObjProperty(stone, "candidatos", newlist);
	endif

	var votos := CInt(GetObjProperty(stone, "votos"));
	if(votos < 0)
		votos := 0;
	endif

	foreach runa in EnumerateItemsInContainer(stone)
		if(runa.objtype == VOTE_RUNE_OBJTYPE and Lower(CStr(GetObjProperty(runa, "serial"))) == Lower(CStr(account_name)))
			DestroyItem(runa);
			if(votos > 0)
				votos := votos - 1;
			endif
		endif
	endforeach

	SetObjProperty(stone, "votos", votos);
	if(populacao > 0)
		SetObjProperty(stone, "votepercent", CInt((votos * 100) / populacao));
	else
		SetObjProperty(stone, "votepercent", 0);
	endif

	if(is_mayor and (eleicoes or pleibicito))
		// If the removed member was mayor, close any ongoing election/poll to avoid orphaned state.
		SetObjProperty(stone, "eleicao", 0);
		SetObjProperty(stone, "pleibicito", 0);
		SetObjProperty(stone, "candidatos", {});
		SetObjProperty(stone, "votos", 0);
		SetObjProperty(stone, "votepercent", 0);
		SetObjProperty(stone, "timer", 0);
		foreach vote_rune in EnumerateItemsInContainer(stone)
			if(vote_rune.objtype == VOTE_RUNE_OBJTYPE)
				DestroyItem(vote_rune);
			endif
		endforeach
	endif
endfunction


function FindTownstoneByRegion(region_name, town_id)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(df)
		var elem := df.FindElement(region_name);
		if(elem)
			var serial := CInt(elem.GetProp("stone_serial"));
			if(serial)
				var direct_stone := SystemFindObjectBySerial(serial);
				if(direct_stone and direct_stone.objtype == TOWNSTONE_OBJTYPE)
					UnloadDataFile(TOWNSTONE_DATAFILE);
					return direct_stone;
				endif
			endif
		endif
		UnloadDataFile(TOWNSTONE_DATAFILE);
	endif

	var stones := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, "britannia");
	if(!stones or !stones.size())
		return 0;
	endif

	foreach stone in stones
		if(!stone or stone.objtype != TOWNSTONE_OBJTYPE)
			continue;
		endif

		if(town_id and CInt(GetObjProperty(stone, "town")) == CInt(town_id))
			return stone;
		endif

		if(CStr(GetObjProperty(stone, "regionname")) == CStr(region_name))
			return stone;
		endif
	endforeach

	return 0;
endfunction


function GetTownPopulation(region_name, town_id)
	var stone := FindTownstoneByRegion(region_name, town_id);
	if(stone)
		var pop := CInt(GetObjProperty(stone, "populacao"));
		if(pop < 0)
			pop := 0;
		endif

		if(pop <= 0)
			var citizen := GetObjProperty(stone, "citizen");
			if(citizen and citizen.size())
				pop := citizen.size();
			endif
		endif

		return pop;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 0;
	endif

	var data_pop := CInt(elem.GetProp("populacao"));
	UnloadDataFile(TOWNSTONE_DATAFILE);
	if(data_pop < 0)
		data_pop := 0;
	endif

	return data_pop;
endfunction


function GetTownIdByRegionName(region_name)
	if(!region_name)
		return 0;
	endif

	var town_list := GetGlobalProperty("townlist");
	if(!town_list or !town_list.size())
		return 0;
	endif

	var idx;
	for(idx := 1; idx <= town_list.size(); idx := idx + 1)
		if(Lower(CStr(town_list[idx])) == Lower(CStr(region_name)))
			return idx;
		endif
	endfor

	return 0;
endfunction


function IsMayorAccount(stone, account_name, removed_serials)
	if(!stone or !account_name)
		return 0;
	endif

	var mayor_serial := CInt(GetObjProperty(stone, "mayorserial"));
	if(mayor_serial and IsSerialInList(mayor_serial, removed_serials))
		return 1;
	endif

	if(!mayor_serial)
		return 0;
	endif

	var mayor_mobile := SystemFindObjectBySerial(mayor_serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
	if(!mayor_mobile)
		mayor_mobile := SystemFindObjectBySerial(mayor_serial);
	endif
	if(!mayor_mobile)
		return 0;
	endif

	return (Lower(CStr(mayor_mobile.acctname)) == Lower(CStr(account_name)));
endfunction


function RemoveCitizenAccount(citizen_list, account_name)
	if(!citizen_list or !account_name)
		return 0;
	endif

	var i;
	for(i := 1; i <= citizen_list.size(); i := i + 1)
		if(Lower(CStr(citizen_list[i])) == Lower(CStr(account_name)))
			citizen_list.erase(i);
			return 1;
		endif
	endfor

	return 0;
endfunction


function IsSerialInList(serial_value, serials)
	if(!serials or !serials.size())
		return 0;
	endif

	var i;
	for(i := 1; i <= serials.size(); i := i + 1)
		if(CInt(serials[i]) == CInt(serial_value))
			return 1;
		endif
	endfor

	return 0;
endfunction


function IsNameInList(name_value, names)
	if(!name_value or !names or !names.size())
		return 0;
	endif

	var lookup_name := Lower(CStr(name_value));
	var i;
	for(i := 1; i <= names.size(); i := i + 1)
		if(Lower(CStr(names[i])) == lookup_name)
			return 1;
		endif
	endfor

	return 0;
endfunction


function SyncTownstoneState(stone, region_name, town_id)
	if(!stone or !region_name)
		return;
	endif

	if(!town_id)
		town_id := CInt(GetObjProperty(stone, "town"));
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		elem := df.CreateElement(region_name);
	endif
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return;
	endif

	var gold := CInt(elem.GetProp("gold"));
	if(gold < 0)
		gold := 0;
	endif

	var mayor_state := GetObjProperty(stone, "mayor");
	if(!mayor_state)
		mayor_state := "";
	endif

	var candidatos_state := GetObjProperty(stone, "candidatos");
	if(!candidatos_state)
		candidatos_state := {};
	endif

	var pleibicito_result_state := GetObjProperty(stone, "Pleibicito_Result");
	if(!pleibicito_result_state)
		pleibicito_result_state := {};
	endif

	var citizen_state := GetObjProperty(stone, "citizen");
	if(!citizen_state)
		citizen_state := {};
	endif

	elem.SetProp("gold", gold);
	elem.SetProp("town_id", town_id);
	elem.SetProp("stone_serial", stone.serial);
	elem.SetProp("mayor", mayor_state);
	elem.SetProp("mayorserial", CInt(GetObjProperty(stone, "mayorserial")));
	elem.SetProp("populacao", CInt(GetObjProperty(stone, "populacao")));
	elem.SetProp("eleicao", CInt(GetObjProperty(stone, "eleicao")));
	elem.SetProp("pleibicito", CInt(GetObjProperty(stone, "pleibicito")));
	elem.SetProp("candidatos", candidatos_state);
	elem.SetProp("votos", CInt(GetObjProperty(stone, "votos")));
	elem.SetProp("votepercent", CInt(GetObjProperty(stone, "votepercent")));
	elem.SetProp("timer", CInt(GetObjProperty(stone, "timer")));
	elem.SetProp("Pleibicito_Result", pleibicito_result_state);
	elem.SetProp("nextcitizenelection", CInt(GetObjProperty(stone, "nextcitizenelection")));
	elem.SetProp("citizen", citizen_state);

	UnloadDataFile(TOWNSTONE_DATAFILE);
endfunction


function StripTownSuffix(character_name, town_name)
	if(!character_name or !town_name)
		return character_name;
	endif

	var safe_town_name := StrReplace(town_name, "'", "");
	var stripped_name := StripExactSuffix(character_name, " of " + safe_town_name);
	if(stripped_name != character_name)
		return stripped_name;
	endif

	return StripExactSuffix(character_name, " of " + town_name);
endfunction


function StripExactSuffix(base_text, suffix)
	if(!base_text or !suffix)
		return base_text;
	endif

	var start_pos := Find(base_text, suffix, 1);
	if(!start_pos)
		return base_text;
	endif

	if((start_pos + Len(suffix) - 1) != Len(base_text))
		return base_text;
	endif

	if(start_pos <= 1)
		return base_text;
	endif

	return base_text[1, start_pos - 1];
endfunction


function GetCityRegionsFromConfig()
	UnloadConfigFile("regions");
	var regions_cfg := ReadConfigFile("::regions/regions");
	if(!regions_cfg)
		return {};
	endif

	var region_names := GetConfigStringKeys(regions_cfg);
	if(!region_names or !region_names.size())
		region_names := GetConfigStringArray(regions_cfg[1], "Region");
	endif

	if(!region_names or !region_names.size())
		return {};
	endif

	var city_regions := {};
	var region_idx;
	for(region_idx := 1; region_idx <= region_names.size(); region_idx := region_idx + 1)
		var region_name := CStr(region_names[region_idx]);
		var elem := regions_cfg[region_name];
		if(!elem)
			elem := FindConfigElem(regions_cfg, region_name);
		endif
		if(!elem)
			continue;
		endif

		var city_raw := GetConfigString(elem, "City");
		if(city_raw.errortext)
			continue;
		endif

		if(CInt(city_raw) != 1)
			continue;
		endif

		city_regions.append(CStr(region_name));
	endfor

	return city_regions;
endfunction


function HasTownBankRegionData(region_name)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	UnloadDataFile(TOWNSTONE_DATAFILE);

	if(elem)
		return 1;
	endif

	return 0;
endfunction


function ShowTownBankStatusGump(who, regions, golds, stones_exist, has_region_data, upgrades_enabled, donations_enabled, player_purchase_prices, player_purchased, player_available, town_ids, populations, total_gold)
	var total := regions.size();
	if(!total)
		return;
	endif

	var page := 1;
	var total_pages := CInt((total + ROWS_PER_PAGE - 1) / ROWS_PER_PAGE);

	while(1)
		if(page < 1)
			page := 1;
		elseif(page > total_pages)
			page := total_pages;
		endif

		var start_idx := ((page - 1) * ROWS_PER_PAGE) + 1;
		var end_idx := start_idx + ROWS_PER_PAGE - 1;
		if(end_idx > total)
			end_idx := total;
		endif

		var gump := GFCreateGump(20, 20, 1160, 380);
		GFDisposable(gump, 0);
		GFMovable(gump, 1);
		GFResizePic(gump, 0, 0, GFGetCfgConst("Defaults", "BackGround"), 1160, 380);
		GFResizePic(gump, 15, 15, GFGetCfgConst("Defaults", "ForeGround"), 1130, 350);
		GFPage(gump, 1);

		GFTextLine(gump, 28, 28, 1153, "Town Treasury Status");
		GFTextLine(gump, 28, 48, 1153, "Page " + CStr(page) + " of " + CStr(total_pages));
		GFTextLine(gump, 28, 68, 1153, "Total town treasury gold: " + CStr(total_gold));
		GFTextLine(gump, 28, 88, 1153, "Town");
		GFTextLine(gump, 230, 88, 1153, "Treasury");
		GFTextLine(gump, 385, 88, 53, "Upgrades");
		GFTextLine(gump, 495, 88, 53, "Donations");
		GFTextLine(gump, 610, 88, 53, "Available");
		GFTextLine(gump, 715, 88, 53, "Purchased");
		GFTextLine(gump, 825, 88, 1153, "Price");
		GFTextLine(gump, 930, 88, 1153, "Population");
		GFTextLine(gump, 1020, 88, 1153, "Stone");
		GFTextLine(gump, 1090, 88, 38, "Delete");

		var row := 0;
		var i;
		for(i := start_idx; i <= end_idx; i := i + 1)
			var y := 112 + (row * 22);
			GFTextLine(gump, 28, y, 1153, CStr(regions[i]));
			GFTextLine(gump, 230, y, 1153, CStr(golds[i]) + " gold");

			GFAddButton(gump, 385, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_TOGGLE_UPGRADES_BASE + i);
			GFTextLine(gump, 420, y, upgrades_enabled[i] ? 63 : 38, upgrades_enabled[i] ? "On" : "Off");

			GFAddButton(gump, 495, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_TOGGLE_DONATIONS_BASE + i);
			GFTextLine(gump, 530, y, donations_enabled[i] ? 63 : 38, donations_enabled[i] ? "On" : "Off");

			GFAddButton(gump, 610, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_TOGGLE_AVAILABLE_BASE + i);
			GFTextLine(gump, 645, y, player_available[i] ? 63 : 38, player_available[i] ? "Yes" : "No");

			GFAddButton(gump, 715, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_TOGGLE_PURCHASED_BASE + i);
			GFTextLine(gump, 750, y, player_purchased[i] ? 63 : 38, player_purchased[i] ? "Yes" : "No");

			GFTextLine(gump, 825, y, 1153, player_purchase_prices[i] > 0 ? (CStr(player_purchase_prices[i]) + " gold") : "N/A");
			GFAddButton(gump, 930, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_POPULATION_BASE + i);
			GFTextLine(gump, 965, y, 1153, CStr(populations[i]));

			if(stones_exist[i])
				GFTextLine(gump, 1020, y, 63, "Yes");
			else
				GFTextLine(gump, 1020, y, 38, "No");
			endif

			if(has_region_data[i] and !stones_exist[i])
				GFAddButton(gump, 1090, y - 2, 2474, 2473, GF_CLOSE_BTN, BTN_DELETE_REGION_BASE + i);
				GFTextLine(gump, 1120, y, 38, "Del");
			else
				GFTextLine(gump, 1120, y, 1153, "-");
			endif
			row := row + 1;
		endfor

		if(page > 1)
			GFAddButton(gump, 28, 332, 2117, 2118, GF_CLOSE_BTN, BTN_PREV);
			GFTextLine(gump, 63, 334, 1153, "Previous");
		endif

		if(page < total_pages)
			GFAddButton(gump, 1070, 332, 2117, 2118, GF_CLOSE_BTN, BTN_NEXT);
			GFTextLine(gump, 1030, 334, 1153, "Next");
		endif

		GFAddButton(gump, 250, 332, 2152, 2151, GF_CLOSE_BTN, BTN_CLOSE);
		GFTextLine(gump, 285, 334, 1153, "Close");

		var res := GFSendGump(who, gump);
		if(!res[0] or res[0] == BTN_CLOSE)
			return;
		elseif(res[0] == BTN_PREV)
			page := page - 1;
			continue;
		elseif(res[0] == BTN_NEXT)
			page := page + 1;
			continue;
		elseif(res[0] > BTN_POPULATION_BASE and res[0] <= (BTN_POPULATION_BASE + total))
			var population_idx := res[0] - BTN_POPULATION_BASE;
			var pop_region := CStr(regions[population_idx]);
			ShowTownMemberManagerGump(who, pop_region, CInt(town_ids[population_idx]));

			// Refresh potentially changed row values after member management.
			var refreshed_town_id := GetTownIdByRegionName(pop_region);
			town_ids[population_idx] := refreshed_town_id;
			populations[population_idx] := GetTownPopulation(pop_region, refreshed_town_id);
			stones_exist[population_idx] := HasLiveTownstoneForRegion(pop_region, refreshed_town_id);
			has_region_data[population_idx] := HasTownBankRegionData(pop_region);
			continue;
		elseif(res[0] > BTN_TOGGLE_UPGRADES_BASE and res[0] <= (BTN_TOGGLE_UPGRADES_BASE + total))
			var upgrade_idx := res[0] - BTN_TOGGLE_UPGRADES_BASE;
			var new_upgrade_state := upgrades_enabled[upgrade_idx] ? 0 : 1;
			SetTownBankFeatureEnabled(CStr(regions[upgrade_idx]), "allow_upgrades", new_upgrade_state);
			upgrades_enabled[upgrade_idx] := new_upgrade_state;
			continue;
		elseif(res[0] > BTN_TOGGLE_DONATIONS_BASE and res[0] <= (BTN_TOGGLE_DONATIONS_BASE + total))
			var donation_idx := res[0] - BTN_TOGGLE_DONATIONS_BASE;
			var new_donation_state := donations_enabled[donation_idx] ? 0 : 1;
			SetTownBankFeatureEnabled(CStr(regions[donation_idx]), "allow_donations", new_donation_state);
			donations_enabled[donation_idx] := new_donation_state;
			continue;
		elseif(res[0] > BTN_TOGGLE_AVAILABLE_BASE and res[0] <= (BTN_TOGGLE_AVAILABLE_BASE + total))
			var available_idx := res[0] - BTN_TOGGLE_AVAILABLE_BASE;
			var available_region := CStr(regions[available_idx]);
			var new_available_state := player_available[available_idx] ? 0 : 1;
			if(SetRuntimePlayerTownAvailableState(available_region, new_available_state))
				player_available[available_idx] := new_available_state;
			else
				SendSysMessage(who, "Failed to update available state for " + available_region + ".");
			endif
			continue;
		elseif(res[0] > BTN_TOGGLE_PURCHASED_BASE and res[0] <= (BTN_TOGGLE_PURCHASED_BASE + total))
			var purchased_idx := res[0] - BTN_TOGGLE_PURCHASED_BASE;
			var region_name := CStr(regions[purchased_idx]);
			var new_purchased_state := player_purchased[purchased_idx] ? 0 : 1;
			if(SetRuntimePlayerTownPurchasedState(region_name, new_purchased_state))
				player_purchased[purchased_idx] := new_purchased_state;
			else
				SendSysMessage(who, "Failed to update purchased state for " + region_name + ".");
			endif
			continue;
		elseif(res[0] > BTN_DELETE_REGION_BASE and res[0] <= (BTN_DELETE_REGION_BASE + total))
			var delete_idx := res[0] - BTN_DELETE_REGION_BASE;
			var delete_region := CStr(regions[delete_idx]);

			if(stones_exist[delete_idx])
				SendSysMessage(who, "Cannot delete region data while a live townstone still exists for " + delete_region + ".");
				continue;
			endif

			if(!has_region_data[delete_idx])
				SendSysMessage(who, "No datafile entry exists for " + delete_region + ".");
				continue;
			endif

			if(!DeleteTownBankRegionData(delete_region))
				SendSysMessage(who, "Failed to delete datafile entry for " + delete_region + ".");
				continue;
			endif

			if(golds[delete_idx] > 0)
				total_gold := total_gold - CInt(golds[delete_idx]);
				if(total_gold < 0)
					total_gold := 0;
				endif
			endif

			regions.erase(delete_idx);
			golds.erase(delete_idx);
			stones_exist.erase(delete_idx);
			has_region_data.erase(delete_idx);
			upgrades_enabled.erase(delete_idx);
			donations_enabled.erase(delete_idx);
			player_purchase_prices.erase(delete_idx);
			player_purchased.erase(delete_idx);
			player_available.erase(delete_idx);
			town_ids.erase(delete_idx);
			populations.erase(delete_idx);

			total := regions.size();
			if(!total)
				SendSysMessage(who, "Deleted " + delete_region + " from townstone_data. No regions remain.");
				return;
			endif

			total_pages := CInt((total + ROWS_PER_PAGE - 1) / ROWS_PER_PAGE);
			if(page > total_pages)
				page := total_pages;
			endif

			SendSysMessage(who, "Deleted townbank data for " + delete_region + ".");
			continue;
		else
			return;
		endif
	endwhile
endfunction


function LoadPlayerTownsConfig()
	var cfg_map := dictionary;
	var cfg := ReadConfigFile(PLAYERTOWNS_CFG);
	if(!cfg)
		return cfg_map;
	endif

	var keys := GetConfigStringKeys(cfg);
	if(!keys or !keys.size())
		return cfg_map;
	endif

	var i;
	for(i := 1; i <= keys.size(); i := i + 1)
		var key := CStr(keys[i]);
		var elem := cfg[key];
		if(!elem)
			elem := FindConfigElem(cfg, key);
		endif
		if(!elem)
			continue;
		endif

		var region_name := Trim(CStr(GetConfigString(elem, "RegionName")));
		if(!region_name)
			region_name := Trim(CStr(key));
		endif
		if(!region_name)
			continue;
		endif

		var purchase_price := SafeNonNegativeInt(GetConfigInt(elem, "PurchasePrice"));
		var available := GetRuntimePlayerTownAvailableState(region_name, 1);

		cfg_map[Lower(region_name)] := { purchase_price, 0, available };
	endfor

	return cfg_map;
endfunction


function GetPlayerTownInfo(cfg_map, region_name)
	var info := { 0, 0, 1 };
	if(!cfg_map or !region_name)
		return info;
	endif

	var cfg_entry := cfg_map[Lower(CStr(region_name))];
	if(!cfg_entry)
		return info;
	endif

	info[1] := SafeNonNegativeInt(cfg_entry[1]);
	info[2] := GetRuntimePlayerTownPurchasedState(region_name, 0);
	info[3] := GetRuntimePlayerTownAvailableState(region_name, 1);

	return info;
endfunction


function GetRuntimePlayerTownPurchasedState(region_name, default_value)
	if(!region_name)
		return default_value;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return default_value;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return default_value;
	endif

	var raw := CStr(elem.GetProp("playertown_purchased"));
	UnloadDataFile(TOWNSTONE_DATAFILE);
	if(!raw)
		return default_value;
	endif

	return ParseEnabled(raw);
endfunction


function GetRuntimePlayerTownAvailableState(region_name, default_value)
	if(!region_name)
		return default_value;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return default_value;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return default_value;
	endif

	var raw := CStr(elem.GetProp("playertown_available"));
	UnloadDataFile(TOWNSTONE_DATAFILE);
	if(!raw)
		return default_value;
	endif

	return ParseEnabled(raw);
endfunction


function SetRuntimePlayerTownPurchasedState(region_name, purchased)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		elem := df.CreateElement(region_name);
	endif
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 0;
	endif

	elem.SetProp("playertown_purchased", purchased ? "1" : "0");
	UnloadDataFile(TOWNSTONE_DATAFILE);
	return 1;
endfunction


function SetRuntimePlayerTownAvailableState(region_name, available)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		elem := df.CreateElement(region_name);
	endif
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 0;
	endif

	elem.SetProp("playertown_available", available ? "1" : "0");
	UnloadDataFile(TOWNSTONE_DATAFILE);
	return 1;
endfunction


function SafeNonNegativeInt(raw_value)
	var value := CInt(raw_value);
	if(value < 0)
		value := 0;
	endif
	return value;
endfunction


function ParseEnabled(raw_value)
	var value := Lower(CStr(raw_value));
	if(value == "off" or value == "0" or value == "no" or value == "false")
		return 0;
	endif
	return 1;
endfunction


function DeleteTownBankRegionData(region_name)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 0;
	endif

	df.DeleteElement(region_name);
	UnloadDataFile(TOWNSTONE_DATAFILE);
	return 1;
endfunction


function IsTownBankFeatureEnabled(region_name, prop_name)
	if(!region_name)
		return 1;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 1;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 1;
	endif

	var flag_value := Lower(CStr(elem.GetProp(prop_name)));
	UnloadDataFile(TOWNSTONE_DATAFILE);

	if(flag_value == "off" or flag_value == "0")
		return 0;
	endif

	return 1;
endfunction


function SetTownBankFeatureEnabled(region_name, prop_name, enabled)
	if(!region_name)
		return;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		elem := df.CreateElement(region_name);
	endif
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return;
	endif

	elem.SetProp(prop_name, enabled ? "on" : "off");
	UnloadDataFile(TOWNSTONE_DATAFILE);
endfunction


function OpenTownstoneDataFile()
	var df := OpenDataFile(TOWNSTONE_DATAFILE);
	if(!df)
		CreateDataFile(TOWNSTONE_DATAFILE, flags := DF_KEYTYPE_STRING);
		df := OpenDataFile(TOWNSTONE_DATAFILE);
	endif
	return df;
endfunction


function GetTownBankGold(region_name)
	if(!region_name)
		return 0;
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(!elem)
		UnloadDataFile(TOWNSTONE_DATAFILE);
		return 0;
	endif

	var gold := CInt(elem.GetProp("gold"));
	UnloadDataFile(TOWNSTONE_DATAFILE);
	if(gold < 0)
		gold := 0;
	endif
	return gold;
endfunction


function GetTownRegionsFromDatafile()
	var df := OpenTownstoneDataFile();
	if(!df)
		return {};
	endif

	var keys := df.Keys();
	var region_list := {};
	if(keys)
		var key_idx;
		for(key_idx := 1; key_idx <= keys.size(); key_idx := key_idx + 1)
			var key_text := Trim(CStr(keys[key_idx]));
			if(Len(key_text) >= 1)
				region_list.append(key_text);
			endif
		endfor
	endif
	UnloadDataFile(TOWNSTONE_DATAFILE);

	return region_list;
endfunction


function GetTownRegionsFromLiveStones()
	var regions := {};
	var seen := dictionary;

	var stones := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, "britannia");
	if(!stones or !stones.size())
		return regions;
	endif

	foreach stone in stones
		if(!stone or stone.objtype != TOWNSTONE_OBJTYPE)
			continue;
		endif

		var region_name := CStr(GetObjProperty(stone, "regionname"));
		if(!region_name)
			continue;
		endif

		if(seen[region_name])
			continue;
		endif

		seen[region_name] := 1;
		regions.append(region_name);
	endforeach

	return regions;
endfunction


function HasLiveTownstoneForRegion(region_name, town_id)
	if(!region_name)
		return 0;
	endif

	var region_range := {};
	var lost_lands_range := {};
	var use_lost_lands_fallback := 0;

	UnloadConfigFile("regions");
	var regions_cfg := ReadConfigFile("::regions/regions");
	if(regions_cfg)
		region_range := GetRegionRange(regions_cfg, region_name);
		lost_lands_range := GetRegionRange(regions_cfg, "The Lost Lands");
		if(region_range.size() >= 4 and lost_lands_range.size() >= 4 and IsRangeInsideRange(region_range, lost_lands_range))
			use_lost_lands_fallback := 1;
		endif
	endif

	var df := OpenTownstoneDataFile();
	if(!df)
		return 0;
	endif

	var elem := df.FindElement(region_name);
	if(elem)
		var direct_serial := CInt(elem.GetProp("stone_serial"));
		if(direct_serial)
			var direct_stone := SystemFindObjectBySerial(direct_serial);
			if(IsTownstoneMatch(direct_stone, region_name, town_id, region_range, lost_lands_range, use_lost_lands_fallback))
				UnloadDataFile(TOWNSTONE_DATAFILE);
				return 1;
			endif
		endif
	endif

	var town_list := GetGlobalProperty("townlist");
	if(town_list and town_list.size())
		var i;
		for(i := 1; i <= town_list.size(); i := i + 1)
			var known_region := CStr(town_list[i]);
			if(!known_region)
				continue;
			endif

			var known_elem := df.FindElement(known_region);
			if(!known_elem)
				continue;
			endif

			var stone_serial := CInt(known_elem.GetProp("stone_serial"));
			if(!stone_serial)
				continue;
			endif

			// Lost Lands fallback is deliberately disabled here: this stone was
			// fetched via a DIFFERENT region's recorded stone_serial, so treating
			// "somewhere in Lost Lands" as a match would let any Lost-Lands town's
			// stone falsely satisfy a lookup for this one. Only town_id/regionname/
			// own-range identity checks are trustworthy for stones found this way.
			var stone := SystemFindObjectBySerial(stone_serial);
			if(IsTownstoneMatch(stone, region_name, town_id, region_range, lost_lands_range, 0))
				UnloadDataFile(TOWNSTONE_DATAFILE);
				return 1;
			endif
		endfor
	endif

	UnloadDataFile(TOWNSTONE_DATAFILE);
	return 0;
endfunction


function IsTownstoneMatch(stone, region_name, town_id, region_range, lost_lands_range, use_lost_lands_fallback)
	if(!stone or stone.objtype != 0xa320)
		return 0;
	endif

	if(town_id and CInt(GetObjProperty(stone, "town")) == CInt(town_id))
		return 1;
	endif

	var stone_region := CStr(GetObjProperty(stone, "regionname"));
	if(stone_region and CStr(stone_region) == CStr(region_name))
		return 1;
	endif

	if(region_range.size() >= 4 and IsPointInRange(stone.x, stone.y, region_range))
		return 1;
	endif

	if(use_lost_lands_fallback and lost_lands_range.size() >= 4 and IsPointInRange(stone.x, stone.y, lost_lands_range))
		return 1;
	endif

	return 0;
endfunction


function GetRegionRange(regions_cfg, region_name)
	if(!regions_cfg or !region_name)
		return {};
	endif

	var elem := regions_cfg[region_name];
	if(!elem)
		elem := FindConfigElem(regions_cfg, region_name);
	endif
	if(!elem)
		return {};
	endif

	var coords := GetConfigStringArray(elem, "Range");
	if(!coords or coords.size() < 4)
		return {};
	endif

	return { CInt(coords[1]), CInt(coords[2]), CInt(coords[3]), CInt(coords[4]) };
endfunction


function IsPointInRange(x, y, range)
	if(!range or range.size() < 4)
		return 0;
	endif

	return (x >= range[1] and x <= range[3] and y >= range[2] and y <= range[4]);
endfunction


function IsRangeInsideRange(inner_range, outer_range)
	if(!inner_range or inner_range.size() < 4 or !outer_range or outer_range.size() < 4)
		return 0;
	endif

	return (inner_range[1] >= outer_range[1] and
			inner_range[2] >= outer_range[2] and
			inner_range[3] <= outer_range[3] and
			inner_range[4] <= outer_range[4]);
endfunction
