use uo;
use os;


include "include/spelldata";
include "include/dotempmods";
include "include/client";

const SPELL_EFFECT_TYPE_MOVING 	:= MOVING_SPELL_SANCTUARY;
const SPELL_EFFECT_ID		:= FX_SPELL_SANCTUARY;
const SPELL_EFFECT_SPEED	:= SPEED_SPELL_SANCTUARY;
const SPELL_EFFECT_LOOP		:= LOOP_SPELL_SANCTUARY;

program cast_antidote( parms )

	var circle := GetCircle( SPELLID_SANCTUARY );
	var caster;
	var cast_on;
	var fromhit;


	if (parms[1] == "#MOB")
		caster := parms[2];
		cast_on := parms[3];
		if (parms[4])
			circle := parms[4];
		endif
		if (parms[5])
			fromhit := parms[5];
		endif

	else
		caster := parms;
		if( TryToCast( caster, SPELLID_SANCTUARY ) != SUCCESS )
			EraseObjProperty( caster , "#Casting" );
			return;
		endif
	endif


	if( !fromhit )
		EraseObjProperty( caster , "#Casting" );
		caster := Reflected( caster , caster , circle );
	else
		PlayObjectCenteredEffect(caster, SPELL_EFFECT_ID, SPELL_EFFECT_SPEED, SPELL_EFFECT_LOOP);
	endif

        PlaySoundEffect(caster, SFX_SPELL_SANCTUARY);

        if( caster.poisoned )
		CurePoison( caster );
		SendSysmessage( caster , "You cured your patient." );
	endif

	EraseObjProperty( caster , "#Casting" );
	var magery := GetAttribute( caster , ATTRIBUTEID_MAGERY );
	var duration := ModifyWithMagicEfficiency( caster , magery * 2 );
	var power := 0;
	if (GetObjProperty(caster, "IsMage"))
		power := GetObjProperty(caster, "IsMage");
	elseif (GetObjProperty(caster, "IsPaladin"))
		power := GetObjProperty(caster, "IsPaladin");
	endif
	if (!power)
		power := 0;
	endif;
	power := power + 1;

	// Skip if equipment or a stronger cast already gives as much; an equal one is refreshed.
	if( duration and power and power >= GetPoisonImmunityLevel( caster ) )
		SetSpellProt( caster , SPELLPROT_POISON , power );
		BuffOn( caster , "poisonimmunity" , power , duration );
		SendSysmessage( caster , "You are now protected from poisonous effects." );
		Detach();
		Sleep( duration );
		if( EndSpellProt( caster , SPELLPROT_POISON ) )
			BuffOff( caster , "poisonimmunity" );
		endif
	endif
endprogram
