// Synopsis: Reset a targeted player's personal powerhour tracking properties
use os;
use uo;

include ":powerhour:include/powerhour";
include "include/client";

program resetph(who)

	var mobile := Target(who);

	if(!mobile)
		SendSysMessage(who, "Canceled", FONT_NORMAL, 43);
		return 0;
	endif

	if(mobile.isa(POLCLASS_NPC))
		SendSysMessage(who, "You cannot reset Powerhour on NPCs.", FONT_NORMAL, 43);
		return 0;
	endif

	var active := PPH_ActiveType(mobile);

	PPH_Clear(mobile);

	SendSysMessage(who, "Reset " + mobile.name + "'s personal powerhour properties.", FONT_NORMAL, PH_MSG_COLOR_GOOD);
	if(active)
		SendSysMessage(who, "Their active " + PH_TypeName(active) + " powerhour was ended by the reset.", FONT_NORMAL, PH_MSG_COLOR_BAD);
	endif

endprogram
