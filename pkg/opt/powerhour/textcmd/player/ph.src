// Synopsis: Display your current power hour status and remaining time
use uo;

include ":powerhour:include/powerhour";

program checkPH(who)

	var time_now := POLCore().systime;

	var personal := PPH_ActiveType(who);
	if(personal)
		SendSysMessage(who, "Your personal " + PH_TypeName(personal) + " powerhour is currently active!");
		SendSysMessage(who, "Remaining minutes left: " + CInt(PPH_SecondsRemaining(who, time_now) / PH_MINUTE));
	else
		SendSysMessage(who, "You have no personal powerhour active.");
		if(PPH_IsEligible(who, time_now))
			SendSysMessage(who, "You can start a new personal powerhour right now with .setph!");
		else
			SendSysMessage(who, "You can start a new personal powerhour in " + PH_FormatDuration(PPH_SecondsUntilEligible(who, time_now)) + ".");
		endif
	endif

	var active := PH_ActiveType();
	if(active)
		SendSysMessage(who, "A server-wide " + PH_TypeName(active) + " powerhour is currently active!");
		SendSysMessage(who, "It ends in " + PH_FormatDuration(PH_SecondsRemaining(time_now)) + ".");
	elseif(PH_PendingType())
		SendSysMessage(who, "A server-wide " + PH_TypeName(PH_PendingType()) + " powerhour is about to start!");
	else
		SendSysMessage(who, "No server-wide powerhour is currently active.");
	endif

	SendSysMessage(who, "The next chance at a server-wide powerhour is in " + PH_FormatDuration(PH_SecondsUntilScheduled(time_now), 1) + "!");

endprogram
