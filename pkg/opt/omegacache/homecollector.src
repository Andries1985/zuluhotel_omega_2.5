	  foreach itemObjtype in ( potionObjtypes )
		var amount := Cint( GFExtractData( result, itemObjtype ) );
		var itemName := itemcfg[itemObjtype].Name; // you probably want description (Desc) and not name :)

		// if (charpack.weight > 45001)
		// SendSysMessage(who,"Your backpack weighs too much. Free contents up to 45000 weight.");
		// return;
		// endif
		if ( ( amount > 0 ) and ( amount <= 60000 ) )

		  // I have this I can create
		  var propName := potionPropertyNames[itemObjtype];
		  var currentAmount := CInt( GetObjProperty( item, propName ) );

		  if ( currentAmount > 0 and amount <= currentAmount )

			if ( itemObjtype == 0xdc01 )

			  var lhealpot := CreateItemAtLocation( 5128, 1772, 0, 0xdc01, amount, realm := _DEFAULT_REALM );
			  MoveItemToContainer( lhealpot, who.backpack, 10, 10, 0 );
			  if ( lhealpot )
				if ( currentAmount == amount )
				  EraseObjProperty( item, propName );
				else
				  SetObjProperty( item, propName, CInt( GetObjProperty( item, propName ) - amount ) );
				endif
				lhealpot.name := "Light Heal Potion";
				if ( GetObjProperty( item, "ByTrueMageLHeal" ) )
				  SetObjProperty( lhealpot, "ByTrueMage", GetObjProperty( item, "ByTrueMageLHeal" ) );
				endif
				SendSysMessage( who, "You have received the item " + lhealpot.name + " in quantity "
								+ amount + "." );
			  else
				PrintTextAbovePrivate( who, "Couldn't create that: " + lhealpot.errortext, who );
