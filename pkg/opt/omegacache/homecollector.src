				   + GetObjProperty( item, propName ) + "." );
		  endif
		endif
	  endforeach

	916:

	  if ( coordist( item.x, item.y, who.x, who.y ) > 6 )
		SendSysMessage( who, "The box is too far away" );
		return;
	  endif

	  var rune6Objtypes := array{ 0xd096, 0xd07d, 0xd095, 0xd071, 0xd094, 0xd087,
								  0xd085, 0xd08b, 0xd09b, 0xd081 };

	  var rune6PropertyNames := dictionary{ 0xd096 -> "fencingEnchantedRune72",
									  	  0xd07d -> "healingEnchantedRune47",
									  	  0xd095 -> "maceEnchantedRune71",
									  	  0xd071 -> "parryingEnchantedRune35",
									  	  0xd094 -> "swordEnchantedRune70",
									  	  0xd087 -> "tacticsEnchantedRune57",
									  	  0xd09b -> "stealthEnchantedRune77",
									  	  0xd081 -> "hidingEnchantedRune51",
									  	  0xd085 -> "mageryEnchantedRune55",
									  	  0xd08b -> "archeryEnchantedRune61" };

	  foreach itemObjtype in ( rune6Objtypes )
		var amount := Cint( GFExtractData( result, itemObjtype ) );
		var itemName := itemcfg[itemObjtype].Name; // you probably want description (Desc) and not name :)
		////if (charpack.weight > 45001)
		// SendSysMessage(who,"Your backpack weighs too much. Free contents up to 45000 weight.");
		// return;
		// endif
		if ( ( amount > 0 ) and ( amount <= 60000 ) )

		  // I have this I can create
		  var propName := rune6PropertyNames[itemObjtype];
		  var currentAmount := CInt( GetObjProperty( item, propName ) );

		  if ( currentAmount > 0 and amount <= currentAmount )
			var newitem := CreateItemInBackpack( who, itemObjtype, amount );
			if ( newitem )
			  if ( currentAmount == amount )
				EraseObjProperty( item, propName );
			  else
				SetObjProperty( item, propName, CInt( GetObjProperty( item, propName ) - amount ) );
			  endif
			  SendSysMessage( who, "You have received the item " + itemName + " in quantity " + amount + "." );
			else
			  PrintTextAbovePrivate( who, "Couldn't create that: " + newitem.errortext, who );
			endif
		  else
			SendSysMessage( who, "Invalid number to get the item " + itemName + "remaining quantity "
				   + GetObjProperty( item, propName ) + "." );
		  endif
		endif
	  endforeach

	917:
	  if ( coordist( item.x, item.y, who.x, who.y ) > 6 )
		SendSysMessage( who, "The box is too far away" );
		return;
	  endif

	  var rune7Objtypes := array{ 0xd06e, 0xd08f, 0xd08b, 0xd078, 0xd07e, 0xd092, 0xd093, 0xd079 };

	  var rune7PropertyNames := dictionary{ 0xd06e -> "loreEnchantedRune32",
									  	  0xd08f -> "tamingEnchantedRune65",
									  	  0xd08b -> "archeryEnchantedRune61",
									  	  0xd078 -> "cartEnchantedRune42",
									  	  0xd07e -> "fishingEnchantedRune48",
									  	  0xd092 -> "trackEnchantedRune68",
									  	  0xd093 -> "veterEnchantedRune69",
									  	  0xd079 -> "cookingEnchantedRune43" };

	  foreach itemObjtype in ( rune7Objtypes )
		var amount := Cint( GFExtractData( result, itemObjtype ) );
		var itemName := itemcfg[itemObjtype].Name; // you probably want description (Desc) and not name :)
		// if (charpack.weight > 45001)
		// SendSysMessage(who,"Your backpack weighs too much. Free contents up to 45000 weight.");
		// return;
		// endif
		if ( ( amount > 0 ) and ( amount <= 60000 ) )

		  // I have this I can create
		  var propName := rune7PropertyNames[itemObjtype];
		  var currentAmount := CInt( GetObjProperty( item, propName ) );

		  if ( currentAmount > 0 and amount <= currentAmount )
			var newitem := CreateItemInBackpack( who, itemObjtype, amount );
			if ( newitem )
			  if ( currentAmount == amount )
				EraseObjProperty( item, propName );
			  else
				SetObjProperty( item, propName, CInt( GetObjProperty( item, propName ) - amount ) );
			  endif
			  SendSysMessage( who, "You have received the item " + itemName + " in quantity " + amount + "." );
			else
			  PrintTextAbovePrivate( who, "Couldn't create that: " + newitem.errortext, who );
			endif
		  else
			SendSysMessage( who, "Invalid number to get the item " + itemName + "remaining quantity "
				   + GetObjProperty( item, propName ) + "." );
		  endif
		endif
	  endforeach

	999:

	  if ( coordist( item.x, item.y, who.x, who.y ) > 6 )
		SendSysMessage( who, "The box is too far away" );
		return;
	  endif

	  var updtObjtypes := array{ 0xd05c, 0xd05d, 0xd05e, 0xd05f, 0xd060, 0xd061, 0xd062, 0xd063,
						   	  0xd064, 0xd065, 0xd066, 0xd067, 0xd068, 0xd069, 0xd06a, 0xd076,
						   	  0xd07f, 0xd09c, 0xd090, 0xf022, 0xf025, 0xf028, 0xf029 };

	  var updtPropertyNames := dictionary{ 0xd05c -> "AirEnchantedRune",
									 	  0xd05d -> "EarthEnchantedRune2",
									 	  0xd05e -> "FireEnchantedRune3",
									 	  0xd05f -> "NecroEnchantedRune4",
									 	  0xd060 -> "WaterEnchantedRune5",
									 	  0xd061 -> "HolyEnchantedRune6",
									 	  0xd062 -> "PoisonEnchantedRune7",
									 	  0xd063 -> "DefenseEnchantedRune8",
									 	  0xd064 -> "ColdEnchantedRune9",
									 	  0xd065 -> "LightEnchantedRune10",
									 	  0xd066 -> "DarkEnchantedRune11",
									 	  0xd067 -> "HealingEnchantedRune12",
									 	  0xd068 -> "speedEnchantedRune20",
									 	  0xd069 -> "mindEnchantedRune21",
									 	  0xd06a -> "staminaEnchantedRune22",
									 	  0xd076 -> "campingEnchantedRune40",
									 	  0xd07f -> "forensicEnchantedRune49",
									 	  0xd09c -> "removetrapEnchantedRune78",
									 	  0xd090 -> "tasteidEnchantedRune66",
									 	  0xf022 -> "castspeedupgrade",
									 	  0xf025 -> "hitupgrade",
									 	  0xf028 -> "damagebonus",
									 	  0xf029 -> "armorupgrade" };

	  foreach itemObjtype in ( updtObjtypes )
		var amount := Cint( GFExtractData( result, itemObjtype ) );
		var itemName := itemcfg[itemObjtype].Name; // you probably want description (Desc) and not name :)
		// if (charpack.weight > 45001)
		// SendSysMessage(who,"Your backpack weighs too much. Free contents up to 45000 weight.");
		// return;
		// endif
		if ( ( amount > 0 ) and ( amount <= 60000 ) )

		  // I have this I can create
		  var propName := updtPropertyNames[itemObjtype];
		  var currentAmount := CInt( GetObjProperty( item, propName ) );

		  if ( currentAmount > 0 and amount <= currentAmount )
			var newitem := CreateItemInBackpack( who, itemObjtype, amount );
			if ( newitem )
			  if ( currentAmount == amount )
				EraseObjProperty( item, propName );
			  else
				SetObjProperty( item, propName, CInt( GetObjProperty( item, propName ) - amount ) );
			  endif
			  SendSysMessage( who, "You have received the item " + itemName + " in quantity " + amount + "." );
			else
			  PrintTextAbovePrivate( who, "Couldn't create that: " + newitem.errortext, who );
			endif
		  else
			SendSysMessage( who, "Invalid number to get the item " + itemName + "remaining quantity "
				   + GetObjProperty( item, propName ) + "." );
		  endif
		endif
	  endforeach
	default:
  // return pressed_buttons_id;
  endcase

endprogram
