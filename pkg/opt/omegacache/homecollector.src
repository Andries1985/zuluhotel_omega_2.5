program choozeprize( who, item )

  if ( who.multi )
	var house := who.multi;
	if ( FindHouseSign( house ) )
	  if ( not IsAFriend( FindHouseSign( house ), who ) )
		SendSysMessage( who, "You can't use item from a non friendly house." );
		return;
	  endif
	endif
  else
	SendSysMessage( who, "You can't use item from outside." );
	return;
  endif

