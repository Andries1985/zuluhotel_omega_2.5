// omegacache.src — Omega Cache main use-script
//
// Triggered when a player double-clicks a placed Omega Cache Container.
// Provides gump UI for browsing, depositing, and withdrawing items.

use uo;
use os;
use math;
use cfgfile;

include ":omegacache:omegacache";
include ":gumps:gumps";
include ":gumps:gumps_ex";

// ============================================================
// Constants
// ============================================================

// VIEW_SECURE, ADD_TO_SECURE, REMOVE_FROM_SECURE from :housing:utility (via omegacache.inc)

const TEXT_HUE := 242;
const TEXT_HUE_HIGHLIGHT := 53;
const TEXT_HUE_QTY := 55;

// Button IDs — start at 10 to avoid conflict with right-click close (0)
const BTN_DEPOSIT_ITEM := 10;
const BTN_DEPOSIT_ALL := 11;
const BTN_BACK := 12;
const BTN_CATEGORY_BASE := 100;    // 100 + category_index
const BTN_TAKE_BASE := 1000;       // 1000 + item_index

// ============================================================
// Entry Point
// ============================================================

program use_omegacache(who, item)

	_debug_who := who;

	// Access check — VIEW_SECURE to open
	var access := FindAccessibleContainer(who, array{VIEW_SECURE});
	if(!access)
		SendSysMessage(who, "You cannot access this.");
		return;
	endif

	var df := access.df;
	if(!df)
		SendSysMessage(who, "Failed to open storage.");
		return;
	endif

	detach();

	// Main gump loop
	var view := "categories";
	var category_map := dictionary;
	var current_keys := array{};
	var cat_lookup := LoadCategoryLookup();

	while(1)
		// Rebuild category map each iteration (data may have changed)
		category_map := BuildCategoryMap(df);

		var result;
		if(view == "categories")
			result := ShowCategoryMenu(who, category_map, cat_lookup.cat_icons);
		else
			result := ShowItemList(who, df, view, category_map, current_keys);
		endif

		if(!result)
			break;  // Gump error
		endif

		var btn := CInt(result[0]);
		if(btn < 1)
			break;  // Gump closed (right-click or no button)
		endif

		// Handle button press
		if(btn == BTN_DEPOSIT_ITEM)
			if(FindAccessibleContainer(who, array{ADD_TO_SECURE}))
				DoDepositTargeting(who, df);
			else
				SendSysMessage(who, "You don't have permission to deposit items.");
			endif

		elseif(btn == BTN_DEPOSIT_ALL)
			if(FindAccessibleContainer(who, array{ADD_TO_SECURE}))
				DoDepositAll(who, df);
			else
				SendSysMessage(who, "You don't have permission to deposit items.");
			endif

		elseif(btn == BTN_BACK)
			view := "categories";

		elseif(btn >= BTN_CATEGORY_BASE and btn < BTN_TAKE_BASE)
			var cat_index := btn - BTN_CATEGORY_BASE;
			var cat_names := category_map.keys();
			if(cat_index >= 1 and cat_index <= cat_names.size())
				view := cat_names[cat_index];
			endif

		elseif(btn >= BTN_TAKE_BASE)
			if(!FindAccessibleContainer(who, array{REMOVE_FROM_SECURE}))
				SendSysMessage(who, "You don't have permission to withdraw items.");
			else
				var item_index := btn - BTN_TAKE_BASE;
				if(item_index >= 1 and item_index <= current_keys.size())
					var key := current_keys[item_index];
					var amount_str := GFExtractData(result, btn);
					var amount := ParseDecimal(amount_str);
					if(amount > 0)
						var dest := PromptDestination(who);
						DoWithdraw(who, df, key, amount, dest);
					else
						SendSysMessage(who, "Enter an amount to withdraw.");
					endif
				endif
			endif
		endif

		sleepms(200);
	endwhile

endprogram

// ============================================================
// Category Map Builder
// ============================================================

function BuildCategoryMap(df)
	var keys := df.Keys();
	var cat_map := dictionary;

	var lookup := LoadCategoryLookup();
	var cat_names := lookup.cat_names;
	var objtype_to_cat := lookup.objtype_to_cat;

	// Initialize empty arrays for all categories
	foreach cat_name in cat_names
		cat_map[cat_name] := array{};
	endforeach

	// Classify each stored key
	foreach key in keys
		var objtype_int := CInt(GetObjtypeFromKey(key));
		var cat_name := objtype_to_cat[objtype_int];
		if(!cat_name)
			cat_name := "Other";
			if(!cat_map["Other"])
				cat_map["Other"] := array{};
			endif
		endif
		cat_map[cat_name].append(key);
	endforeach

	return cat_map;
endfunction

// ============================================================
// Gump: Category Menu
// ============================================================

function ShowCategoryMenu(who, category_map, cat_icons)
	var gump := GFCreateGump(25, 25);

	GFResizePic(gump, 0, 0, 9200, 450, 500);
	GFResizePic(gump, 10, 10, 3000, 430, 480);

	GFTextLine(gump, 140, 15, TEXT_HUE_HIGHLIGHT, "Omega Cache");

	var cat_names := category_map.keys();
	var cat_index := 0;
	var display_row := 0;

	foreach cat_name in cat_names
		cat_index := cat_index + 1;
		var items := category_map[cat_name];
		var count := items.size();

		if(count <= 0)
			continue;
		endif

		display_row := display_row + 1;

		var col_x;
		var row_y;
		if(display_row <= 11)
			col_x := 30;
			row_y := 50 + ((display_row - 1) * 28);
		else
			col_x := 240;
			row_y := 50 + ((display_row - 12) * 28);
		endif

		var icon := cat_icons[cat_name];
		if(icon)
			GFTilePic(gump, col_x, row_y - 3, icon);
		endif

		var btn_id := BTN_CATEGORY_BASE + cat_index;
		var label := cat_name + " (" + count + ")";
		GFAddButton(gump, col_x + 25, row_y, 4005, 4007, GF_CLOSE_BTN, btn_id);
		GFTextLine(gump, col_x + 60, row_y, TEXT_HUE, label);
	endforeach

	// Deposit buttons at bottom
	GFAddButton(gump, 30, 455, 4005, 4007, GF_CLOSE_BTN, BTN_DEPOSIT_ITEM);
	GFTextLine(gump, 65, 455, TEXT_HUE_HIGHLIGHT, "Deposit Item");

	GFAddButton(gump, 240, 455, 4005, 4007, GF_CLOSE_BTN, BTN_DEPOSIT_ALL);
	GFTextLine(gump, 275, 455, TEXT_HUE_HIGHLIGHT, "Deposit All");

	return GFSendGump(who, gump);
endfunction

// ============================================================
// Gump: Item List (per category)
// ============================================================

function ShowItemList(who, df, category_name, category_map, byref out_keys)
	var keys := category_map[category_name];
	if(!keys)
		keys := array{};
	endif

	var gump := GFCreateGump(25, 25);

	// Page 0 — always visible (background, title, bottom buttons)
	GFPage(gump, 0);
	GFResizePic(gump, 0, 0, 9200, 500, 500);
	GFResizePic(gump, 10, 10, 3000, 480, 480);

	GFTextLine(gump, 130, 15, TEXT_HUE_HIGHLIGHT, "Omega Cache - " + category_name);

	// Back and Deposit buttons on page 0 (visible on all pages)
	GFAddButton(gump, 30, 460, 4014, 4016, GF_CLOSE_BTN, BTN_BACK);
	GFTextLine(gump, 65, 460, TEXT_HUE, "Back");

	GFAddButton(gump, 350, 460, 4005, 4007, GF_CLOSE_BTN, BTN_DEPOSIT_ITEM);
	GFTextLine(gump, 385, 460, TEXT_HUE_HIGHLIGHT, "Deposit");

	// Filter to only keys with qty > 0 and build display list
	var display_keys := array{};
	foreach key in keys
		var elem := df.FindElement(key);
		if(elem)
			var qty := CInt(elem.GetProp("qty"));
			if(qty > 0)
				display_keys.append(key);
			endif
		endif
	endforeach
	out_keys := display_keys;

	// Pagination constants
	var items_per_page := 14;
	var total_items := display_keys.size();
	var total_pages := 1;
	if(total_items > items_per_page)
		total_pages := CInt(Ceil(CDbl(total_items) / CDbl(items_per_page)));
	endif

	var page_num := 0;
	var item_index := 0;

	foreach key in display_keys
		item_index := item_index + 1;

		// Start a new gump page when needed
		var page_item := ((item_index - 1) % items_per_page) + 1;
		if(page_item == 1)
			page_num := page_num + 1;
			GFPage(gump, page_num);

			// Column headers on each page
			GFTextLine(gump, 55, 42, TEXT_HUE, "Item");
			GFTextLine(gump, 280, 42, TEXT_HUE, "Stored");
			GFTextLine(gump, 345, 42, TEXT_HUE, "Amt");
			GFTextLine(gump, 415, 42, TEXT_HUE, "Take");

			// Page nav buttons and indicator
			if(page_num > 1)
				GFAddButton(gump, 150, 435, 4014, 4016, GF_PAGE_BTN, page_num - 1);
				GFTextLine(gump, 170, 435, TEXT_HUE, "Prev");
			endif
			GFTextLine(gump, 220, 435, TEXT_HUE, "Page " + page_num + "/" + total_pages);
			if(page_num < total_pages)
				GFAddButton(gump, 310, 435, 4005, 4007, GF_PAGE_BTN, page_num + 1);
				GFTextLine(gump, 330, 435, TEXT_HUE, "Next");
			endif
		endif

		var row_y := 65 + ((page_item - 1) * 25);

		var elem := df.FindElement(key);
		var qty := CInt(elem.GetProp("qty"));
		var objtype := CInt(elem.GetProp("objtype"));
		var desc_info := GetItemDescriptor(objtype);

		// Item name
		var item_name := GetItemDisplayName(objtype);

		// Variant display — show first CProp if non-default
		var propnames := elem.PropNames();
		foreach pname in propnames
			if(pname[1,6] == "cprop_")
				var cprop_name := pname[7, len(pname)];
				var cprop_val := elem.GetProp(pname);
				item_name := item_name + " [" + cprop_name + "=" + CStr(cprop_val) + "]";
				break;
			endif
		endforeach

		// Tile icon
		var graphic := objtype;
		if(desc_info and desc_info.Graphic)
			graphic := CInt(desc_info.Graphic);
		endif
		var color := 0;
		if(elem.GetProp("color"))
			color := CInt(elem.GetProp("color"));
		elseif(desc_info and desc_info.Color)
			color := CInt(desc_info.Color);
		endif
		GFTilePic(gump, 20, row_y - 5, graphic, color);

		// Item name
		GFTextCrop(gump, 55, row_y, 220, 20, TEXT_HUE, item_name);

		// Quantity
		GFTextLine(gump, 280, row_y, TEXT_HUE_QTY, FormatNumber(qty));

		// Text entry for withdraw amount — use item_index as ID
		var btn_id := BTN_TAKE_BASE + item_index;
		GFTextEntry(gump, 340, row_y, 60, 20, TEXT_HUE, "", btn_id);

		// Take button
		GFAddButton(gump, 420, row_y, 4005, 4007, GF_CLOSE_BTN, btn_id);
	endforeach

	if(total_items == 0)
		GFPage(gump, 1);
		GFTextLine(gump, 160, 200, TEXT_HUE, "No items in this category.");
	endif

	return GFSendGump(who, gump);
endfunction

// Deposit and withdraw functions are in omegacache.inc (shared with cache.src command)
