// Synopsis: Restart a targeted spawnpoint using current settings and immediately spawn to max
use uo;
use os;

include "include/constants";
include "include/client";
include "include/constants/objtypes";
include ":spawnpoint:restartspawnpoint";

program restartspawnpointmax(who, input)
	var spawnpoint;
	if(!input)
		SendSysMessage(who, "Select Spawnpoint");
		spawnpoint := TargetCoordinates(who).item;
	else
		spawnpoint := SystemFindObjectBySerial(CInt(input));
		if(!spawnpoint || spawnpoint.objtype != UOBJ_SPAWNPOINT)
			SendSysMessage(who, "That's not a Spawnpoint. Usage: .restartspawnpointmax [serial]", FONT_NORMAL, 2595);
			return 0;
		endif
	endif

	if(!spawnpoint || spawnpoint.objtype != UOBJ_SPAWNPOINT)
		SendSysMessage(who, "No valid spawnpoint selected.", FONT_NORMAL, 2595);
		return 0;
	endif

	RestartSpawnPointWithMode(spawnpoint, 1);
	PrintTextAbovePrivate(spawnpoint, "*restarted max*", who, FONT_NORMAL, 2595);

	var current_count := GetSpawnedCount(spawnpoint);
	var pt_data := EnsureSpawnPointSettings(spawnpoint);
	SendSysMessage(who, "Spawnpoint restarted and force-filled to " + current_count + "/" + CInt(pt_data[3]) + ".", FONT_NORMAL, 2595);
	return 1;

endprogram
