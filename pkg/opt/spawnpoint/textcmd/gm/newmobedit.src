// GFExtractData errors on a blank text entry (the reply is only "<id>: "), so treat that as ""
function GetGumpText(reply, id)

	var text := GFExtractData(reply, id);
	if (text == error)
		return "";
	endif

	return text;

endfunction

// Level buttons come in rows of 7: 1-6 give 75/90/105/120/135/150, the 7th clears to 0
function GetLevelSkill(button)

	var level := CInt(button) % 7;
	if (!level)
		return 0;
	endif

	return 60 + (15 * level);

endfunction

// Asks for a Custom Hits Level and stages it; ApplyStagedNpcEdits writes it when Apply is pressed
function SetCustomHitsLevel(who, unused mobile)

	var entered := RequestGump(who, "Enter the Custom Hits Level (1 - "+MAX_CUSTOM_HITS+")", "0 removes it and the npc goes back to its template HP.", custom_hits, CANCEL_BTN_ON);
	if (entered == error || !entered)
		SendSysMessage(who, "Custom Hits Level unchanged.", FONT_NORMAL, 43);
		return 0;
	endif

	var level := CInt(entered);
	if ((!level && entered != "0") || level < 0 || level > MAX_CUSTOM_HITS)
		SendSysMessage(who, "Enter a number from 0 to "+MAX_CUSTOM_HITS+".", FONT_NORMAL, 43);
		return 0;
	endif

	custom_hits := level;
	hits_changed := (level != orig_custom_hits);
	if (level)
		SendSysMessage(who, "Custom Hits Level "+level+" is set when you press Apply.");
	else
		SendSysMessage(who, "Custom Hits Level is removed when you press Apply.");
	endif

	return 1;

endfunction

// Writes what the Custom Hits and Spells buttons staged
function ApplyStagedNpcEdits(who, mobile)

	if (hits_changed)
		// CustomHitsLevel is stored x100 (vitals are in hundredths)
		if (custom_hits)
			SetObjProperty(mobile, "CustomHitsLevel", custom_hits * 100);
			SendSysMessage(who, "Changing Custom Hits Level to: "+custom_hits);
		else
			EraseObjProperty(mobile, "CustomHitsLevel");
			SendSysMessage(who, "Removed Custom Hits Level.");
		endif

		// The maximum function in regen.src only runs when the engine recalculates, so force it now
		RecalcVitals(mobile);
		SetHP(mobile, GetMaxHP(mobile));
	endif

	if (spells_changed)
		// Matching the template keeps it on the template (and any doubled-up spells it lists)
		if (spells_to_template)
			EraseObjProperty(mobile, "CustomSpells");
			SendSysMessage(who, "Spells set to the template's "+npc_spells.size()+".");
		else
			SetObjProperty(mobile, "CustomSpells", npc_spells);
			SendSysMessage(who, "Spells saved: "+npc_spells.size()+".");
		endif
	endif

endfunction

function CalculateProtections(who)

	earth := CInt(GetObjProperty(who, "EarthProtection"));
	fire := CInt(GetObjProperty(who, "FireProtection"));
	water := CInt(GetObjProperty(who, "WaterProtection"));
	air := CInt(GetObjProperty(who, "AirProtection"));
	holy := CInt(GetObjProperty(who, "HolyProtection"));

	necro := CInt(GetObjProperty(who, "NecroProtection"));
	physical := CInt(GetObjProperty(who, "PhysicalProtection"));
	poison := CInt(GetObjProperty(who, "PermPoisonImmunity"));
	freeaction := CInt(GetObjProperty(who, "FreeAction"));

	healing := CInt(GetObjProperty(who, "HealingIncrease"));
	magicimmunity := CInt(GetObjProperty(who, "PermMagicImmunity"));
	magicreflection := CInt(GetObjProperty(who, "Permmr"));

	old_stats[12] := earth;
	old_stats[13] := fire;
	old_stats[14] := water;
	old_stats[15] := air;
	old_stats[16] := holy;
	old_stats[17] := necro;
	old_stats[18] := physical;
	old_stats[19] := poison;
	old_stats[20] := freeaction;
	old_stats[21] := healing;
	old_stats[22] := 0;	// unused, was ME
	old_stats[23] := magicimmunity;
	old_stats[24] := magicreflection;
	old_stats[25] := 0;	// unused, was Absorbsion
	old_stats[26] := 0;	// unused, was Warding
	old_stats[27] := 0;	// unused, was Antidotes
endfunction

// Reads the AI / Loot and Flags page values off the npc (CProps first, then its npcdesc template)
function LoadNpcSettings(mobile)

	var elem := FindConfigElem(ReadConfigFile("::npcdesc"), mobile.npctemplate);

	old_stats[77] := mobile.script;

	// CustomLoot is { MagicItemChance, MagicItemLevel, lootgroup }, same as the customnpc spawnpoint gump
	var cloot := GetObjProperty(mobile, "CustomLoot");
	if (cloot)
		old_stats[78] := CStr(CInt(cloot[3]));
		old_stats[79] := CInt(cloot[2]);
		old_stats[80] := CInt(cloot[1]);
	else
		old_stats[78] := JoinLootGroups(GetConfigStringArray(elem, "lootgroup"));
		old_stats[79] := CInt(GetConfigInt(elem, "MagicItemLevel"));
		old_stats[80] := CInt(GetConfigInt(elem, "MagicItemChance"));
	endif

	old_stats[81] := ItemsDrop(GetWornItems(mobile));
	old_stats[82] := ItemsDrop(GetPackItems(mobile));
	old_stats[83] := CStr(mobile.title_prefix);
	old_stats[84] := CStr(mobile.title_suffix);
	old_stats[85] := HasFlag(mobile, "LesserBoss");
	old_stats[86] := HasFlag(mobile, "Boss");
	old_stats[87] := HasFlag(mobile, "SuperBoss");
	old_stats[88] := CInt(GetObjProperty(mobile, "Champion"));
	old_stats[89] := GetTameDifficulty(mobile, elem);
	old_stats[90] := CInt(GetObjProperty(mobile, "snoopme"));
	old_stats[91] := CInt(GetObjProperty(mobile, "stealme"));
	old_stats[92] := GetProvokeDifficulty(mobile, elem);

endfunction

function ApplyNpcSettings(who, mobile)

	var refresh := 0;

	if (old_stats[77] != new_stats[77])
		if (!new_stats[77])
			SendSysMessage(who, "Script can't be blank, left as "+mobile.script+".");
		else
			mobile.script := new_stats[77];
			RestartScript(mobile);
			SendSysMessage(who, "Changing Script to: "+mobile.script);
		endif
	endif

	if (old_stats[78] != new_stats[78] || old_stats[79] != new_stats[79] || old_stats[80] != new_stats[80])
		// Same rule as the customnpc spawnpoint gump: loot is admin+ only
		if (who.cmdlevel > 3)
			var lootgroup := CInt(new_stats[78]);
			SetObjProperty(mobile, "CustomLoot", array{ CInt(new_stats[80]), CInt(new_stats[79]), lootgroup });
			SendSysMessage(who, "Changing Loot to: Lootgroup "+lootgroup+", Magic Item Level "+new_stats[79]+", Magic Item Chance "+new_stats[80]);
			if (CStr(lootgroup) != new_stats[78])
				SendSysMessage(who, "Custom loot only holds one lootgroup, kept "+lootgroup+".", FONT_NORMAL, 43);
			endif
		else
			SendSysMessage(who, "Loot unchanged, need admin+ rights for that.", FONT_NORMAL, 43);
		endif
	endif

	if (old_stats[81] != new_stats[81])
		SetItemsNoLoot(GetWornItems(mobile), !new_stats[81]);
		SendSysMessage(who, "Worn items drop on death: "+YesNoText(new_stats[81]));
	endif
	if (old_stats[82] != new_stats[82])
		SetItemsNoLoot(GetPackItems(mobile), !new_stats[82]);
		SendSysMessage(who, "Backpack items drop on death: "+YesNoText(new_stats[82]));
	endif

	if (old_stats[83] != new_stats[83])
		mobile.title_prefix := new_stats[83];
		SendSysMessage(who, "Changing Title Prefix to: "+new_stats[83]);
	endif
	if (old_stats[84] != new_stats[84])
		mobile.title_suffix := new_stats[84];
		SendSysMessage(who, "Changing Title Suffix to: "+new_stats[84]);
	endif

	if (old_stats[85] != new_stats[85])
		SetFlag(mobile, "LesserBoss", new_stats[85]);
		SendSysMessage(who, "Lesser Boss: "+YesNoText(new_stats[85]));
		refresh := 1;
	endif
	if (old_stats[86] != new_stats[86])
		SetFlag(mobile, "Boss", new_stats[86]);
		SendSysMessage(who, "Boss: "+YesNoText(new_stats[86]));
		refresh := 1;
	endif
	if (old_stats[87] != new_stats[87])
		SetFlag(mobile, "SuperBoss", new_stats[87]);
		SendSysMessage(who, "Super Boss: "+YesNoText(new_stats[87]));
		refresh := 1;
	endif
	if (old_stats[88] != new_stats[88])
		SetNumberProp(mobile, "Champion", new_stats[88]);
		SendSysMessage(who, "Changing Champion to: "+CInt(GetObjProperty(mobile, "Champion")));
	endif

	if (old_stats[89] != new_stats[89])
		if (new_stats[89] > 0)
			EraseObjProperty(mobile, "notame");
			EraseObjProperty(mobile, "untamable");
			SetObjProperty(mobile, "tamableAt", CInt(new_stats[89]));
			SendSysMessage(who, "Changing Tame Difficulty to: "+new_stats[89]);
			if (GetObjProperty(mobile, "SuperBoss"))
				SendSysMessage(who, "Super Bosses can never be tamed.", FONT_NORMAL, 43);
			endif
		else
			EraseObjProperty(mobile, "tamableAt");
			// untamable, not notame: taming checks both, but Spell Bind, Control Undead,
			// Beastal Bond and herding only check untamable (same prop .untamable sets)
			SetObjProperty(mobile, "untamable", 1);
			SendSysMessage(who, "Npc can no longer be tamed or controlled.");
		endif
	endif

	if (old_stats[90] != new_stats[90])
		SetNumberProp(mobile, "snoopme", new_stats[90]);
		SendSysMessage(who, "Changing Snoop Difficulty to: "+CInt(GetObjProperty(mobile, "snoopme")));
	endif
	if (old_stats[91] != new_stats[91])
		SetNumberProp(mobile, "stealme", new_stats[91]);
		SendSysMessage(who, "Changing Steal Difficulty to: "+CInt(GetObjProperty(mobile, "stealme")));
	endif

	if (old_stats[92] != new_stats[92])
		// Kept even at 0: a 0 provoke CProp is what blocks provoke and peace
		var provoke := CInt(new_stats[92]);
		if (provoke < 0)
			provoke := 0;
		endif
		SetObjProperty(mobile, "provoke", provoke);
		if (provoke)
			SendSysMessage(who, "Changing Provoke/Peace Difficulty to: "+provoke);
		else
			SendSysMessage(who, "Npc can no longer be provoked or peaced.");
		endif
	endif

	// Boss name colours come from the name colour hook; a forced move resends the mobile to nearby clients
	if (refresh)
		MoveObjectToLocation(mobile, mobile.x, mobile.y, mobile.z, mobile.realm, MOVEOBJECT_FORCELOCATION);
	endif

endfunction

function JoinLootGroups(groups)

	if (!groups.size())
		return "0";
	endif

	var text := "";
	foreach group in groups
		if (text)
			text := text+"/";
		endif
		text := text+group;
	endforeach

	return text;

endfunction

// Hair, beard and the mount piece are equipped too but aren't loot
function GetWornItems(mobile)

	var skip_layers := array{ LAYER_HAIR, LAYER_BEARD, LAYER_MOUNT, LAYER_PACK };
	var items := array;
	foreach item in ListEquippedItems(mobile)
		if (!(item.layer in skip_layers))
			items.append(item);
		endif
	endforeach

	return items;

endfunction

function GetPackItems(mobile)

	if (!mobile.backpack)
		return array;
	endif

	return EnumerateItemsInContainer(mobile.backpack);

endfunction

// 1 unless every item is flagged noloot (death.src destroys those instead of leaving them on the corpse)
function ItemsDrop(items)

	foreach item in items
		if (!GetObjProperty(item, "noloot"))
			return 1;
		endif
	endforeach

	if (items.size())
		return 0;
	endif

	return 1;

endfunction

function SetItemsNoLoot(items, noloot)

	foreach item in items
		if (noloot)
			SetObjProperty(item, "noloot", 1);
		else
			EraseObjProperty(item, "noloot");
		endif
	endforeach

endfunction

function HasFlag(mobile, prop)

	if (GetObjProperty(mobile, prop))
		return 1;
	endif

	return 0;

endfunction

function SetFlag(mobile, prop, on)

	if (on)
		SetObjProperty(mobile, prop, 1);
	else
		EraseObjProperty(mobile, prop);
	endif

endfunction

// 0 or less erases the prop
function SetNumberProp(mobile, prop, value)

	value := CInt(value);
	if (value > 0)
		SetObjProperty(mobile, prop, value);
	else
		EraseObjProperty(mobile, prop);
	endif

endfunction

// Mirrors pkg/std/taming/taming.src: notame/untamable block it, tamableAt overrides the template tameskill
function GetTameDifficulty(mobile, elem)

	if (GetObjProperty(mobile, "notame") || GetObjProperty(mobile, "untamable"))
		return 0;
	endif

	var difficulty := CInt(GetObjProperty(mobile, "tamableAt"));
	if (!difficulty)
		difficulty := CInt(GetConfigInt(elem, "tameskill"));
	endif

	return difficulty;

endfunction

// Mirrors provocation.src / peacemaking.src: a provoke CProp beats the template, 0 means never;
// otherwise invul templates can't be provoked and the template provoke defaults to 100, capped at 150
function GetProvokeDifficulty(mobile, elem)

	var custom := GetObjProperty(mobile, "provoke");
	if (custom != error)
		return CInt(custom);
	endif

	if (!elem || elem.Privs == "invul")
		return 0;
	endif

	var difficulty := CInt(elem.provoke);
	if (!difficulty)
		difficulty := 100;
	elseif (difficulty > 150)
		difficulty := 150;
	endif

	return difficulty;

endfunction

function GetTemplateSpells(mobile)

	var elem := FindConfigElem(ReadConfigFile("::npcdesc"), mobile.npctemplate);
	if (!elem)
		return array;
	endif

	return GetConfigStringArray(elem, "spell");

endfunction

// A CustomSpells CProp (even an empty one) replaces the template's spell lines, see cast_offensive_spell() in npccast.inc
function GetNpcSpells(mobile)

	var custom := GetObjProperty(mobile, "CustomSpells");
	if (custom != error)
		return custom;
	endif

	return GetTemplateSpells(mobile);

endfunction

// Every spell npccast.inc can cast, plus whatever this npc already has, alphabetical
function GetAllMobSpells()

	var found := dictionary;
	foreach spell in (GetNpcSpellNames())
		found[spell] := 1;
	endforeach

	foreach spell in npc_spells
		found[spell] := 1;
	endforeach

	return found.keys();

endfunction

// Compares as sets: a template that lists a spell twice (to cast it more often) still matches
function SameSpells(list_a, list_b)

	foreach spell in list_a
		if (!(spell in list_b))
			return 0;
		endif
	endforeach
	foreach spell in list_b
		if (!(spell in list_a))
			return 0;
		endif
	endforeach

	return 1;

endfunction

// Checkbox list of every mob spell; Save stages the choice for Apply
function EditNpcSpells(who, mobile)

	var all_spells := GetAllMobSpells();
	var per_page := SPELLS_PER_COLUMN * 3;
	var pages := CInt((all_spells.size() + per_page - 1) / per_page);
	if (pages < 1)
		pages := 1;
	endif

	var gump := GFCreateGump();
	GFPage(gump, 0);
	GFResizePic(gump, 16, 19, 9300, 500, 470);
	GFTextLine(gump, 40, 30, TEXT_COLOR, "Spells for "+mobile.name+" - tick the ones it should cast");
	if (!(mobile.script in CASTER_SCRIPTS))
		GFTextLine(gump, 40, 50, 33, "AI script '"+mobile.script+"' doesn't cast spells, use spellkillpcs");
	endif

	//Cancel
	GFAddButton(gump, 30, 430, 2121, 2120, GF_CLOSE_BTN, 2);
	//Save
	GFAddButton(gump, 100, 430, 2123, 2124, GF_CLOSE_BTN, 1);
	//Back to the template's own spells
	GFAddButton(gump, 170, 432, 4005, 4006, GF_CLOSE_BTN, 3);
	GFTextLine(gump, 205, 433, TEXT_COLOR, "Template");

	var page := 1;
	var i;
	GFPage(gump, page);
	GFTextLine(gump, 330, 433, TEXT_COLOR, "Page 1 of "+pages);
	for (i := 1; i <= all_spells.size(); i := i + 1)
		var slot := (i - 1) % per_page;
		if (i > 1 && slot == 0)
			GFAddButton(gump, 470, 430, 4005, 4006, GF_PAGE_BTN, page + 1);
			page := page + 1;
			GFPage(gump, page);
			GFAddButton(gump, 435, 430, 4014, 4015, GF_PAGE_BTN, page - 1);
			GFTextLine(gump, 330, 433, TEXT_COLOR, "Page "+page+" of "+pages);
		endif

		var x := 40 + (CInt(slot / SPELLS_PER_COLUMN) * 155);
		var y := 75 + ((slot % SPELLS_PER_COLUMN) * 23);
		var checked := 0;
		if (all_spells[i] in npc_spells)
			checked := 1;
		endif
		GFCheckBox(gump, x, y, 210, 211, checked, SPELL_CHK_BASE + i);
		GFTextLine(gump, x + 25, y, TEXT_COLOR, all_spells[i]);
	endfor

	var result := GFSendGump(who, gump);

	var chosen := array;
	if (result[0] == 1)
		for (i := 1; i <= all_spells.size(); i := i + 1)
			if (result[SPELL_CHK_BASE + i])
				chosen.append(all_spells[i]);
			endif
		endfor
	elseif (result[0] == 3)
		chosen := GetTemplateSpells(mobile);
	else
		SendSysMessage(who, "Spells unchanged.", FONT_NORMAL, 43);
		return 0;
	endif

	// Staged like the other fields; ApplyStagedNpcEdits writes it when Apply is pressed
	spells_to_template := SameSpells(chosen, GetTemplateSpells(mobile));
	if (spells_to_template)
		npc_spells := GetTemplateSpells(mobile);
	else
		npc_spells := chosen;
	endif
	spells_changed := 1;
	SendSysMessage(who, npc_spells.size()+" spell(s) are set when you press Apply.");

	return 1;

endfunction

function YesNoText(value)

	if (value)
		return "yes";
	endif

	return "no";

endfunction
