function WonChristmas(who)
	
	var chance := Random(22);
	//var chance := 21;
	var item;

	case (chance)
		1: PrintTextAbovePrivate(who, "You got a pair of red socks!", who);
			item := CreateItemInBackpack(who, 0x3DE9);
			item.movable := 1;
			item := CreateItemInBackpack(who, 0x3DEA);
			item.movable := 1;
		2: PrintTextAbovePrivate(who, "You got a pair of green socks!", who);
			item := CreateItemInBackpack(who, 0x3DE7);
			item.movable := 1;
			item := CreateItemInBackpack(who, 0x3DE8);
			item.movable := 1;
		3: PrintTextAbovePrivate(who, "You got a gingerbread cookie!", who);
			item := CreateItemInBackpack(who, 0x3DEF);
			item.movable := 1;
		4: PrintTextAbovePrivate(who, "You got a snowman!", who);
			item := CreateItemInBackpack(who, 0x2328);
			item.movable := 1;
			item.name := "Snowman";
		5: PrintTextAbovePrivate(who, "You got a snowman!", who);
			item := CreateItemInBackpack(who, 0x2329);
			item.movable := 1;
			item.name := "Snowman";
		6: PrintTextAbovePrivate(who, "You got a poinsettia!", who);
			item := CreateItemInBackpack(who, 0x2330);
			item.movable := 1;
			item.name := "Poinsettia";
		7: PrintTextAbovePrivate(who, "You got a poinsettia!", who);
			item := CreateItemInBackpack(who, 0x2331);
			item.movable := 1;
			item.name := "Poinsettia";
		8: PrintTextAbovePrivate(who, "You got a gift box!", who);
			item := CreateItemInBackpack(who, 0x232A);
			item.movable := 1;
			item.name := "Gift Box";
		9: PrintTextAbovePrivate(who, "You got a gift box!", who);
			item := CreateItemInBackpack(who, 0x232B);
			item.movable := 1;
			item.name := "Gift Box";
		10: PrintTextAbovePrivate(who, "You got a wreath!", who);
			item := CreateItemInBackpack(who, 0x232C);
			item.movable := 1;
			item.name := "Wreath";
		11: PrintTextAbovePrivate(who, "You got a wreath!", who);
			item := CreateItemInBackpack(who, 0x232D);
			item.movable := 1;
			item.name := "Wreath";
		12: PrintTextAbovePrivate(who, "You got a snowflake!", who);
			item := CreateItemInBackpack(who, 0x232E);
			item.movable := 1;
			item.name := "Snowflake";
		13: PrintTextAbovePrivate(who, "You got a snowflake!", who);
			item := CreateItemInBackpack(who, 0x232F);
			item.movable := 1;
			item.name := "Snowflake";
		14: PrintTextAbovePrivate(who, "You got a holiday candle!", who);
			item := CreateItemInBackpack(who, 0x236E);
			item.movable := 1;
			item.name := "Holiday Candle";
		15: PrintTextAbovePrivate(who, "You got a holiday candle!", who);
			item := CreateItemInBackpack(who, 0x2371);
			item.movable := 1;
			item.name := "Holiday Candle";
		16: PrintTextAbovePrivate(who, "You got some mistletoe!", who);
			item := CreateItemInBackpack(who, 0x2374);
			item.movable := 1;
			item.name := "Mistletoe";
		17: PrintTextAbovePrivate(who, "You got some mistletoe!", who);
			item := CreateItemInBackpack(who, 0x2375);
			item.movable := 1;
			item.name := "Mistletoe";
		18: PrintTextAbovePrivate(who, "You got a festive cactus!", who);
			item := CreateItemInBackpack(who, 0x2376);
			item.movable := 1;
			item.name := "Festive Cactus";
		19: PrintTextAbovePrivate(who, "You got a snowy tree!", who);
			item := CreateItemInBackpack(who, 0x2377);
			item.movable := 1;
			item.name := "Snowy Tree";
		20: PrintTextAbovePrivate(who, "You got a decorative topiary!", who);
			item := CreateItemInBackpack(who, 0x2378);
			item.movable := 1;
			item.name := "Decorative Topiary";
		21: PrintTextAbovePrivate(who, "You got a Ghost of Christmas Past!", who);
			item := CreateItemInBackpack(who, 0x33CE);
			item.movable := 1;
			item.name := "Ghost of Christmas Past";
		default: PrintTextAbovePrivate(who, "You got a gingerbread cookie!", who);
			item := CreateItemInBackpack(who, 0x3DF0);
			item.movable := 1;
	endcase

endfunction