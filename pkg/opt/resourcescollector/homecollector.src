    var result := GFSendGump(who, gump);
    var pressed_buttons_id := result[0];

   	case (pressed_buttons_id)
        BTN_ID_ADD_ITEM:
            rescollect(who,item);
			133:
 	if( coordist( item.x, item.y, who.x, who.y ) > 6 )
		SendSysmessage(who, "Too far away",color:= 2030, font:= 3 );
		return;
	endif
   
		var regObjtypes := array { 0x0F85, 0x0F86, 0x0F84, 0x0F88, 0x0F8C, 0x0F8D, 0x0F7A,0x0F7B, 0x0F78, 0x0F79, 0x0F7C, 0x0F7D, 0x0F7E, 0x0F7F, 0x0F80, 0x0F81,
		0x0F82, 0x0F83, 0x0F87, 0x0F89, 0x0F8A,0x0F8B, 0x0F8E, 0x0F8F, 0x0F90, 0x0F91};
		var regPropertyNames := dictionary { 0x0F85 -> "Ginsengs", 0x0F86 -> "MandrakeRoot", 0x0F84 -> "Garlic", 0x0F88 -> "Nightshade", 0x0F8C -> "SulphurousAsh",
		0x0F8D -> "SpiderSilk", 0x0F7A -> "BlackPearl", 0x0F7B -> "BloodMoss", 0x0F78 -> "Batwing", 0x0F79 -> "Blackmoor", 0x0F7C -> "Bloodspawn",
		0x0F7D -> "VialOfBlood", 0x0F7E -> "Bone", 0x0F7F -> "Brimstone", 0x0F80 -> "DaemonBone", 0x0F81 -> "FertileDirt", 0x0F82 -> "DragonsBlood", 
		0x0F83 -> "ExecutionersCap", 0x0F87 -> "EyeOfNewt", 0x0F89 -> "Obsidian", 0x0F8A -> "PigIron", 0x0F8B -> "Pumice", 0x0F8E -> "SerpentsScales", 
		0x0F8F -> "VolcanicAsh", 0x0F90 -> "Deadwood", 0x0F91 -> "WormsHeart"};

		foreach itemObjtype in (regObjtypes)
			var amount := Cint(GFExtractData(result, itemObjtype ));
			var itemName := itemcfg[itemObjtype].Name;
			if ((amount > 0) and (amount <= 60000))

				var propName := regPropertyNames[itemObjtype];
				var currentAmount := CInt(GetObjProperty(item, propName));

				if ( currentAmount> 0 and amount <= currentAmount )
					var newitem := CreateItemInBackpack( who, itemObjtype, amount);
					if (newitem)
						if (currentAmount == amount)
							EraseObjProperty(item, propName);
						else
							SetObjProperty(item, propName, CInt(GetObjProperty(item, propName) - amount));
						endif
						SendSysmessage(who, "You have received the item {1} in quantity {2}.".format(itemName,amount),color:= 2030, font:= 3);
					else
						PrintTextAbovePrivate( who, "Couldn't create that: {1}".format(newitem.errortext)), who ,color:= 2030, font:= 3);
					endif
			else
					SendSysmessage(who, "Invalid number to get the item {1} remaining quantity {2}.".format(itemName,GetObjProperty(item, propName)), color:= 2030, font:= 3);
				endif
			endif
		endforeach

