program homecollector(who, item)
	
  	if( who.multi )
        var house := who.multi;
        if( FindHouseSign( house ) )
            if( not IsAFriend (FindHouseSign( house ), who) )
                SendSysmessage( who, "You can't use item from a non friendly house.", color:= 2030,font:= 3 );
                return;
            endif
        endif
	else
        SendSysmessage( who, "You can't use item from outside.", color:= 2030,font:= 3 );
		return;
    endif

	detach();
	var charpack := who.backpack;
	
