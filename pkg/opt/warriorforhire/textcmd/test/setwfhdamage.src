// Synopsis: Set Warrior for Hire damage multipliers vs NPCs and bosses
use uo;
use os;

include ":gumps:include/gumps";
include ":gumps:include/gumps_ex";
include ":staff:include/staff";

program textcmd_setwfhdamage(who)

	var toNPCs := GetGlobalProperty("WFHDamageToNPCs");
	if (!toNPCs) toNPCs := 1.0; endif
	var fromNPCs := GetGlobalProperty("WFHDamageFromNPCs");
	if (!fromNPCs) fromNPCs := 1.0; endif
	var toBosses := GetGlobalProperty("WFHDamageToBosses");
	if (!toBosses) toBosses := 1.0; endif
	var fromBosses := GetGlobalProperty("WFHDamageFromBosses");
	if (!fromBosses) fromBosses := 1.0; endif

	var gump := GFCreateGump( 50, 50, 340, 260 );
	GFResizePic( gump, 0, 0, 3500, 340, 260 );
	GFHTMLArea(gump, 20, 15, 300, 25, "<BASEFONT SIZE=20><CENTER>WFH Damage Multipliers", 0, 0);

	GFTextLine(gump, 20, 60, 0, "Damage dealt to NPCs:");
	var e1 := GFTextEntry(gump, 220, 58, 80, 20, 0, CStr(toNPCs));

	GFTextLine(gump, 20, 90, 0, "Damage taken from NPCs:");
	var e2 := GFTextEntry(gump, 220, 88, 80, 20, 0, CStr(fromNPCs));

	GFTextLine(gump, 20, 120, 0, "Damage dealt to Bosses:");
	var e3 := GFTextEntry(gump, 220, 118, 80, 20, 0, CStr(toBosses));

	GFTextLine(gump, 20, 150, 0, "Damage taken from Bosses:");
	var e4 := GFTextEntry(gump, 220, 148, 80, 20, 0, CStr(fromBosses));

	GFHTMLArea(gump, 20, 180, 300, 40, "<BASEFONT COLOR=DARKGRAY>1.0 = no change. 0.5 = half. 2.0 = double.", 0, 0);

	GFAddButton(gump, 130, 225, 2128, 2129, GF_CLOSE_BTN, 1);

	var data := GFSendGump(who, gump);
	if (!data or !data[0])
		SendSysMessage(who, "Cancelled.");
		return;
	endif

	// Every field must be a number between 0.1 and 10; anything else (letters, a comma decimal,
	// a negative) is refused as a whole, so a typo cannot store 0.0 or make a warrior heal bosses.
	var values := { CDbl(GFExtractData(data, e1)), CDbl(GFExtractData(data, e2)), CDbl(GFExtractData(data, e3)), CDbl(GFExtractData(data, e4)) };
	var texts  := { GFExtractData(data, e1), GFExtractData(data, e2), GFExtractData(data, e3), GFExtractData(data, e4) };
	var i;
	for( i := 1; i <= 4; i := i + 1 )
		if( !IsMultiplierText(texts[i]) or values[i] < 0.1 or values[i] > 10.0 )
			SendSysMessage(who, "Multipliers must be numbers from 0.1 to 10 (got \"" + texts[i] + "\"). Nothing changed.");
			return 0;
		endif
	endfor

	SetGlobalProperty("WFHDamageToNPCs", values[1]);
	SetGlobalProperty("WFHDamageFromNPCs", values[2]);
	SetGlobalProperty("WFHDamageToBosses", values[3]);
	SetGlobalProperty("WFHDamageFromBosses", values[4]);

	SendSysMessage(who, "Warrior for Hire damage multipliers updated.");
	LogCommand(who, GetProcess(GetPid()).name, 0, "Set WFH damage multipliers");

endprogram

// "1", "0.5", " 2.25 " -> 1; "", "1,5", "-1", "abc" -> 0
function IsMultiplierText( text )

	var words := SplitWords(CStr(text));
	if( words.size() != 1 )
		return 0;
	endif
	text := words[1];

	var dots := 0;
	var i;
	for( i := 1; i <= Len(text); i := i + 1 )
		var c := text[i];
		if( c == "." )
			dots := dots + 1;
		elseif( c < "0" or c > "9" )
			return 0;
		endif
	endfor
	return (dots <= 1 and Len(text) > dots);

endfunction
