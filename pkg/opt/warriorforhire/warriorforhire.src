// Deed to a Warrior for Hire: creates the mercenary at the player's feet and binds it to them.
use uo;

program warriorforhire(who, deed)

	var hme := SystemFindObjectBySerial(CInt(GetObjProperty(who, "henchman")));
	if (hme)
		SendSysMessage(who, "You already have a henchman");
		return;
	endif

	// Realm passed so a deed used outside Felucca doesn't create the warrior in Felucca.
	var wfh := CreateNpcFromTemplate("warriorforhire", who.x, who.y, who.z, 0, who.realm);
	if (wfh)
		DestroyItem(deed);
		SendSysMessage(who, "Warrior for hire created!");
		SetObjProperty(who, "henchman", wfh.serial);
		SetObjProperty(wfh, "master", who.serial);
		RestartScript(wfh);
	else
		SendSysMessage(who, "Can't place here.");
	endif

endprogram
