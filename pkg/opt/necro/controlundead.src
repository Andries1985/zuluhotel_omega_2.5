use uo;
use os;


include "include/spelldata";
include "include/classes";
include "include/client";
include "include/attributes";
include "include/managers";
include "include/charm";

const SPELL_EFFECT_TYPE_MOVING 	:= MOVING_SPELL_CONTROL_UNDEAD;
const SPELL_EFFECT_ID		:= FX_SPELL_CONTROL_UNDEAD;
const SPELL_EFFECT_SPEED	:= SPEED_SPELL_CONTROL_UNDEAD;
const SPELL_EFFECT_LOOP		:= LOOP_SPELL_CONTROL_UNDEAD;

program cast_controlundead( parms )
	
	var circle := GetCircle( SPELLID_CONTROL_UNDEAD );
	var plane := NECRO;
	var caster;
	var cast_on;
	var fromhit;

	if (parms[1] == "#MOB")
		caster := parms[2];
		cast_on := parms[3];
		if (parms[4])
			circle := parms[4];
		endif
		if (parms[5])
			fromhit := parms[5];
		endif

	else
		caster := parms;	
		if( TryToCast( caster, SPELLID_CONTROL_UNDEAD ) != SUCCESS )
			EraseObjProperty( caster , "#Casting" );
			return;
		endif
		SendSysmessage( caster , "Select a target." );
		cast_on := CanTargetSpell( caster , circle , TGTOPT_CHECK_LOS + TGTOPT_HARMFUL );
		if( !cast_on )
			EraseObjProperty( caster , "#Casting" );
			return;
		endif
	endif
	
	if( !fromhit )
		EraseObjProperty( caster , "#Casting" );
		cast_on := Reflected( caster , cast_on , circle );
	else
		PlayObjectCenteredEffect(cast_on, 
                                         SPELL_EFFECT_ID,
                                         SPELL_EFFECT_SPEED,
                                         SPELL_EFFECT_LOOP);
	endif
	
	if( !cast_on.isa(POLCLASS_NPC) or GetObjProperty( cast_on , "Type" ) != "Undead" )
		SendSysmessage( caster , "That isn't an undead!" );
		EraseObjProperty( caster , "#Casting" );
		return;
	endif
	
	if( GetObjProperty( cast_on , "untamable" ) or GetObjProperty( cast_on , "iChampSpawn" ) )
		SendSysmessage( caster , "You can't take the control of this creature." );
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	// Someone's pet, animated dead or summon, or already under this spell. Taking it used to
	// steal it, and casting again on your own saved "tamed" as its script, so it never went back.
	if( cast_on.script == "tamed" or GetObjProperty( cast_on , "master" ) or IsSpellCharmed( cast_on ) )
		if( CInt(GetObjProperty( cast_on , "master" )) == caster.serial )
			SendSysmessage( caster , "This creature is already under your control." );
		else
			SendSysmessage( caster , "That creature already has a master." );
		endif
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	var conf	:= ReadConfigFile ("::npcdesc");
	var elem	:= FindConfigElem(conf, cast_on.npctemplate);
	if (!elem)
		SendSysmessage(caster, "You cannot take the control of this!");
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	if( (elem.Privs == "invul") || GetObjProperty( cast_on, "Boss" ) || GetObjProperty( cast_on, "SuperBoss"))
	  	SendSysmessage(caster, "You can't take the control of that!");
	  	EraseObjProperty( caster , "#Casting" );
		return;
	endif

	PlaySoundEffect( caster , SFX_SPELL_CONTROL_UNDEAD );
	
	var protected := IsProtected( caster , cast_on , circle );
	if( protected == IMMUNED )
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	var duration := ModifyWithMagicEfficiency( caster , GetEffectiveSkill( caster , SKILLID_MAGERY ) * 3 );
	var protect := GetResultingPlaneProtection( cast_on , plane );
	if( protect )
		duration := duration - ( duration * protect * 0.25 );
		if( duration < 1 )
			SendSysmessage( caster , "This undead is immuned to your spell!" );
			EraseObjProperty( caster , "#Casting" );
			return;
		endif
	endif
	
	SendSysmessage( caster , "Control Undead is successful!" );
	// Tell its spawnpoint it's gone, so the spawnpoint makes a new one.
	WarnManagerOfNpcDeath(cast_on);
	EraseObjProperty( cast_on, "SpawnPoint" );
	EraseObjProperty( cast_on, "Anchor" );
	PrintTextAbove( cast_on, "You take control of " + cast_on.name );
	var control_until := StartCharm( cast_on, caster, duration, "controlundead" );

	EraseObjProperty( caster , "#Casting" );
	Sleep( CInt(duration) );

	// End it unless it already ended (released, or the tamed AI saw the time pass) or a later
	// cast now holds it. The tamed AI also ends it if this script dies, e.g. in a reboot.
	var control_data := GetObjProperty( cast_on, PROPID_CHARM );
	if( cast_on and control_data and control_data.ends_at == control_until and control_data.master == caster.serial )
		EndCharm( cast_on );
	endif

endprogram
