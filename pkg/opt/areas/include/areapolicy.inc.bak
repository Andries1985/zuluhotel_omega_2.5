use uo;
use os;
use basic;
use cfgfile;

include ":datafile:datafile";
include "include/constants/cfgfiles";

const AREA_POLICY_DATAFILE_PREFIX := ":areas:area_policies_";
const AREA_POLICY_META_ELEMENT := "__meta__";
const AREA_POLICY_MASK_PROP := "Mask";
const AREA_POLICY_DEFAULT_REALM := "britannia";
const AREA_POLICY_GLOBAL_ID_WHOLEWORLD := "feluccawholeworld";
const AREA_POLICY_GLOBAL_ID_WHOLEWORLD_LEGACY := "wholeworld";
const AREA_POLICY_GLOBAL_ID_BRITANNIA := "britannia";
const AREA_POLICY_GLOBAL_ID_TRAMMEL_WHOLEWORLD := "trammelwholeworld";

const AREA_POLICY_GUARDED := 1;
const AREA_POLICY_NO_RECALL_TO := 2;
const AREA_POLICY_NO_RECALL_FROM := 4;
const AREA_POLICY_NO_MARKING := 8;
const AREA_POLICY_ANTI_MAGIC := 16;
const AREA_POLICY_FORBIDDEN := 32;
const AREA_POLICY_NO_LOOTING := 64;
const AREA_POLICY_SAFE_AREA := 128;
const AREA_POLICY_NO_PK := 256;
const AREA_POLICY_RP_AREA := 512;

function GetAreaPolicyRealm(realm)
	realm := Lower(CStr(realm));
	if(!realm)
		realm := AREA_POLICY_DEFAULT_REALM;
	endif

	var areas_cfg := ReadConfigFile(CFGFILE_AREAS);
	if(areas_cfg && areas_cfg[realm])
		return realm;
	endif

	return AREA_POLICY_DEFAULT_REALM;
endfunction


function GetRealmAreaLines(realm)
	realm := GetAreaPolicyRealm(realm);

	var areas_cfg := ReadConfigfile(CFGFILE_AREAS);
	var realm_elem := areas_cfg[realm];
	if(!realm_elem)
		return error{"errortext":="Unknown areas realm: " + realm};
	endif

	var area_lines := GetConfigStringArray(realm_elem, "Area");
	if(!area_lines)
		return error{"errortext":="No areas found for realm: " + realm};
	endif

	return area_lines;
endfunction


function ParseAreaLine(area_line, area_index := 0)
	var parts := SplitWords(area_line);
	if(!parts || !parts[1] || !parts[2] || !parts[3] || !parts[4])
		return error{"errortext":="Invalid area line: " + CStr(area_line)};
	endif

	var info := struct;
	info.+min_x := CInt(parts[1]);
	info.+max_x := CInt(parts[2]);
	info.+min_y := CInt(parts[3]);
	info.+max_y := CInt(parts[4]);
	info.+area_index := CInt(area_index);

	var token5 := CStr(parts[5]);
	var name_start := 5;
	if(Len(token5) > 3)
		if(Lower(SubStr(token5, 1, 3)) == "id=")
			info.+area_id := NormalizeAreaId(SubStr(token5, 4, Len(token5)));
			name_start := 6;
		endif
	endif

	var area_name := "";
	var i;
	for(i := name_start; i <= parts.size(); i := i + 1)
		if(i > name_start)
			area_name := area_name + " ";
		endif
		area_name := area_name + CStr(parts[i]);
	endfor
	if(!area_name)
		area_name := "Area " + CStr(area_index);
	endif
	info.+name := area_name;

	if(!info.area_id)
		info.+area_id := BuildFallbackAreaId(info.name, info.min_x, info.max_x, info.min_y, info.max_y, area_index);
	endif

	return info;
endfunction


function BuildFallbackAreaId(name, min_x, max_x, min_y, max_y, area_index := 0)
	var base := CStr(name) + "_" + CStr(min_x) + "_" + CStr(max_x) + "_" + CStr(min_y) + "_" + CStr(max_y);
	if(area_index)
		base := base + "_" + CStr(area_index);
	endif
	return NormalizeAreaId(base);
endfunction


function NormalizeAreaId(area_id)
	var normalized := Lower(CStr(area_id));
	var normalized_id := "";
	var i;
	for(i := 1; i <= Len(normalized); i := i + 1)
		var ch := SubStr(normalized, i, 1);
		if((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9"))
			normalized_id := normalized_id + ch;
		endif
	endfor

	if(!normalized_id)
		normalized_id := "area";
	endif

	return normalized_id;
endfunction


function ResolveAreaMatchAtLocation(x, y, realm)
	realm := GetAreaPolicyRealm(realm);
	var global_mask := GetGlobalBypassMask(realm);

	var area_lines := GetRealmAreaLines(realm);
	if(area_lines == error)
		return 0;
	endif

	var point := struct;
	point.+x := CInt(x);
	point.+y := CInt(y);

	var i;
	for(i := 1; i <= area_lines.size(); i := i + 1)
		var area_info := ParseAreaLine(area_lines[i], i);
		if(area_info == error)
			continue;
		endif

		if(point.x >= area_info.min_x && point.x <= area_info.max_x && point.y >= area_info.min_y && point.y <= area_info.max_y)
			var match := struct;
			match.+realm := realm;
			match.+area_index := i;
			match.+area_id := area_info.area_id;
			match.+name := area_info.name;
			match.+mask := MergePolicyMasks(GetPolicyMask(realm, area_info.area_id), global_mask);
			return match;
		endif
	endfor

	return 0;
endfunction


function ResolvePolicyAtLocation(x, y, realm)
	var global_mask := GetGlobalBypassMask(realm);
	var match := ResolveAreaMatchAtLocation(x, y, realm);
	if(!match)
		return CInt(global_mask);
	endif

	return CInt(match.mask);
endfunction


function GetGlobalBypassMask(realm)
	realm := GetAreaPolicyRealm(realm);
	var mask := 0;

	mask := MergePolicyMasks(mask, GetPolicyMask(realm, AREA_POLICY_GLOBAL_ID_WHOLEWORLD));
	mask := MergePolicyMasks(mask, GetPolicyMask(realm, AREA_POLICY_GLOBAL_ID_WHOLEWORLD_LEGACY));
	mask := MergePolicyMasks(mask, GetPolicyMask(realm, AREA_POLICY_GLOBAL_ID_BRITANNIA));
	mask := MergePolicyMasks(mask, GetPolicyMask(realm, AREA_POLICY_GLOBAL_ID_TRAMMEL_WHOLEWORLD));

	return CInt(mask);
endfunction


function MergePolicyMasks(base_mask, overlay_mask)
	var merged := CInt(base_mask);
	var overlay := CInt(overlay_mask);
	var bits := {
		AREA_POLICY_GUARDED,
		AREA_POLICY_NO_RECALL_TO,
		AREA_POLICY_NO_RECALL_FROM,
		AREA_POLICY_NO_MARKING,
		AREA_POLICY_ANTI_MAGIC,
		AREA_POLICY_FORBIDDEN,
		AREA_POLICY_NO_LOOTING,
		AREA_POLICY_SAFE_AREA,
		AREA_POLICY_NO_PK,
		AREA_POLICY_RP_AREA
	};

	var bit;
	foreach bit in bits
		if(HasPolicy(overlay, bit) && !HasPolicy(merged, bit))
			merged := CInt(merged + bit);
		endif
	endforeach

	return CInt(merged);
endfunction


function HasPolicy(mask, policy_bit)
	mask := CInt(mask);
	policy_bit := CInt(policy_bit);
	if(policy_bit <= 0)
		return 0;
	endif

	return CInt(CInt(mask / policy_bit) % 2);
endfunction


function GetPolicyMask(realm, area_id)
	realm := GetAreaPolicyRealm(realm);
	area_id := NormalizeAreaId(area_id);
	var file_ref := OpenAreaPolicyFile(realm, DF_CREATE);
	if(file_ref == error)
		return 0;
	endif

	var elem := DFFindElement(file_ref, CStr(area_id), DF_NO_CREATE);
	if(!elem || elem == error)
		return 0;
	endif

	var prop_val := DFGetProp(elem, AREA_POLICY_MASK_PROP, DF_NO_CREATE);
	if(prop_val == error)
		return 0;
	endif

	return CInt(prop_val);
endfunction


function SetPolicyMask(realm, area_id, mask, updated_by := "")
	realm := GetAreaPolicyRealm(realm);
	area_id := NormalizeAreaId(area_id);
	var file_ref := OpenAreaPolicyFile(realm, DF_CREATE);
	if(file_ref == error)
		return file_ref;
	endif

	var elem := DFFindElement(file_ref, CStr(area_id), DF_CREATE);
	if(elem == error)
		return elem;
	endif

	elem.SetProp(AREA_POLICY_MASK_PROP, CInt(mask));
	elem.SetProp("UpdatedAt", ReadGameClock());
	elem.SetProp("UpdatedBy", CStr(updated_by));

	var meta_elem := DFFindElement(file_ref, AREA_POLICY_META_ELEMENT, DF_CREATE);
	if(meta_elem != error)
		meta_elem.SetProp("UpdatedAt", ReadGameClock());
		meta_elem.SetProp("UpdatedBy", CStr(updated_by));
	endif

	return CInt(mask);
endfunction


function PruneStaleRealmPolicies(realm)
	realm := GetAreaPolicyRealm(realm);
	var file_ref := OpenAreaPolicyFile(realm, DF_CREATE);
	if(file_ref == error)
		return 0;
	endif

	var area_lines := GetRealmAreaLines(realm);
	if(area_lines == error)
		return 0;
	endif

	var valid_ids := dictionary;
	var i;
	for(i := 1; i <= area_lines.size(); i := i + 1)
		var area_info := ParseAreaLine(area_lines[i], i);
		if(area_info != error)
			valid_ids.Insert(CStr(area_info.area_id), 1);
		endif
	endfor

	var keys := DFGetElemNames(file_ref);
	if(keys == error)
		return 0;
	endif

	var removed := 0;
	var key;
	foreach key in keys
		if(CStr(key) == AREA_POLICY_META_ELEMENT)
			continue;
		endif
		if(!(CStr(key) in valid_ids.Keys()))
			file_ref.DeleteElement(CStr(key));
			removed := removed + 1;
		endif
	endforeach

	return removed;
endfunction


function OpenAreaPolicyFile(realm, create := DF_CREATE)
	var descriptor := GetRealmPolicyDescriptor(realm);
	return DFOpenDataFile(descriptor, create);
endfunction


function GetRealmPolicyDescriptor(realm)
	realm := GetAreaPolicyRealm(realm);
	return AREA_POLICY_DATAFILE_PREFIX + Lower(realm);
endfunction
