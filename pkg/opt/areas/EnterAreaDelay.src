////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Toadstool
//
// EnterAreaDelay() - Called by EnterArea(). This had to be done, due to a core bug (or just not what I wanted).
//		      See EnterArea() for the description.	
//
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
use os;
use uo;
use datafile;

include "include/areas";
include ":areas:include/areafunctions";
include ":areas:include/areapolicy";

program EnterAreaDelay(who)

// NOTE: previously set_critical(1) here + three separate ResolvePolicyAtLocation
// calls (IsInSafeArea, IsInNOPKArea, IsInGuardedArea) via areas.inc.
// That meant every region entry blocked the server for ~100k+ instructions
// with no chance to yield. We now resolve the mask ONCE and check bits.

// var file := OpenDataFile(":areas:EnterArea");
var regionname := GetRegionName(who);

// if (!file)
// 	CreateDataFile( ":areas:EnterArea");
// endif

// var region := file.FindElement(regionname);
// UnloadDataFile(":areas:EnterArea");

// // No custom message for the region, play default.
// if (!region)
// 	SendSysMessage(who, "You have entered "+regionname, 3, 1001);
// endif

// who is scheduled via Start_Script() in EnterArea.src, so by the time this
// program actually runs, who may have logged out / been destroyed. Accessing
// members on a stale who returns an error{} value (not a thrown exception);
// if that error value were passed through into ResolvePolicyAtLocation() as
// "realm", it gets CStr()'d straight into the area-policy datastore filename
// and crashes the whole server when the core tries to open that garbage path.
var who_x := who.x;
var who_y := who.y;
var who_realm := who.realm;
if(who_x == error || who_y == error || who_realm == error)
	return 0;
endif

// Resolve area policy mask ONCE and reuse the result for all bit checks.
var mask := CInt(ResolvePolicyAtLocation(who_x, who_y, who_realm));

// Safe area, no more messages atm
if (HasPolicy(mask, AREA_POLICY_SAFE_AREA))
	SendSysMessage(who, "This is a SAFE area.", 3, 1001);
	SetSafeAreaProperties(who);
	return 1;
endif

// No PK area, no more messages atm
if (HasPolicy(mask, AREA_POLICY_NO_PK))
	SendSysMessage(who, "This is a NO-PK area.", 3, 1001);
	SetNOPK(who);
endif

// Yes or no to guards
if (HasPolicy(mask, AREA_POLICY_GUARDED))
	SendSysMessage(who, "This is a guarded area.", 3, 1001);
else
	SendSysMessage(who, "This is NOT a guarded area.", 3, 1001);
endif

if (IsInForbiddenArea( who ))
	SendSysMessage(who, "This is a FORBIDDEN area.", 3, 1001);
endif

endprogram
