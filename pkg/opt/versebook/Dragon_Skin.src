use uo;
use os;

include "include/attributes";
include "include/classes";
include "include/dotempmods";
include ":versebook:include/versefunctions";
include ":versebook:include/verseconstants";

var stamina, diff, skills, element, instrument, musicianship, name;

// Timed buff: one successful play hardens the skin of the bard's party (and pets) in range.
// Physical protection becomes the higher of their own and the verse's - it never stacks
// (see spellprots.inc). WipeMods (dispel, logon) removes it early.

// Physical protection equals the bard level (1-6). Duration (2-10 minutes by bard level) is
// shared with Sanctuary and Antidote: SpellProtDuration() in spellprots.inc.

// Stamina the bard pays for each person protected
const DRAGONSKIN_STAMINA_EACH := 20;

const GFX_EFFECT := 14186;
const GFX_COLOUR :=  1300;
const SOUND_EFFECT := 0x232;

program Dragon_Skin(parms)

	// Sent with the song_id (a number like spellid)
	var who := parms[1];
	var song_id := parms[2];

	Attach(who);

	// Checks rules for playing the particular song, class, stamina skills, instrunment
	// Returns cfg info for song to save processing power
	var can_play := CanPlay(who, song_id);
	if (!can_play)
		return 0;
	else
		stamina := can_play[1];
		diff := can_play[2];
		skills := can_play[3];		 // array of skill_ids to base verse on
		element := can_play[4];		 // array of elements to base damage on
		instrument := can_play[5];	 // Item ref to music instrument found
		musicianship := can_play[6]; // The players music SKILL level
		name := can_play[7];		 // The name of the song
	endif

	// All skill checks are done in here
	if (!SucceedPlayingVerse(who, skills, diff, instrument, name))
		return 0;
	endif

	var level := SpellProtCasterLevel(IsBard(who));
	var protamt := level;
	var duration := SpellProtDuration(level);
	var range := GetVerseRange(who, musicianship);
	var protected := {};

	foreach person in (ListMobilesInLineOfSight( who, range )+who)
		// ONLY guildies, party members or pets
		if (!SmartSongBoost(who, person) || !CheckLineOfSight( who, person ))
			continue;
		endif

		// Someone already holds an equal or stronger skin; a weaker one is replaced
		if (GetSpellProtLevel(person, SPELLPROT_DRAGONSKIN) > protamt)
			continue;
		endif

		if (GetStamina(who) < DRAGONSKIN_STAMINA_EACH)
			SendSysMessage(who, "You are too exhausted to protect anyone else.");
			break;
		endif
		ConsumeBardStamina(who, stamina, DRAGONSKIN_STAMINA_EACH);

		PlayObjectCenteredEffectEx( person, GFX_EFFECT, 8, 50, GFX_COLOUR);
		PlaySoundEffect(person, SOUND_EFFECT);
		SetSpellProt(person, SPELLPROT_DRAGONSKIN, protamt);
		BuffOn(person, "dragonskin", protamt, duration);
		SendSysMessage(person, "Your skin hardens like the hide of a dragon.");
		protected.append(person);
	endforeach

	EndVerse(who);

	if (!len(protected))
		SendSysMessage(who, "There was no one for your verse to protect.");
		return 0;
	endif

	Detach();
	Sleep(duration);

	// Only end the skins this cast still owns - not dispelled, not replaced by a recast
	foreach person in protected
		if (EndSpellProt(person, SPELLPROT_DRAGONSKIN))
			BuffOff(person, "dragonskin");
			SendSysMessage(person, "Your skin softens as the dragon's hide fades.");
		endif
	endforeach

endprogram
