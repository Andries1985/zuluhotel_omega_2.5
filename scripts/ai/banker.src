use os;
use uo;
use npc;
use util;
use storage;

include "util/bank";
include "include/randname";
include "include/eventid";
include "ai/setup/modsetup";
include "include/attributes";
include "include/npcboosts";
include ":gumps:gumps";

var overflow;
var me := Self();

const BTN_CONFIRM_BANK_DEPOSIT_ALL := 1;
const BTN_CANCEL_BANK_DEPOSIT_ALL := 2;

///const REACT_THRESHOLD := 35;
const REACT_THRESHOLD := 8;
const MAX_BANK_TRANSACTION := 5000000;

if( me.name["<random>"] )
	SetName( me , RandomName( me ) );
	EquipFromTemplate( me , "Banker" );
endif

///EnableEvents( REACT_THRESHOLD );
program banker()

	EnableEvents( SYSEVENT_SPEECH, REACT_THRESHOLD );
	EnableEvents( SYSEVENT_ITEM_GIVEN );

	overflow:=0;

	//if( !me.title_suffix )
		//var names := splitwords(me.name);
		//if ( names[2] == "the" )
		//	me.name := names[1];
		//endif
	//endif
	//me.title_suffix := "the banker";

	///EnableEvents( SYSEVENT_SPEECH, 12 );

	var ev;
	while (1)

		if(!GetObjProperty(me, "lbc") || GetObjProperty(me, "lbc") < ReadGameClock())
			SetObjProperty(me, "lbc", ReadGameClock()+5);
			checkmymod(me);
		endif

		ev := os::wait_for_event( 120 );
		if( ev )

			if(ev.type ==SYSEVENT_SPEECH)
			if( ev.source.z == me.z )
				Bankfunctions( ev.source, ev.text );
			endif
			endif

			if(ev.type ==SYSEVENT_ITEM_GIVEN)
				TurnToward (ev.source);
				if (ev.item.objtype == 0x14000)
					addtobank(ev.source,ev.item);
					if(overflow == 0)
						Say( "Your gold has been placed in your bank." );
						DestroyItem(ev.item);
					endif
				else
					Say( "I only accept banker's orders." );
					MoveItemToContainer( ev.item, ev.source.backpack );
				endif
			endif

			cleareventque();

		endif

	endwhile

endprogram

function cleareventque()

var ev;
repeat
until (! (ev := os::wait_for_event(0)) );

endfunction


function BankFunctions( you, byref text )

	if( CInt( GetObjProperty( you, "#bankused" ) ) > ReadGameClock() )
		return;
	else
		SetObjProperty( you, "#bankused", ReadGameClock() + 5 );
	endif

	TurnToward(you);

	// normal event
	if ( text["bank"] )
		OpenBank( you );
	elseif ( text["withdraw"] )
		Withdraw( you );
	elseif ( text["deposit"] )
		DepositAllBackpackGold( you );
	elseif ( text["check"] || text["cheque"] )
		MakeCheque(you);
	elseif ( text["balance"] )
		Balance( you);
    elseif ( text["count"] )
        CountItems( you );
	endif

endfunction


function CreateCoins( container, coin_type, amt )

	if( !amt )
		return -1;
	endif

	var coin_array := Array;
	var fail := 0;
	var item := 0;

	if( amt > 60000 )
		while( amt > 60000 )
			item := CreateItemInContainer( container, coin_type, 60000 );
			if( item )
				amt := amt - 60000;
				coin_array.Append( item );
			else
				fail := 1;
				break;
			endif
		endwhile
	endif

	if( amt > 0 && !fail )
		item := CreateItemInContainer( container, coin_type, amt );
		if( item )
			coin_array.Append( item );
		else
			fail := 1;
		endif
	endif

	if( fail )
		foreach coin_stack in coin_array
			DestroyItem( coin_stack );
		endforeach
	endif

	return ( fail != 1 );

endfunction


function addtobank(you,previtem)

	var bankbox := FindBankBox(you);
	var amountofcheck := 0;

	overflow := 0;

	if( !bankbox )
		Say( "You don't seem to have a bank box, " + you.name );
		MoveItemToContainer( you.backpack, previtem );
		overflow := 1;
		return;
	endif

	amountofcheck := CInt( GetObjProperty(previtem, "Amount") );
	if( !amountofcheck )
		amountofcheck := CInt( GetObjProperty(previtem, "checkamount") );
	endif

	if( amountofcheck < 5000 )
		Say( "This banker's order is invalid." );
		MoveItemToContainer( you.backpack, previtem );
		overflow := 1;
		return;
	endif

	if( amountofcheck > MAX_BANK_TRANSACTION )
		Say( "This banker's order exceeds the 5000000 gold limit." );
		MoveItemToContainer( you.backpack, previtem );
		overflow := 1;
		return;
	endif

	if( !CreateCoins( bankbox, 0x0EED, amountofcheck ) )
		Say( "Sorry. Thy bankbox will overflow its limit. Your banker's order is returned." );
		MoveItemToContainer( you.backpack, previtem );
		overflow := 1;
		return;
	endif

endfunction


function CountItems ( you )

	var items   := 0;
	var weight  := 0;
	var bankbox := FindBankBox( you );
	var objects := EnumerateItemsInContainer( bankbox );

	if (bankbox)
		foreach item in objects
			items := items + 1;
			weight := weight + item.weight;
		endforeach

		Say( "Bank container has "+ items +" items, " + weight + " stones" );
	else
		Say( "You don't seem to have a bank box, " + you.name);
    endif

endfunction

function Withdraw( you )

	var amount := CInt( SendTextEntryGump(you, "How much gold would you like to withdraw? ", TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 10));
	var bankbox := FindBankBox(you);
	var myamt := 0;

	if( !bankbox )
		SendSysMessage( you, "You don't seem to have a bank box." );
		return;
	endif

	if( amount <= 0 or !amount )
		SendSysmessage( you, "The transaction has been terminated." );
		return;
	endif

	if( amount > MAX_BANK_TRANSACTION )
		SendSysMessage( you, "You can only withdraw up to 5000000 gold at a time." );
		return;
	endif

	foreach item in EnumerateItemsInContainer(bankbox)
		if( item.objtype == 0x0EED )
			myamt := myamt + item.amount;
		endif
	endforeach

	if( amount > myamt )
		Say( "Im sorry, thats more gold than thy own." );
		return;
	endif

	if( !ConsumeSubstance( bankbox, 0x0EED, amount ) )
		SendSysMessage( you, "Withdraw aborted." );
		return;
	endif

	if( !CreateCoins( you.backpack, 0x0EED, amount ) )
		CreateCoins( bankbox, 0x0EED, amount );
		SendSysMessage( you, "Withdraw aborted. Could not place gold in your main backpack." );
		return;
	endif

	Say( "Thou hast withdrawn " + amount + " gold from thy account." );

endfunction

function DepositAllBackpackGold( you )

	var bankbox := FindBankBox(you);
	var totalgold := 0;

	if( !bankbox )
		SendSysMessage( you, "You don't seem to have a bank box." );
		return;
	endif

	if( !ConfirmBankDepositAll( you ) )
		SendSysMessage( you, "The transaction has been terminated." );
		return;
	endif

	foreach item in EnumerateItemsInContainer(you.backpack)
		if( item.objtype == 0x0EED )
			totalgold := totalgold + item.amount;
		endif
	endforeach

	if( totalgold <= 0 )
		SendSysMessage( you, "You have no gold in your backpack." );
		return;
	endif

	foreach item in EnumerateItemsInContainer(you.backpack)
		if( item.objtype == 0x0EED )
			DestroyItem( item );
		endif
	endforeach

	if( !CreateCoins( bankbox, 0x0EED, totalgold ) )
		CreateCoins( you.backpack, 0x0EED, totalgold );
		SendSysMessage( you, "Your bank box is full. The gold was returned to your backpack." );
		return;
	endif

	Say( "Your gold has been deposited in your bank." );

endfunction

function ConfirmBankDepositAll( who )

	var w := 400;
	var h := 150;
	var gx := (800 - w) / 2;
	var gy := (600 - h) / 2;
	var gump := GFCreateGump(gx, gy);

	GFPage(gump, 0);
	GFResizePic(gump, 0, 0, 9270, w, h);
	GFResizePic(gump, 10, 10, 9350, w - 20, h - 20);

	var line1 := "Deposit All Gold";
	var line2 := "This will deposit all gold from";
	var line3 := "your backpack into your bank box.";

	GFTextLine(gump, (w - len(line1) * 6) / 2, 18, 1153, line1);
	GFTextLine(gump, (w - len(line2) * 6) / 2, 50, 0, line2);
	GFTextLine(gump, (w - len(line3) * 6) / 2, 70, 0, line3);

	var btn_area := 195;
	var btn_start := (w - btn_area) / 2;
	GFAddButton(gump, btn_start, h - 40, 4005, 4007, GF_CLOSE_BTN, BTN_CONFIRM_BANK_DEPOSIT_ALL);
	GFTextLine(gump, btn_start + 35, h - 40, 63, "Confirm");
	GFAddButton(gump, btn_start + 130, h - 40, 4017, 4019, GF_CLOSE_BTN, BTN_CANCEL_BANK_DEPOSIT_ALL);
	GFTextLine(gump, btn_start + 165, h - 40, 0, "Cancel");

	var result := GFSendGump(who, gump);
	return (CInt(result[0]) == BTN_CONFIRM_BANK_DEPOSIT_ALL);

endfunction

function OpenBank( you )

	var bankbox := FindBankBox( you );

	if( bankbox )               
		SendOpenSpecialContainer( you, bankbox );
	else
		Say( "You don't seem to have a bank box, " + you.name);
	endif

endfunction

function Balance( you )

	var myamt := 0;

	foreach item in EnumerateItemsInContainer(FindBankBox( you ))
		if( item.objtype == 0x0EED )
			myamt := myamt + item.amount;
		endif
	endforeach

  if( Myamt > 0 )
	   Say( "Thy current bank balance is " + Myamt + " gold." );
  else
  	 Say( "You have no gold in thy bank box." );
  endif

endfunction


function MakeCheque( you )

	var tamount := 0;
	var bankbox := FindBankBox(you);
	var myamt := 0;

	if( !bankbox )
		SendSysMessage( you, "You don't seem to have a bank box." );
		return;
	endif

	// Only true gold coins (objtype 0x0EED) are counted; sand is a different objtype.
	foreach item in EnumerateItemsInContainer(bankbox)
		if( item.objtype == 0x0EED )
			myamt := myamt + item.amount;
		endif
	endforeach

	if( myamt <= 0 )
		SendSysMessage( you, "You dont have money in your bankbox." );
		return;
	endif

	tamount := CInt( SendTextEntryGump(you, "How much gold did you want to make a cheque for? ", TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 10));

	if( tamount <= 0 or !tamount )
		SendSysmessage( you, "The transaction has been terminated." );
		return;
	endif

	if( tamount < 5000 )
		SendSysMessage( you, "Cheques cannot be made for less than 5000." );
		return;
	endif

	if( tamount > MAX_BANK_TRANSACTION )
		SendSysMessage( you, "Cheques cannot be made for more than 5000000." );
		return;
	endif

	if( tamount > myamt )
		Say( "Im sorry, thats more gold than thy own." );
		return;
	endif

	if( !ConsumeSubstance( bankbox, 0x0EED, tamount ) )
		SendSysMessage( you, "There was a problem extracting the gold from your bank box." );
		return;
	endif

	var itemcheck := CreateItemInContainer( bankbox, CInt(0x14000), 1 );
	if( !itemcheck )
		CreateCoins( bankbox, 0x0EED, tamount );
		Say( "Sorry. Thy bankbox will overflow its limit. Couldnt create cheque" );
		return;
	endif

	SetObjProperty( itemcheck, "Amount", tamount );
	SetObjProperty( itemcheck, "checkamount", tamount );
	SetObjProperty( itemcheck, "CreatedBy", you.name );
	itemcheck.color := 51;
	itemcheck.name := "A Cheque for " + tamount + " Gold by " + you.name + ".";
	itemcheck.newbie := 1;

	Say( "Your cheque has been placed in your bank." );


endfunction

