function TakeItem(ev)

	var npccfg := readconfigfile("npcdesc");
	var foodtype := npccfg[me.npctemplate].food;
	if (!foodtype)
		foodtype := "all";
	endif

	var cfg := readconfigfile("::food");
	var elem := findconfigelem(cfg,foodtype);
	var foodarray := GetConfigStringArray(elem,"food");
	if (cstr(ev.item.objtype) in foodarray )
		PlaySoundEffect(me,cint(0x3b) + Random(3));
		DestroyItem(ev.item);
		PrintTextAbovePrivate(me,"*Yum!*",ev.source);
		freetime := ReadGameClock() + 14400;
		setobjproperty(me,"freetime",freetime);
		return;
	endif

	if ( (me.graphic == 0x123 ) or (me.graphic == 0x124) )
		EnsureMyPack();
		var tookitem := 0;
		if (mypack)
			tookitem := MoveItemToContainer(ev.item, mypack);
		endif

		if (!tookitem)
			ReturnItemToSourcePackOrGround(ev.item, ev.source);
		endif

		PlaySoundEffect(me,0x49);
	else
		ReturnItemToSourcePackOrGround(ev.item, ev.source);
	endif

endfunction

function MainAILoop()

	var ev;
	var evtext;
	var mename := lower(me.name);
	var warnings := 0;

	nextwatch := ReadGameClock();
	var waittime := 120;

	if (!GoToSleep() )
		waittime := 2;
	endif

	var loops := 60;
	var firstwander := 1;
	var firstloop := 1;

	while (1)
		ev := os::wait_for_event( waittime );
		if ( ev )
			if (!ev.source.npctemplate)
				waittime := 2;
				loops := 0;
			endif
			case (ev.type)
				SYSEVENT_SPEECH:
					ProcessSpeech(ev);
				SYSEVENT_ENGAGED:
				SYSEVENT_DAMAGED:
					if (ev.source)
						if (dragonspeak) dragontalk("attacked", ev.source.name); endif
						if (ev.type == SYSEVENT_DAMAGED)
							if (guarding)
								EnqueueGuardAttacker(ev.source);
							else
								EnqueueSelfAttacker(ev.source);
							endif
						endif
					endif
				SYSEVENT_DOUBLECLICKED:
					if (ev.source.serial == masterserial)
						OpenMyPack();
					endif
				SYSEVENT_ITEM_GIVEN:
					if (ev.source.serial == masterserial)
						TakeItem(ev);
					endif
				EVID_ALL_ATTACK_CMD:
					autonomous_defense := 0;
					ClearAttackQueues();
					guarding := 0;
					fight(ev.target);
				EVID_ALL_FOLLOW_CMD:
					autonomous_defense := 0;
					ClearAttackQueues();
					guarding := 0;
					following := ev.target;
				EVID_ALL_GUARD_CMD:
					autonomous_defense := 0;
					ClearAttackQueues();
					guarding := ev.target;
					following := ev.target;
					guardinghp := GetHP(ev.target);
					PrintTextAbove(me,"*guarding " + guarding.name + "*");
			endcase
		endif

		if (guarding)
			var guardtarget := DequeueNextGuardAttacker();
			if (guardtarget)
				Fight(guardtarget);
			endif
		elseif (!staying)
			var selftarget := DequeueNextSelfAttacker();
			if (selftarget)
				Fight(selftarget);
			endif
		endif

		if (master and !autonomous_defense and !guarding and !staying and !following)
			if (firstloop and (GetObjProperty(me, "summoned") or GetObjProperty(me, "animated") or GetObjProperty(me, "charmed")))
				autonomous_defense := 1;
			else
				following := master;
			endif
		endif
		firstloop := 0;

		if ( (following) and (master) )
			waittime := 0;
			firstwander := 1;
			staying := 0;
			loops := 0;
			SetAnchor( me.x, me.y, 20, 0 );
			Follow();
		elseif ( (guarding) and (master) )
			waittime := 7;
			firstwander := 1;
			loops := 0;
			SetAnchor( me.x, me.y, 20, 0 );
			Guard();
		else
			guarding := 0;
			guardinghp := 0;
			if (!autonomous_defense)
				ClearAttackQueues();
			endif
			//ZHS STABILITY FIX
			if ( firstwander )
				SetAnchor( me.x, me.y, 2, 80 );// ZHS Stability Removed This
				waittime := 2;
			endif
			firstwander := 0;
			if ((master) and (!staying))
				wander(); // ZHS Stability Removed This
				//repeat // ZHS Stability Added This
				//until (! (ev := os::wait_for_event(0)) ); // ZHS Stability Added This
			endif
			//END FIX
			EraseObjProperty(me,"#flees");
			loops := loops + 1;
		endif

		if (loops > 60)
			if ( GoToSleep() )
				waittime := 120;
			else
				waittime := 2;
				loops := 0;
			endif
		endif

		if (ReadGameClock() > freetime )
			if ( GetObjProperty( me , "totem" ) )
				freetime := cint(ReadGameClock()+1200);
				setobjproperty(me,"freetime",freetime);
			elseif (!GetObjProperty( me , "summoned") )
				warnings := warnings + 1;
				if ( warnings > 4 )
					if(DEBUG_MODE)
						PrintTextAbove(me,"releasing for warning");
					endif
					Release();
					freetime := cint(ReadGameClock()+1200);
					setobjproperty(me,"freetime",freetime);
				else
					say("*Looks Hungry*");
					speak();
					freetime := cint(ReadGameClock()+1200);
					setobjproperty(me,"freetime",freetime);
				endif
			else
				release();
			endif
		endif

	// Poop();

	endwhile

endfunction

function Guard()

	if (guarding)
		following := guarding;
	endif

	if (guarding)
		if (!guardinghp)
			guardinghp := GetHP(guarding);
		endif
		var currenthp := GetHP(guarding);
		if (currenthp < guardinghp)
			foreach mob in ListHostiles( guarding, 9, 0 );
				EnqueueGuardAttacker(mob);
			endforeach
		endif
		guardinghp := currenthp;
	endif

	if ( nextwatch <= readgameclock() )
		nextwatch := readgameclock() + 7;
		if ( Random(20)==1 )
			PrintTextAbove(me,"*guarding " + guarding.name + "*");
		endif
	endif

	if ( (!GetBaseStrength(guarding)) or (guarding.dead) or (distance(me,guarding) > 15) )
		guarding := 0;
		guardinghp := 0;
		guardattackers := array;
	endif

endfunction

function Follow()
	//var multi4 := GetStandingHeight( master.x, master.y, master.z ).multi;

	if(following.dead || (following.cmdlevel && !master.cmdlevel) || GetObjProperty(following, "bmPlayer"))
		following := 0;
		return;
	endif

	var multi2 := GetStandingHeight( me.x, me.y, me.z, me.realm ).multi;
	var multi3 := GetStandingHeight( following.x, following.y, following.z, following.realm ).multi;
	if( multi2 and multi3)
		if( !Iscowner( master, multi3 ) and !Iscowner( master, multi2 ))
			if( !IsFriend( master, multi3) and !IsFriend( master, multi2))
				if (following.multi and !master.multi)
					following := 0;
					return;
				elseif (!following.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !master.multi)
					following := 0;
					return;
				elseif (!me.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !following.multi)
					following := 0;
					return;
				elseif (!me.multi and following.multi)
					following := 0;
					return;
				elseif(!CheckLineOfSight(me, following))
					following := 0;
					return;
				endif
			endif
		endif
	endif

	if( multi2 )
		if( !Iscowner( master, multi2 ))
			if( !IsFriend( master, multi2))
				if (following.multi and !master.multi)
					following := 0;
					return;
				elseif (!following.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !master.multi)
					following := 0;
					return;
				elseif (!me.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !following.multi)
					following := 0;
					return;
				elseif (!me.multi and following.multi)
					following := 0;
					return;
				elseif(!CheckLineOfSight(me, following))
					following := 0;
					return;
				endif
			endif
		endif
	endif
	
	if( multi3 )
		if( !Iscowner( master, multi3 ))
			if( !IsFriend( master, multi3))
				if (following.multi and !master.multi)
					following := 0;
					return;
				elseif (!following.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !master.multi)
					following := 0;
					return;
				elseif (!me.multi and master.multi)
					following := 0;
					return;
				elseif (me.multi and !following.multi)
					following := 0;
					return;
				elseif (!me.multi and following.multi)
					following := 0;
					return;
				elseif(!CheckLineOfSight(me, following))
					following := 0;
					return;
				endif
			endif
		endif
	endif

	//Antiquated I believe

	//var strongwill := 0;
	//	if ( me.npctemplate["dragon1"] || me.npctemplate["dragon2"] || me.npctemplate["nightmare"])//too strong to exploit with
	//		strongwill := 1;
	//	endif
	
	if ( (me.frozen) )
		sleep(10);
		me.frozen := 0;
		return;
	endif

	//SetDexterityMod(me, 5000); // := 5000;
	RecalcVitals(me);

	var d := Distance( me, following );
	if (d < 2)
		sleep(1);
		chaseloop := 0;
	elseif (( d > 10 ) or ( chaseloop > 50 ))
		MoveObjectToLocation( me, following.x, following.y, following.z, following.realm, MOVEOBJECT_FORCELOCATION );
		chaseloop := 0;
		sleep(1);
	else
		RunToward(following);
		chaseloop := chaseloop + 1;
	endif

	// Only follow if person is alive, not hidden, and is a mobile
	if ( following.dead || following.hidden || !following.isa(POLCLASS_MOBILE) )
		following := 0;
	endif
	
	//SetDexterityMod(me, 5000); //me.dexterity_mod := 0;
	RecalcVitals(me);

	if (guarding)
		Guard();
	endif

endfunction

function ProcessSpeech(ev)

	if( ev.source.serial != masterserial )
		return;
	endif

	if (!master)
		RestartScript( me );
	endif

	if (awaitingtargetselection)
		return;
	endif
	if (ReadGameClock() < ignorespeechuntil)
		if (DEBUG_MODE)
			PrintTextAbove(me, "*ignoring queued commands during targeting*");
		endif
		return;
	endif

	var evtext := lower(ev.text);
	var mename := lower(me.name);
	if (ShouldDebounceSpeech(evtext, mename))
		return;
	endif

	speak();

	if (evtext[mename + " kill"] or evtext[mename + " attack"] or
		evtext["all kill"] or evtext["all attack"] )
		var what := AcquireTargetWithSpeechLock(TGTOPT_HARMFUL + TGTOPT_CHECK_LOS);
		if (what)
			autonomous_defense := 0;
			ClearAttackQueues();
			if (dragonspeak) dragontalk("attack", what.name); endif
			if (evtext["all kill"] or evtext["all attack"] )
				AllCommand(EVID_ALL_ATTACK_CMD, what);
			else
				Fight( what );
			endif
		endif
	elseif( evtext[mename + " stop"] or evtext["all stop"])
		autonomous_defense := 1;
		guarding := 0;
		guardinghp := 0;
		following := 0;
		ClearAttackQueues();
	elseif ((evtext[mename + " come"]) or (evtext["all come"]))
		autonomous_defense := 0;
		var done := 0;
		chaseloop := 0;
		while( done == 0 )
			chaseloop := chaseloop +1;
			done := CloseDistance( ev.source );
			if (chaseloop > 25)
				done :=1;
			endif
		endwhile
	elseif (evtext[mename + " follow"])
		autonomous_defense := 0;
		ClearAttackQueues();
		if (evtext["follow me"])
			following := ev.source;
		else
			var what := AcquireTargetWithSpeechLock(TGTOPT_CHECK_LOS);
			if (what)
				following := what;
			endif
		endif
		if (dragonspeak) dragontalk("follow", following.name); endif
	elseif (evtext["all follow"])
		autonomous_defense := 0;
		ClearAttackQueues();
		var follow_targetname := "";
		if (evtext["follow me"])
			following	:= ev.source;
			follow_targetname := ev.source.name;
		else
			var what := AcquireTargetWithSpeechLock(TGTOPT_CHECK_LOS);
			if (what)
				follow_targetname := what.name;
				AllCommand(EVID_ALL_FOLLOW_CMD, what);
			endif
		endif
		if (dragonspeak and follow_targetname) dragontalk("follow", follow_targetname); endif
	elseif (evtext[mename + " transfer"] or (evtext["all transfer"]))
		Transfer();
	elseif (evtext[mename + " release"] or (evtext["all release"]))
		Release();
	elseif (evtext[mename + " guard"])
		autonomous_defense := 0;
		ClearAttackQueues();
		if (evtext["guard me"])
			guarding := ev.source;
			following := ev.source;
			guardinghp := GetHP(ev.source);
			PrintTextAbove(me,"*guarding " + guarding.name + "*");
		else
			var what := AcquireTargetWithSpeechLock(TGTOPT_HELPFUL + TGTOPT_CHECK_LOS);
			if (GetHP(what))
				guarding := what;
				following := what;
				guardinghp := GetHP(what);
				PrintTextAbove(me,"*guarding " + guarding.name + "*");
			endif
		endif
	elseif (evtext["all guard"])
		autonomous_defense := 0;
		ClearAttackQueues();
		if (evtext["guard me"])
			guarding := ev.source;
			following := ev.source;
			guardinghp := GetHP(ev.source);
			PrintTextAbove(me,"*guarding " + guarding.name + "*");
		else
			var what := AcquireTargetWithSpeechLock(TGTOPT_HELPFUL + TGTOPT_CHECK_LOS);
			if (GetHP(what))
				AllCommand(EVID_ALL_GUARD_CMD, what);
			endif
		endif
	elseif (evtext[mename + " fetch"]	or (evtext[mename + " get"]))
		if (dragonspeak) dragontalk("fetch", master.name); endif
		fetch();
	elseif (evtext[mename + " drop"])
		if (dragonspeak) dragontalk("drop", master.name); endif
		drop();
	elseif (evtext["all drop"])
		if (dragonspeak) dragontalk("drop", master.name); endif
		drop();
	elseif (evtext[mename + " speak"]	or (evtext["all speak"]))
		speak();
	elseif (evtext[mename + " stay"]	or (evtext["all stay"]))
		staying := 1;
	endif

endfunction

function ShouldDebounceSpeech(evtext, mename)
	var key := "";

	if (evtext["all follow"] and evtext["follow me"])
		key := "all_follow_me";
	elseif (evtext["all follow"])
		key := "all_follow";
	elseif (evtext[mename + " follow"] and evtext["follow me"])
		key := "pet_follow_me";
	elseif (evtext[mename + " follow"])
		key := "pet_follow";
	elseif (evtext["all guard"] and evtext["guard me"])
		key := "all_guard_me";
	elseif (evtext["all guard"])
		key := "all_guard";
	elseif (evtext[mename + " guard"] and evtext["guard me"])
		key := "pet_guard_me";
	elseif (evtext[mename + " guard"])
		key := "pet_guard";
	elseif (evtext["all come"])
		key := "all_come";
	elseif (evtext[mename + " come"])
		key := "pet_come";
	elseif (evtext["all stop"])
		key := "all_stop";
	elseif (evtext[mename + " stop"])
		key := "pet_stop";
	elseif (evtext["all stay"])
		key := "all_stay";
	elseif (evtext[mename + " stay"])
		key := "pet_stay";
	elseif (evtext["all drop"])
		key := "all_drop";
	elseif (evtext[mename + " drop"])
		key := "pet_drop";
	elseif (evtext[mename + " fetch"] or evtext[mename + " get"])
		key := "pet_fetch";
	endif

	if (!key)
		return 0;
	endif

	var now := ReadGameClock();
	if ((lastspeechkey == key) and (now < nextspeechallowed))
		if (DEBUG_MODE)
			PrintTextAbove(me, "*debounced: " + key + "*");
		endif
		return 1;
	endif

	lastspeechkey := key;
	nextspeechallowed := now + 2;
	return 0;
endfunction

function ClearAttackQueues()
	guardattackers := array;
	selfattackers := array;
endfunction

function QueueHasSerial(queue, serial)
	var i;
	for(i := 1; i <= queue.size(); i := i + 1)
		if (queue[i] == serial)
			return 1;
		endif
	endfor
	return 0;
endfunction

function EnqueueGuardAttacker(attacker)
	if (!attacker)
		return;
	endif
	if (attacker.serial == me.serial)
		return;
	endif
	if (attacker.serial == masterserial)
		return;
	endif
	if (!QueueHasSerial(guardattackers, attacker.serial))
		guardattackers.append(attacker.serial);
	endif
endfunction

function EnqueueSelfAttacker(attacker)
	if (!attacker)
		return;
	endif
	if (attacker.serial == me.serial)
		return;
	endif
	if (attacker.serial == masterserial)
		return;
	endif
	if (!QueueHasSerial(selfattackers, attacker.serial))
		selfattackers.append(attacker.serial);
	endif
endfunction

function DequeueNextGuardAttacker()
	while(guardattackers.size() > 0)
		var nextserial := guardattackers[1];
		guardattackers.erase(1);
		var nextobj := SystemFindObjectBySerial(nextserial);
		if (nextobj and !nextobj.dead and !nextobj.hidden and !nextobj.concealed)
			return nextobj;
		endif
	endwhile
	return 0;
endfunction

function DequeueNextSelfAttacker()
	while(selfattackers.size() > 0)
		var nextserial := selfattackers[1];
		selfattackers.erase(1);
		var nextobj := SystemFindObjectBySerial(nextserial);
		if (nextobj and !nextobj.dead and !nextobj.hidden and !nextobj.concealed)
			return nextobj;
		endif
	endwhile
	return 0;
endfunction

function AllCommand(evtype,what)
	
	PetCount();

	var mobs := ListMobilesNearLocation( master.x, master.y, master.z, 9, master.realm );
	var eve array;
	eve.+type := evtype;
	eve.+source := me;
	eve.+target := what;
	SendEvent( me , eve );
	foreach mob in mobs
		if( GetObjProperty( mob , "master" ) == me.master.serial )
			SendEvent( mob , eve );
		endif
	endforeach

endfunction

function cast_meteor()

	var targets := ListMobilesInLineofSight(me, 3);

	targets := SmartAoE(master, targets);

	foreach mobile in targets
		if (!mobile.multi.components)
			var dmg := Cint( GetHP(me) / 15 ) + RandomDiceStr("1d15");
			PlayMovingEffect(me, mobile ,MOVING_EFFECT_FIREBALL, 10,1,1);
			ApplyElementalDamageNoResist( mobile , me , dmg , FIRE );
		endif
	endforeach

endfunction

function DoPoison( you )

	if ( (distance(me,you)<2) and (Random(8)==1) )

		var poison_skill := Cint(GetEffectiveSkill(me, SKILLID_POISONING));
		if (poison_skill > 150)
			poison_skill := 150;
		endif

		var p_level := Cint(poison_skill / 25);
		if (p_level < 1)
			return;
		endif

		SetPoison(you, p_level, "You have been poisoned by " + me.name +"!");

	endif

endfunction


