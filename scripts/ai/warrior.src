// Migration shim - Patch 1.1.4.
//
// The Warrior for Hire AI moved to pkg/opt/warriorforhire/warrior.src. NPCs saved before the move
// still carry "script warrior" in data/npcs.txt and would otherwise come up with no AI at all, so
// this points them at the package script once and restarts them. New warriors never run this:
// config/npcdesc.cfg's warriorforhire template already names the package script.
use npc;
use os;
use uo;

program warrior_migrate()

	var me := Self();
	me.script := ":warriorforhire:warrior";
	RestartScript(me);

endprogram
