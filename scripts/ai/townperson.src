/////////////////////////////////////////////////////////////////////////////
//
// Simple Townperson AI. responds to a few keywords and barks out
// some crappy responses
//
// He also runs like heck if you try to attack him :)
//
// TODO: put all keyword / response text in a cfg file.
//
/////////////////////////////////////////////////////////////////////////////

use npc;
use os;
use uo;

include "include/eventid";
include "include/randname";
include "include/speech";
include "include/townsfolk";

include "ai/main/loot";
include "include/npcbackpacks";
include "ai/setup/modsetup";
include "include/attributes";


const HALT_THRESHOLD := 2; // how close before he barks?

program TownPerson()

    var me := Self();
    //drop_anchor(me);
    if (!InitTownBounds())
        return;
    endif

    DressMe(me);

    SetObjProperty( me, "serial", me.serial );
    SetObjProperty( me, "noloot", 1 );

    EnableEvents( SYSEVENT_SPEECH + SYSEVENT_ENGAGED + SYSEVENT_DISENGAGED + SYSEVENT_DAMAGED, HALT_THRESHOLD );
    EnableEvents( SYSEVENT_ENTEREDAREA + SYSEVENT_LEFTAREA, HALT_THRESHOLD );
    EnableEvents( SYSEVENT_OPPONENT_MOVED );

	if (getobjproperty(me, "frozen"))
		me.frozen := 1;
	endif

    SetWarMode( 0 );
    set_priority(10);

    // Start movement right away so newly spawned townsfolk do not stand idle.
    if (!WanderWithinTown())
        return;
    endif

    // (Old while loop removed; only the new, shared-saying-based loop remains)
    var ev;
    var next_wander := ReadGameClock() + RandomDice( 2, 50, 120 );
    while (1)
        ev := os::wait_for_event( 120 );
        case (ev.type)
            SYSEVENT_SPEECH:
               var tspeech := process_text(ev.text, "default", "default");
               if (tspeech)
                    say(tspeech);
               endif
            SYSEVENT_ENGAGED:
                SayRandomFromArray(ENGAGED_SAYINGS);
                if (!RunFromOpponent( ev.source, HALT_THRESHOLD ))
                    return;
                endif
            SYSEVENT_DAMAGED:
                SayRandomFromArray(DAMAGED_SAYINGS);
                if (ev.source)
                    if (!RunFromOpponent( ev.source, HALT_THRESHOLD ))
                        return;
                    endif
                else
                    say( "What sinister force is this!" );
                endif
            SYSEVENT_DISENGAGED:
                SayRandomFromArray(DISENGAGED_SAYINGS);
        endcase
        if (ReadGameClock() >= next_wander)
            if (!WanderWithinTown())
                return;
            endif
            next_wander := ReadGameClock() + RandomDice( 2, 50, 120 );
        endif
    endwhile
endprogram

function DressMe(me)

    if( me.name["<random>"] )
    SetName ( me , RandomName( me ) );
    endif

    var style := Random(5);

    case (style) 
        0: style := "mage";
        1: style := "warrior";
        2: style := "rich";
        3: style := "poor";
        4: style := "weakwarrior";
        default: style := "poor";
    endcase

    var parms := {};
    parms[1]:= me;
    parms[2]:= style;
    set_priority( 1 );
    start_script("::/misc/dressme", parms);
    Sleep( 2 );

endfunction
