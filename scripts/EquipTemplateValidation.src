use cfgfile;
use os;
use uo;

const CHECK_ALL_ITEMS := 1;

program ValidateEquipFile()
	Sleep(2);
	Syslog("Starting EquipTemplate validation...");
	var equip_cfg := ReadconfigFile(":*:equip");
	if( equip_cfg )
		var item_cfg := ReadconfigFile(":*:itemdesc");
		if( item_cfg )
			var equip_elem;
			foreach key in GetConfigStringKeys(equip_cfg)
				equip_elem := FindConfigElem(equip_cfg, key);
				ValidateEquipEntries(item_cfg, key, equip_elem, "Armor");
				ValidateEquipEntries(item_cfg, key, equip_elem, "Weapon");
				ValidateEquipEntries(item_cfg, key, equip_elem, "Equip");
			endforeach

			Syslog("Finished EquipTemplate validation.");
		endif
	else
		Syslog("Error, couldn't read equip.cfg");
	endif
endprogram

// Validates every entry of one property (Armor/Weapon/Equip) on a single
// EquipTemplate element against item_cfg, logging any that don't resolve to
// a known item. "Equip" entries carry a trailing color token that the other
// two don't, so it's stripped to just the item token before resolving.
function ValidateEquipEntries(item_cfg, key, equip_elem, prop_name)
	var item_elem;
	var objtype;
	foreach entry in GetConfigStringArray(equip_elem, prop_name)
		var item_token := entry;
		if( prop_name == "Equip" )
			item_token := SplitWords(entry)[1];
		endif

		objtype := CInt(item_token);
		if( !objtype )
			objtype := GetObjtypeByName(item_token);
			if( !objtype )
				Syslog("Invalid item in EquipTemplate '" + key + "' with " + prop_name + " '" + item_token + "'.");
			endif
		endif

		if( objtype )
			if( CHECK_ALL_ITEMS || objtype > 0x3FFF )
				item_elem := FindConfigElem(item_cfg, objtype);
				if( !item_elem )
					Syslog("Invalid item in EquipTemplate '" + key + "' with " + prop_name + " '" + Hex(item_token) + "'.");
				endif
			endif
		endif
	endforeach
endfunction