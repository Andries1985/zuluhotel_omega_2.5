use uo;

include "include/client";
include "include/objtype";
include "include/utility";
include "include/skillpoints";
include "include/omegacache_utils";
include "include/resourcemanager";


program on_fletch( character, shafts )
    var feathers;
    var thepoints := get_default_points(SKILLID_BOWCRAFT);

    // Handle cache-sourced shafts
    var shaftRequest;
    if(shafts.objtype == OMEGACACHE_OBJTYPE)
        shaftRequest := SelectMaterialFromCache(character);
        if(!shaftRequest)
            return;
        endif
    else
        shaftRequest := MakeBackpackRequest(character, shafts);
    endif

    SendSysMessage( character, "Select feathers to use." );

    feathers := Target( character );
    if (!feathers) // canceled, or targetting error
        return;
    endif

    // Handle cache-sourced feathers
    var featherRequest;
    if(feathers.objtype == OMEGACACHE_OBJTYPE)
        featherRequest := SelectMaterialFromCache(character);
        if(!featherRequest)
            return;
        endif
        if(CInt(featherRequest.objtype) != UOBJ_FEATHER)
            SendSysMessage(character, "I can only make arrows from shafts and feathers.");
            return;
        endif
    else
        if (GetObjType(feathers) != UOBJ_FEATHER)
            SendSysMessage( character, "I can only make arrows from shafts and feathers." );
            return;
        endif
        featherRequest := MakeBackpackRequest(character, feathers);
    endif

    var choice := SelectMenuItem2( character , "Fletching" );
    SendSysMessage(character, "[Fletch] choice=" + choice + " objtype=" + choice.objtype, 3, 53);

    var shaft_avail := GetAvailableResource(character, shaftRequest).total;
    var feather_avail := GetAvailableResource(character, featherRequest).total;
    SendSysMessage(character, "[Fletch] shafts=" + shaft_avail + " feathers=" + feather_avail, 3, 53);

    if(shaft_avail > 0 and feather_avail > 0)
        if (CheckSkill( character,
                        SKILLID_BOWCRAFT,
                        1,                     // difficulty
                        thepoints ))                   // points
            var num_to_make := Min( shaft_avail, feather_avail );
            SendSysMessage(character, "[Fletch] num_to_make=" + num_to_make + " choice.objtype=" + choice.objtype, 3, 53);

            if(choice.objtype)
                var arrows := CreateItemInBackpack( character, choice.objtype, num_to_make );
                SendSysMessage(character, "[Fletch] arrows=" + arrows + " amount=" + arrows.amount, 3, 53);
                if (arrows.amount > 0)
                    ConsumeResource( character, shaftRequest, num_to_make );
                    ConsumeResource( character, featherRequest, num_to_make );
                    SendSysMessage( character, "You create some arrows and put them in your pack." );
                endif
            endif
        else
            ConsumeResource( character, shaftRequest, 1 );
            ConsumeResource( character, featherRequest, 1 );
            SendSysMessage( character, "You destroy some materials." );
        endif
    else
        SendSysMessage( character, "I can't seem to find either the shafts or the feathers!" );
    endif
endprogram
