// Synopsis: Teleport to a named map location via location list gump
// command .go  started June 19, 2000
// Zulu (zulu@zuluhotel.com)
// Rewritten to use gumps package

use os;
use uo;
use cfgfile;

include ":staff:include/staff";
include ":gumps:gumps";
include "include/math"; // Used for Mod

// Gump layout constants
const HEADER_Y      := 50;  // Y of column headers
const TEXTSTARTLOCY := 72;  // Y of first location row
const ROW_HEIGHT    := 18;  // Pixels per row
const COL1_X        := 72;  // Left column: location name X
const COL2_X        := 312; // Right column: location name X
const BTN_GO_OFS    := 160; // Go button X offset from column
const BTN_SND_OFS   := 200; // Send button X offset from column
const BTN_Y_OFS     := 5;   // Lower arrow buttons to match text baseline

program textcmd_go( who, text )

  // Test to see if the user sent a location via command text.
  // If not, show gump; else attempt travel to that location.
  if (!text)

    var locs    := readconfigfile("::golocs");
    var MaxLocs := GetConfigMaxIntKey(locs);

    var gump := BuildGoGump(locs, MaxLocs);
    var result := GFSendGump(who, gump);

    // If the user cancelled, quit
    if (result[0] == 0)
      return;
    endif

    var btn      := result[0];
    var Dest;
    var Traveler;

    if (btn > MaxLocs) // Send button -- teleport someone else
      var idx := btn - MaxLocs;
      Dest := locs[idx];
      SendSysmessage(who, "Select a MOBILE.");
      Traveler := Target(who, TGTOPT_NOCHECK_LOS);
      if (!Traveler)
        SendSysmessage(who, "Invalid selection.");
        return;
      endif
    else // Go button -- teleport self
      Dest     := locs[btn];
      Traveler := who;
    endif

    LogCommand(who, GetProcess(GetPid()).name, traveler.name+"/"+traveler.serial, "Sent TO "+dest.x+" "+dest.y+" "+GetMapInfo(Dest.X, Dest.Y).Z);

    var move := MoveObjectToLocation(Traveler, Dest.X, Dest.Y, Dest.Z, Dest.R, MOVEOBJECT_FORCELOCATION);
    if (!move)
      SendSysMessage(who, "Unable to go there: " + move.errortext);
    endif

  else

    var params := SplitWords(text);
    if (len(params) < 3) // didn't pass Z
      params[3] := GetMapInfo(CInt(params[1]), CInt(params[2]), CInt(params[3]));
    endif

    var res := MoveObjectToLocation(who, CInt(params[1]), CInt(params[2]), CInt(params[3]), params[4], MOVEOBJECT_FORCELOCATION);
    if (!res)
      SendSysMessage(who, "Unable to go there: " + res.errortext);
    endif

  endif

endprogram

// Builds and returns the go gump using the gumps package API.
// Go buttons   return values 1..MaxLocs
// Send buttons return values MaxLocs+1..MaxLocs*2
function BuildGoGump(byref locs, MaxLocs)

  // Gump height: header area + rows + bottom padding
  var rows_per_col := MaxLocs > 20 ? 20 : MaxLocs;
  var gump_height  := TEXTSTARTLOCY + (rows_per_col * ROW_HEIGHT) + 36;

  var gump := GFCreateGump(50, 50, 540, gump_height);
  GFResizePic(gump, 20, 20, 3500, 540, gump_height);
  GFMovable(gump, 0);
  GFDisposable(gump, 0);

  // Column 1 header
  GFTextLine(gump, COL1_X, HEADER_Y, 300, "Location");
  GFTextLine(gump, COL1_X + BTN_GO_OFS  + 5, HEADER_Y, 300, "Goto");
  GFTextLine(gump, COL1_X + BTN_SND_OFS + 5, HEADER_Y, 300, "Send");

  // Column 2 header
  GFTextLine(gump, COL2_X, HEADER_Y, 300, "Location");
  GFTextLine(gump, COL2_X + BTN_GO_OFS  + 5, HEADER_Y, 300, "Goto");
  GFTextLine(gump, COL2_X + BTN_SND_OFS + 5, HEADER_Y, 300, "Send");

  var col_x := COL1_X;
  var row_y := TEXTSTARTLOCY;
  var i := 0;

  for (i := 1; i <= MaxLocs; i := i + 1)
    var loc := locs[i];

    // Switch to right column after 20 entries
    if (i == 21)
      col_x := COL2_X;
      row_y := TEXTSTARTLOCY;
    endif

    GFTextLine(gump, col_x, row_y + 3, 995, loc.Name);
    GFAddButton(gump, col_x + BTN_GO_OFS,  row_y + BTN_Y_OFS, 2103, 2104, GF_CLOSE_BTN, i);           // Go
    GFAddButton(gump, col_x + BTN_SND_OFS, row_y + BTN_Y_OFS, 2103, 2104, GF_CLOSE_BTN, MaxLocs + i); // Send

    row_y := row_y + ROW_HEIGHT;
  endfor

  return gump;
endfunction
