// Synopsis: Toggle whether other players can see your class
use uo;
use polsys;

include "include/client";

program toggle_hide_classe( who )

	var hidden := GetObjProperty( who, "HideClasse" );

	if( hidden )
		EraseObjProperty( who, "HideClasse" );
		SendSysMessage( who, "Your class is now visible to other players.");
	else
		SetObjProperty( who, "HideClasse", 1 );
		SendSysMessage( who, "Your class is now hidden from other players.");
	endif

	IncRevision( who );

endprogram
