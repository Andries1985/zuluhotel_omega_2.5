// Synopsis: Show your kills toward a Champion Reward Bag at the nearest active champion altar
use uo;
use os;

include ":champspawns:rewards";

const CHAMP_ALTAR_OBJTYPE := 0x9101;	// champaltarnocreate, the altar that runs the spawn
const CHAMP_ALTAR_SEARCH_RANGE := 50;	// minions spawn up to 37 tiles from the altar on each axis

program textcmd_champkills(who)

	var altar := FindNearestActiveAltar(who);
	if(!altar)
		SendSysMessage(who, "There is no active champion altar near you.");
		return;
	endif

	// The tally is players[serial] := {minute, kills} buckets (death.inc); only the minutes inside
	// the altar's credit window count (rewards.inc).
	var players := GetObjProperty(altar, "players");
	if(TypeOf(players) != "Dictionary")
		players := dictionary;
	endif
	var now_minute := CInt(POLCore().systime / 60);
	var window := ChampionCreditWindow(altar);
	var start := ChampionCreditStart(altar);
	var buckets := ChampionTallyBuckets(players[who.serial], now_minute);
	var kills := ChampionKillsSince(buckets, start);

	if(!kills)
		SendSysMessage(who, "You haven't slain any of this champion's minions in the last " + FormatDuration(window * 60) + ". It takes " + CHAMP_BAG_MIN_KILLS + " to earn a Champion Reward Bag.", FONT_NORMAL, CHAMP_REWARD_COLOR);
		return;
	endif

	var next := 0;
	foreach tier in ChampionBagTiers()
		if(kills < tier)
			next := tier;
			break;
		endif
	endforeach

	var msg := "You have slain " + kills + " of this champion's minions in the last " + FormatDuration(window * 60) + ".";
	if(kills < CHAMP_BAG_MIN_KILLS)
		msg := msg + " " + (CHAMP_BAG_MIN_KILLS - kills) + " more to earn a Champion Reward Bag.";
	elseif(next)
		msg := msg + " You have earned a Champion Reward Bag, and " + (next - kills) + " more makes it bigger (" + next + ").";
	else
		msg := msg + " Your Champion Reward Bag is as full as it gets.";
	endif
	SendSysMessage(who, msg, FONT_NORMAL, CHAMP_REWARD_COLOR);

	if(GetObjProperty(altar, "ChampionAt"))
		SendSysMessage(who, "The champion has appeared: your count is locked in, and minions you slay now still add to it.", FONT_NORMAL, CHAMP_REWARD_COLOR);
		return;
	endif

	// A minute's kills count until window minutes after it.
	foreach bucket in buckets
		if(CInt(bucket[1]) >= start)
			SendSysMessage(who, "Your oldest " + CInt(bucket[2]) + " kills here drop off in " + FormatDuration((CInt(bucket[1]) + window - now_minute) * 60) + ".", FONT_NORMAL, CHAMP_REWARD_COLOR);
			break;
		endif
	endforeach

	if(CInt(GetObjProperty(altar, "wave")) <= 1)
		SendSysMessage(who, "This altar is down to its last red skull or less. If ten minutes pass with little killing here, it goes quiet and every kill on it is lost.", FONT_NORMAL, 33);
	endif

endprogram

// The nearest altar within CHAMP_ALTAR_SEARCH_RANGE whose spawn is running (the champion fight
// included), or 0.
function FindNearestActiveAltar(who)

	var nearest := 0;
	foreach item in ListItemsNearLocationOfType(who.x, who.y, LIST_IGNORE_Z, CHAMP_ALTAR_SEARCH_RANGE, CHAMP_ALTAR_OBJTYPE, who.realm)
		if(CInt(GetObjProperty(item, "active")))
			if(!nearest or Distance(who, item) < Distance(who, nearest))
				nearest := item;
			endif
		endif
	endforeach
	return nearest;

endfunction

function FormatDuration(seconds)

	var minutes := CInt(seconds / 60);
	if(minutes < 1)
		return "less than a minute";
	elseif(minutes < 60)
		if(minutes == 1)
			return "1 minute";
		endif
		return minutes + " minutes";
	endif
	var hours := CInt(minutes / 60);
	minutes := minutes - hours * 60;
	var text := hours + " hour";
	if(hours != 1)
		text := text + "s";
	endif
	if(minutes)
		text := text + " " + minutes + " minute";
		if(minutes != 1)
			text := text + "s";
		endif
	endif
	return text;

endfunction
