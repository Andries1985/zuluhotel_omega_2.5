use uo;
use os;
use cfgfile;

include "include/spelldata";
include "include/dotempmods";
include "include/classes";
include "include/client";
include "include/random";

const DELAY_BETWEEN_HITS_MS	:= 1000;

program poison_control( item )

	var diff    := 40;
	var points  := 25;
	var controller := 0;

	while( item )
		// Read the location once (see firecontrol.src): the field can be destroyed mid-tick.
		var realm := item.realm;
		var fx := CInt(item.x), fy := CInt(item.y), fz := CInt(item.z);
		if( !realm )
			break;
		endif

		// Creator and ByTrueMage are set after CreateItemAtLocation() has already started this
		// script, so they are read every tick, as in firecontrol.src: read once at startup, a field
		// whose script ran first lost its caster, and the kill credit, for its whole life.
		var power := 2;
		if( GetObjProperty( item , "ByTrueMage" ) )
			power := Cint( power * CLASSE_BONUS );
		endif
		var creator := 0;
		var serial  := Cint( GetObjProperty( item , "Creator" ) );
		if( serial )
			creator := SystemFindObjectBySerial( serial , SYSFIND_SEARCH_OFFLINE_MOBILES );
			if( creator and !controller )
				SetScriptController(creator);
				controller := creator;
			endif
		endif
		// The field's caster gets the kill. Kept apart from creator, which falls back to the first
		// victim below when the caster can't be found.
		var poisoner := creator;

		var plvl := RandomDiceStr( "1d" + power );
		PlaySoundEffect( item , SFX_SPELL_POISON_FIELD );
		var victims := ListMobilesNearLocation( fx , fy , fz , 0, realm );
		victims := SmartAoE(creator, victims);
		foreach mobile in victims
			if( !creator )
				creator := mobile;
			endif
			
			var indiv_plvl := Cint(ResistedDefinedSkillGain( creator , mobile , plvl , diff , points ));
			if( indiv_plvl )
				if(!mobile.multi)
					PlayObjectCenteredEffectEx( mobile, 0x33F6, 0 , 10, 63, 5);
					SetPoison( mobile , indiv_plvl , "You've been poisoned!", 0, 0, poisoner );
				endif
			endif
		endforeach
		Sleepms( DELAY_BETWEEN_HITS_MS );
	endwhile
  
endprogram